{
  "name": "datasportsapi",
  "version": "0.2.0",
  "description": "Official TypeScript/JavaScript client for the DataSportsAPI sports data API: a typed method per endpoint, retries, paging and the live WebSocket stream.",
  "keywords": [
    "sports",
    "sports-api",
    "sports-data",
    "live-scores",
    "football",
    "websocket",
    "api-client",
    "typescript",
    "datasportsapi"
  ],
  "homepage": "https://datasportsapi.com/sdks/typescript/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datasportsapi/datasportsapi-js.git"
  },
  "bugs": {
    "url": "https://github.com/datasportsapi/datasportsapi-js/issues"
  },
  "license": "MIT",
  "author": "DataSportsAPI (https://datasportsapi.com)",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "operations.cjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node test.mjs"
  }
}
