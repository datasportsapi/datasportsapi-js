  /** Tennis: score within the current game — "0" | "15" | "30" | "40" | "A", or a plain number ("0"–"N") during a tie-break. Darts: the points the side still has to score in the current leg ("501" when a leg starts). Null when play is neither in progress nor interrupted. */
  point: string | null;
  /** Football: number of red cards this side has received, counting second yellows. Once the match is under way it starts at 0 rather than null, on REST and, since 2026-11-26, in WebSocket deltas as well. */
  redCards: number | null;
  /** Cricket: each innings of this side, keyed inning1…N. Empty in other sports. */
  innings: Record<string, CricketInnings>;
  /** Baseball: hit total, i.e. the H in the R/H/E line. */
  hits: number | null;
  /** Baseball: error total, i.e. the E in the R/H/E line. */
  errors: number | null;
}

/** A single cricket innings played by one side. */

export interface CricketInnings {
  /** Total runs made. */
  runs: number | null;
  /** Number of wickets that have fallen. */
  wickets: number | null;
  /** Overs delivered, in cricket notation (49.5 means 49 overs plus 5 balls). */
  overs: number | null;
  /** Average runs scored per over. */
  runRate: number | null;
  /** Run rate the chasing side needs to reach its target. */
  targetRunRate: number | null;
}

/** Timing data for a match. Running clocks (football, rugby, …): compute elapsed = periodOffsetSeconds + (now − periodStartedAt) and minute = floor(elapsed / 60) + 1; once periodEndSeconds is passed, display periodEndSeconds / 60 followed by "+" and the extra minutes. This applies only while status.phase is inprogress. Stop clocks (basketball, handball, ice hockey, …): playedSeconds is the value at playedAt and advances only while `running` is true. Tennis, table tennis, badminton and esports (set / map sports) carry only `periodStartedAt` (start of the current set or map), and only if the source sends it — the clock as a whole is frequently null. A field is null whenever the source does not provide it for that sport; the entire clock is null when no clock exists and after the match ends. Lists other than /fixtures/{id} may include fewer clock fields (static values such as periodLengthSeconds can be null there). */

export interface Clock {
  /** Moment the clock for the current period was started. */
  periodStartedAt: string | null;
  /** Running clock: seconds already on the clock at the start of the period (2700 for the second half in football). Null at a break, when no period is being played. Unit: seconds. */
  periodOffsetSeconds: number | null;
  /** Running clock: clock reading, in seconds, at which regulation time for the period runs out (2700 for the first half in football). Null at a break. Unit: seconds. */
  periodEndSeconds: number | null;
  /** Running clock: upper bound on the added time the source’s display permits after periodEndSeconds. Null at a break. Unit: seconds. */
  maxExtraSeconds: number | null;
  /** Stoppage time announced for the current period; null at a break. Fixture.addedTime keeps the announced minutes of every period. Unit: minutes. */
  injuryTimeMinutes: number | null;
  /** Stop clock: time played in seconds, valid at `playedAt`. When the source's clock jumps forward by up to a minute (handball often runs 15–30 s ahead after a quiet spell), the new reading is used at once since 2026-11-26. A bigger jump, or a reading more than a minute behind (a source that falls back to the previous period at a break), only counts once the next reading agrees, so the clock does not leap about. Unit: seconds. */
  playedSeconds: number | null;
  /** Timestamp at which `playedSeconds` was captured. */
  playedAt: string | null;
  /** Stop clock: true while the game clock is ticking. */
  running: boolean | null;
  /** Time of the most recent change to `running`. */
  runningUpdatedAt: string | null;
  /** Stop clock: duration of a single regulation period. Unit: seconds. */
  periodLengthSeconds: number | null;
  /** Duration of a single overtime period. Unit: seconds. */
  overtimeLengthSeconds: number | null;
  /** How many regulation periods the match has (in combat sports, the scheduled rounds). */
  periodCount: number | null;
  /** End time of the latest completed period. During a break (half-time, between periods) this marks when the break started, so the break has lasted now − lastPeriodEndedAt. Used with football-style running clocks; null if the source sends nothing (before the first break, in other sports, or for data stored before 2026-11-04). Available since 2026-11-04. */
  lastPeriodEndedAt: string | null;
}

/** MMA / boxing: the way a completed fight was settled. */

export interface FightResult {
  /** The winning method. */
  method: FightMethod;
  /** Round in which the fight finished. */
  round: number | null;
  /** Elapsed time in that round when the fight was halted (KO, TKO, submission, disqualification, …), if the source records it. Null for every decision (unanimous, split, majority, technical, drawn ones too): nothing stopped the fight, and the source’s figure cannot be trusted there. Unit: seconds. */
  roundTimeSeconds: number | null;
}

/** The match official (for cricket, the match referee) and the career totals the source records for them. For a per-match rate, divide a total by `games`. */

export interface Referee {
  /** The referee’s DataSportsAPI id. */
  id: number;
