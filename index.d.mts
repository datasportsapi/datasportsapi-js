  /** league id — returns only that league’s fixtures for the date, on a single page (page has to be 0) */
  league?: number;
  /** category id, as listed by /v2/categories or /v2/fixtures/counts — all leagues of that country, region or tour for the date, sorted by start time, on a single page (page has to be 0). Available since 2026-11-04 */
  category?: number;
  /** two-letter Country.code (EN, ES, US …; case-insensitive), used together with sport — returns the date’s fixtures from that country’s categories in the sport, on a single page. Available since 2026-11-04 */
  country?: string;
  /** only when sport is the sole filter: page index 0–99 (defaults to 0), each page covering 10 leagues. A league with no fixture that day can leave a page short or even empty; cursor does not */
  page?: number;
  /** the meta.nextCursor of the previous page, used instead of page with sport alone or with no filter at all. A cursor works for one hour and only with the sport and date it came from. Available since 2026-11-23 */
  cursor?: string;
  /** reads date as a day in your own time: give an IANA zone name (Europe/London, America/New_York), which tracks summer time, so the day the clocks change is 23 or 25 hours long, or a plain offset from -12:00 to +14:00 (+03:00, -05:00, +3, +0530; send + encoded as %2B, since a bare + arrives as a space). You get the fixtures that begin inside that local day, with start times kept in UTC, and meta reports tz plus utcFrom and utcTo, where the day begins and ends in UTC. Leave tz out and the day is a UTC one. Available since 2026-11-24 */
  tz?: string;
}

/** date, page, count, hasNextPage; the league filter adds league (and sport when passed), with page fixed at 0 and hasNextPage false; the category filter adds category (and sport when passed), single page; the country filter adds sport, country, categoryIds (the categories that were queried), complete; sport on its own, or no filter at all, adds sport (null for every sport), leagueCount (the leagues this page’s fixtures belong to), nextCursor (pass it as cursor for the following page; null once there is none) and complete (false if some league lists were temporarily unavailable — try again shortly); tz adds tz, utcFrom and utcTo */
