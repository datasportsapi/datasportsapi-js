/** A client of the agency whose transfer value has moved recently (`valueChanges` on AgencyDetail). Available since 2026-11-25. */

export interface AgencyValueChange {
  /** The player. */
  player: PlayerRef;
  /** His position in Player.position terms (G / D / M / F at the source); null when none is given. Available since 2026-11-25. */
