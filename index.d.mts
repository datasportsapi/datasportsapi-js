  /** Player photo hosted on our CDN. */
  image: string | null;
  /** Ongoing injury, if the source records one (football, mainly in covered leagues); null means no injury is listed. */
  injury: Injury | null;
  /** Football: fine-grained positions the player occupies, primary first (e.g. ["striker"], ["rightWinger", "attackingMidfielder"]). Empty if the source lists none, as in other sports and minor leagues; `position` keeps the broad line either way. */
  detailedPositions: DetailedPosition[];
  /** Football: the bans the player is serving this season, one entry per competition. An empty list means none, or that our data source does not list them. Available since 2026-11-20. */
  suspensions: Suspension[];
  /** Basketball only: the specific spot the player is listed at — pointGuard, shootingGuard, smallForward, powerForward or center (PG / SG / SF / PF / C at the source); `position` stays the broader guard, forward or center group. Null in other sports, when the source gives no code, and for a player stored earlier until his next refresh. Available since 2026-11-25. */
  primaryPosition: PrimaryPosition | null;
  /** Team the player currently belongs to. */
  team: TeamRef | null;
  /** Cricket and baseball: the side the player bats from; switch marks a baseball switch hitter, who bats from both. Null in other sports and when unknown. Available since 2026-11-23. */
  battingHand: "left" | "right" | "switch" | null;
  /** Baseball: left- or right-handed thrower; null in other sports and when unknown. Available since 2026-11-23. */
  throwingHand: "left" | "right" | null;
  /** Cricket: how the player bowls, in the source’s words ("Right-arm fast"); null in other sports and for players who do not bowl. Available since 2026-11-23. */
  bowlingStyle: string | null;
  /** Body weight where the source records it (baseball, American football and a few more). Unit: kg. Available since 2026-11-23. */
  weightKg: number | null;
  /** Birthplace in the source’s words ("Maracaibo, Venezuela"); null if not known. Available since 2026-11-23. */
  birthPlace: string | null;
  /** Yearly salary, where the source carries one (mostly MLB players); null otherwise. Available since 2026-11-23. */
  salary: Money | null;
  /** true when the source records the player as deceased; null when it says nothing. Available since 2026-11-24. */
  deceased: boolean | null;
}

/** An injury a player is currently carrying. */

export interface Injury {
  /** Name of the injury, such as "Hamstring Injury". */
  description: string | null;
  /** Availability status: out, day to day, … */
  status: InjuryStatus | null;
  /** Date the injury began (UTC day). */
  since: string | null;
  /** Projected return date (UTC day), if the source offers an estimate. */
  expectedReturn: string | null;
  /** Time of the source’s latest update to this injury. */
  updatedAt: string | null;
}

/** A member of a squad. Identical to Player minus `team`, which is implied by the squad. */

export interface SquadPlayer {
  /** The player’s DataSportsAPI id. */
  id: number;
  /** The player’s full name. */
  name: string;
  /** Slug for use in URLs. */
  slug: string | null;
  /** Abbreviated name such as "B. Saka". */
  shortName: string | null;
  /** Given name from the source's records; handy where `name` is a handle rather than a real name, as in esports. Null when unknown. Available since 2026-11-25. */
  firstName: string | null;
  /** Family name from the source's records; null when unknown. Available since 2026-11-25. */
  lastName: string | null;
  /** Gender as the source has it on file; null when unknown. Available since 2026-11-25. */
  gender: "male" | "female" | null;
  /** The player's standing on the team roster, in leagues where the source tracks one: the NBA (active, two-way contract) and the NHL (active, injured reserve). Null in other leagues. Available since 2026-11-25. */
  rosterStatus: RosterStatus | null;
  /** Primary playing position. */
  position: Position | null;
  /** Position code as used by the source. */
  positionCode: string | null;
  /** Shirt number as a string, since basketball and American football treat "0" and "00" as distinct numbers. Null if unknown; rugby squads’ "0" placeholder is dropped. */
  jerseyNumber: string | null;
  /** Body height. Unit: cm. */
  heightCm: number | null;
  /** Football: the player’s stronger foot — left, right or both. */
  preferredFoot: "left" | "right" | "both" | null;
  /** Birth date. */
  dateOfBirth: string | null;
  /** The player’s nationality. */
  country: Country | null;
  /** Estimated value on the transfer market; null if unknown. */
  marketValue: Money | null;
  /** Date the current contract expires; null if unknown. */
  contractUntil: string | null;
  /** Player photo hosted on our CDN. */
  image: string | null;
  /** Ongoing injury, if the source records one (football, mainly in covered leagues); null means no injury is listed. */
  injury: Injury | null;
  /** Football: fine-grained positions the player occupies, primary first (e.g. ["striker"], ["rightWinger", "attackingMidfielder"]). Empty if the source lists none, as in other sports and minor leagues; `position` keeps the broad line either way. */
  detailedPositions: DetailedPosition[];
  /** Football: the bans the player is serving this season, one entry per competition. An empty list means none, or that our data source does not list them. Available since 2026-11-20. */
  suspensions: Suspension[];
  /** Basketball only: the specific spot the player is listed at — pointGuard, shootingGuard, smallForward, powerForward or center (PG / SG / SF / PF / C at the source); `position` stays the broader guard, forward or center group. Null in other sports, when the source gives no code, and for a player stored earlier until his next refresh. Available since 2026-11-25. */
  primaryPosition: PrimaryPosition | null;
  /** Cricket and baseball: the side the player bats from; switch marks a baseball switch hitter, who bats from both. Null in other sports and when unknown. Available since 2026-11-23. */
  battingHand: "left" | "right" | "switch" | null;
  /** Baseball: left- or right-handed thrower; null in other sports and when unknown. Available since 2026-11-23. */
  throwingHand: "left" | "right" | null;
  /** Cricket: how the player bowls, in the source’s words ("Right-arm fast"); null in other sports and for players who do not bowl. Available since 2026-11-23. */
  bowlingStyle: string | null;
  /** Body weight where the source records it (baseball, American football and a few more). Unit: kg. Available since 2026-11-23. */
  weightKg: number | null;
  /** Birthplace in the source’s words ("Maracaibo, Venezuela"); null if not known. Available since 2026-11-23. */
  birthPlace: string | null;
  /** Yearly salary, where the source carries one (mostly MLB players); null otherwise. Available since 2026-11-23. */
  salary: Money | null;
  /** true when the source records the player as deceased; null when it says nothing. Available since 2026-11-24. */
  deceased: boolean | null;
  /** For a player who joined recently, his previous team, if the source records the move (mostly on NFL rosters); null in all other cases. Available since 2026-11-23. */
  previousTeam: TeamRef | null;
  /** Date of the player’s arrival at this team (a signing, a trade, a call-up), where the source records it; null otherwise. Available since 2026-11-23. */
  joinedOn: string | null;
  /** The player’s own team when it differs from the squad you asked for: on a national squad, the club or domestic side he plays for (for cricket, a state or county side). It stays null when you read a club’s squad, when no team is given, and on squads stored before 2026-11-27 until their next refresh. Since 2026-11-27. */
  club: TeamRef | null;
}

/** A single slot on a team’s depth chart and the player who fills it. Someone who holds two slots shows up twice — a top-line centre frequently skates on a power-play unit as well. Available since 2026-11-23. */

export interface DepthChartEntry {
  /** The slot: a wing or centre of a forward line, one side of a defence pair, a goaltender, or a power-play unit. */
  position: DepthChartPosition;
  /** Which line, pair or goalie rank the slot belongs to, counting from 1 for the first; for a power-play unit, the player’s place within that unit (1–5). */
  depth: number;
  /** The player in the slot. */
  player: PlayerRef;
}

/** A single player movement between teams, such as a transfer, loan, signing, trade or release. It has no id; the combination of player, type and date identifies it. */

export interface Transfer {
  /** Player involved in the move. */
  player: PlayerRef;
  /** Category of the move. */
  type: TransferType;
  /** Date the move became effective (UTC day); null if the source gives no date. */
  date: string | null;
  /** Club the player departed; null for a free agent or for a side the source has no team record for (see `fromName`). */
  from: TeamRef | null;
  /** The club the player left, named as the source writes it (e.g. "Bryne FK Yth."); set even when `from` is null. */
  fromName: string | null;
  /** Club the player moved to; null after a waiver, release or retirement, or for a side the source has no team record for (`toName` then reads "No team" for releases and free agents). */
  to: TeamRef | null;
  /** Name of the destination club as written by the source; works like `fromName`. */
  toName: string | null;
  /** Transfer fee, if the source states it. Null for free, undisclosed or unknown fees and for any move that is not a transfer. */
  fee: Money | null;
  /** True if the source marks the move as free, meaning no fee changed hands. */
  freeTransfer: boolean;
  /** For type draft: the round and pick number, if listed. Null otherwise. */
  draft: {
    round: number | null;
    pick: number | null;
  } | null;
}

/** Recent incoming and outgoing moves for a team as listed by the source, covering roughly the past year. */

export interface TeamTransfers {
  /** Incoming moves, most recent first. */
  arrivals: Transfer[];
  /** Outgoing moves, most recent first. */
  departures: Transfer[];
}

/** One page of the most recent football transfers (GET /v2/transfers). Available since 2026-11-09. */

export interface TransferFeed {
  /** Moves on this page (no more than 50), sorted as requested. */
  transfers: Transfer[];
  /** True if another page might contain further moves. */
  hasNextPage: boolean;
}

/** A monetary value. */

export interface Money {
  /** The value, expressed in units of `currency`. */
  amount: number;
  /** Currency as an ISO 4217 code, such as "EUR". */
  currency: string;
}

/** How much a sum of money went up or down. Available since 2026-11-25. */

export interface MoneyChange {
  /** The difference in `currency` units, above zero for an increase and below zero for a decrease. */
  amount: number;
  /** Currency as an ISO 4217 code, such as "EUR". */
  currency: string;
}

/** Team sheets for both sides. */

export interface Lineups {
  /** True when the official lineups have been released; false means they are predicted or not yet published. */
  confirmed: boolean;
  /** Lineup of the home side. */
  home: TeamLineup;
  /** Lineup of the away side. */
  away: TeamLineup;
}

/** The lineup of a single side. */

export interface TeamLineup {
  /** Tactical formation, such as "4-2-3-1" (football). */
  formation: string | null;
  players: LineupPlayer[];
  missing: MissingPlayer[];
  /** Coaches and other staff named alongside the lineup (in cricket: the head coach plus the batting and bowling coaches). An empty list when the source names none (the usual case outside cricket) and on any lineup stored before 2026-11-18. Available since 2026-11-18. */
  supportStaff: SupportStaffMember[];
}

/** An individual entry in a lineup. */

export interface LineupPlayer {
  /** Player reference. */
  player: PlayerRef | null;
  /** Position the player fills in this lineup. */
  position: Position | null;
  /** Position code from the source, as shown on a team sheet ("G", "LW", "QB", "1B"). */
  positionCode: string | null;
  /** Shirt number as a string, since "00" is possible. Also filled where the source keeps the number only on the player record, as in handball (since 2026-11-23). */
  jerseyNumber: string | null;
  /** True if the player started on the bench. */
  substitute: boolean;
  /** True for the team captain. */
  captain: boolean;
  /** Height, copied over from the profile at GET /v2/players/{id}; null if the source has no value. Available since 2026-11-06. Unit: cm. */
  heightCm: number | null;
  /** Birth date from the player’s profile; null if unknown. Available since 2026-11-06. */
  dateOfBirth: string | null;
  /** Nationality from the player’s profile, flag included; null if unknown. Available since 2026-11-06. */
  country: Country | null;
  /** Estimated market value from the player’s profile; null if unknown (the source only provides it for some football players). Available since 2026-11-06. */
  marketValue: Money | null;
  /** Match rating to 2 decimal places (e.g. 7.4); null for an unrated player. */
  rating: number | null;
  /** Football: the player’s average match rating over the season (2 decimals), included when the source sends it with the lineup — usually in the run-up to kick-off and around it. */
  avgRating: number | null;
  /** Football: the rating from the original model alongside the one from the source’s alternative model. */
  ratingVersions: {
    original: number | null;
    alternative: number | null;
  } | null;
  /** Ice hockey: whether the player was picked as first, second or third star of the game. */
  star: 1 | 2 | 3 | null;
  /** Baseball: the player’s slot in the batting order. */
  battingOrder: number | null;
  /** The player’s match statistics, using sport-specific camelCase keys from the same vocabulary as team statistics: whenever a key measures the same thing as a team StatItem, it shares that key (football minutesPlayed, passes, accuratePasses, shotsOnGoal, expectedGoals …; basketball points, fieldGoalsMade, fieldGoalsAttempted, secondsPlayed …; ice hockey goals, shotsOnGoal, penalties, plusMinus, savePercentage …). On NBA games played after 2026-11-22 21:00 UTC, a live box score adds `pointsFastBreak`, `pointsInPaint`, `pointsFromTurnovers` and `foulsDrawn` for the players it lists; other leagues lack them. In football matches the live tracker follows (MLS and the Champions League among them), from 2026-11-23 on: `injuries` and `cornerKicks` (corners he took), plus a goalkeeper’s `shotsFaced` (the opposition’s attempts during his time in goal) and `cleanSheet` (1 or 0, judged on the minutes he played; it reads 0 until the match is over), from a live box score supplied by a different provider, for the players it lists. The football penalty keys (penaltyWon, penaltyConceded, penaltyMiss, penaltyFaced, penaltySave) are listed in the data dictionary. Every …Percentage key is a share from 0 to 100 — ice-hockey save percentages too (94.1 rather than 0.941). Values are in seconds where the key name says so. Null if the player has no statistics. */
  statistics: Record<string, number> | null;
  /** Baseball: each part the player took in the game, in the order he took it. A starter switched from left to centre field reads [leftField, centerField]; a substitute who batted for a team-mate and then stayed on at first base reads [pinchHitter, firstBase]. An empty list outside baseball, or when the source has no record of it. Available since 2026-11-23. */
  baseballRoles: BaseballRole[];
  /** Baseball: the order players came into the game, as numbered in the source’s box score. Starters carry the lowest numbers and each substitute follows the moment he entered. Null in other sports. Available since 2026-11-23. */
  entrySequence: number | null;
}

/** A player who is unavailable for a fixture. */

export interface MissingPlayer {
  /** Player reference. */
  player: PlayerRef | null;
  /** Whether the player is ruled out or only doubtful. */
  availability: Availability | null;
  /** Cause of the absence. */
  reason: MissingReason | null;
  /** Further detail in the source’s words, such as "Hamstring Injury" or "Red card suspension". */
  description: string | null;
  /** Anticipated return time, if known. */
  expectedReturnAt: string | null;
}

/** A coach or other staff member named with a side’s lineup. */

export interface SupportStaffMember {
  /** DataSportsAPI id for the person, the same in every fixture (no endpoint looks it up); null when the source supplies none. */
  id: number | null;
  /** The person’s name. */
  name: string | null;
  /** What the person does; null when the source does not say. */
  role: SupportStaffRole | null;
  /** Nationality, if the source supplies it. */
  country: Country | null;
}

/** Match statistics broken down by period. */

export interface Statistics {
  /** An entry for each period the source provides statistics for, beginning with "all". Overtime is split by overtime period (overtime1, overtime2, …); the single overtime of an NHL regular-season game is overtime1. */
  periods: {
    period: "all" | PeriodKey;
    groups: StatGroup[];
  }[];
}

/** A themed set of statistics. */

export interface StatGroup {
  /** Stable group identifier from a per-sport table, not derived from the display name — "matchOverview", "attack", "other" and so on. */
  key: string;
  /** Human-readable group title, such as "Match overview". */
  name: string | null;
  items: StatItem[];
}

/** A single match statistic with values for both teams. */

export interface StatItem {
  /** Stable camelCase identifier. A given key always denotes the same quantity, across all sports and in lineup player statistics, though it may show up in two groups. Ratio keys are named after the successes their `value` counts (`aerialDuelsWon`, `fieldGoalsMade`, `accurateCrosses`, `firstServesIn`, `powerPlayConversion`) and never end in `…Percentage`; that suffix is reserved for keys whose `value` is already a 0–100 share (`duelsWonPercentage`, `corsiPercentage`). Note that `blocks` counts attempts this side blocked, while `shotsBlocked` counts this side’s own shots that got blocked. On NBA games played after 2026-11-22 21:00 UTC, a live box score adds `pointsFastBreak`, `pointsInPaint`, `pointsFromTurnovers`, `foulsDrawn` and `foulsToGive` (fouls a side has left in the period until the other team shoots bonus free throws), in the `all` period only; other leagues lack them. In football matches the live tracker follows (MLS and the Champions League among them), from 2026-11-23 on, a live box score from a different provider adds `injuries` (group matchOverview, `all` period). The data dictionary lists every key per sport. */
  key: string;
  /** English label as provided by the source. */
  name: string | null;
  /** Tells you how to interpret the value and total of the statistic. */
  kind: StatKind;
  /** Indicates whether a larger number is better; use it to emphasise the side that leads. */
  higherIs: HigherIs | null;
  /** Home side’s figures. */
  home: StatSide;
  /** Away side’s figures. */
  away: StatSide;
}

/** A single team’s value for a statistic. */

export interface StatSide {
  /** Ready-to-display text in the source’s own form, such as "57%", "33/53 (62%)" or "1:22". A ratio keeps the percentage the source prints, which some competitions and statistics round down ("21/49 (42%)") while others round normally; we compute it ourselves (rounded) only where the source’s figure fits neither (table tennis sends "(0%)"). */
  display: string | null;
  /** Underlying numeric value; interpret it using the item’s `kind`. */
  value: number | null;
  /** For kind ratio, the number of attempts; for kind time, the seconds available. Null for other kinds. */
  total: number | null;
}

/** Something that happened during a match. As with all timeline lists, entries run oldest first (chronological order). */

export interface Incident {
  /** Category of the event. */
  type: IncidentType;
  /** Sub-category within the type; null on period and injuryTime rows. */
  detail: IncidentDetail | null;
  /** Side the event is credited to (an own goal belongs to the side that benefits from it); null on period / injuryTime rows. */
  side: Side | null;
  /** Match minute. Null whenever the clock is stopped — before kick-off, at half-time and after full time, for bench events, and during a shoot-out. Unit: minutes. */
  minute: number | null;
  /** How far into stoppage time the event happened (90+3 gives minute 90, addedMinute 3). On injuryTime rows it holds the announced minutes. Unit: minutes. */
  addedMinute: number | null;
  /** Game clock in seconds, if the source supplies it — present on all rows in ice hockey, basketball, handball and rugby, but only on period rows in football. Unit: seconds. */
  second: number | null;
  /** Period in which the event took place. On period rows it is the period that just ended (ET → extra2, PEN → penalties, FT → period2 in football and period4 in basketball). On other rows it is the period bounded by the surrounding period rows, or the source’s own value when supplied; shoot-out kicks use penalties. A card shown to the bench takes the period its `benchMinute` falls in (since 2026-11-26). Null only if it cannot be determined (no period row yet and the period length for the sport is unknown). */
  period: PeriodKey | null;
  /** Main player involved: the scorer, the booked or penalised player, the subject of a VAR check, or the shoot-out taker. */
  player: PlayerRef | null;
  /** Name of the player; filled even when the source provides a name without a player record (as with some own goals). For a card given to a manager it is the manager's name. */
  playerName: string | null;
  /** Set when the incident concerns a manager (head coach) on the bench, such as a booking from the touchline: our id for that manager. Null on every other row. Available since 2026-11-26. */
  manager: ManagerRef | null;
  /** For an incident on the bench, which the match clock does not count (a manager's card): the minute of play it came in, in the source's count. `minute` is null on such rows, and `period` follows from this minute (a booking in the 63rd minute is in period2). Null otherwise. Available since 2026-11-26. Unit: minutes. */
  benchMinute: number | null;
  /** Players credited with assists on the goal who have a player record, in order (up to two in ice hockey). An assister the source names without a record appears only in assistNames. */
  assists: PlayerRef[];
  /** Every assist on the goal as a name, in order, including assisters the source names without a player record (frequent in futsal, where assists could stay empty). Incidents stored before 2026-11-24 read [] until they are refreshed. Available since 2026-11-24. */
  assistNames: string[];
  /** Football goals only: `head` when the source's event list marks the goal as a header (only some leagues do, and they never name a foot); null on every other goal and incident. The goal's `buildUp` and the shotmap carry the body part more often. Available since 2026-11-23. */
  bodyPart: BodyPart | null;
  /** For a substitution: the player entering the field. */
  playerIn: PlayerRef | null;
  /** For a substitution: the player leaving the field. */
  playerOut: PlayerRef | null;
  /** On a substitution, `true` if the player left the pitch injured; null on every other incident and when our data source does not say. Available since 2026-11-20. */
  injury: boolean | null;
  /** For an ice hockey suspension: the player who drew the penalty. */
  drawnBy: PlayerRef | null;
  /** For an ice hockey suspension: the player who sat in the penalty box in place of the penalised player (for a goalkeeper’s penalty or a bench minor, say). Null when the penalised player served it, and in every other sport. Available since 2026-11-18. */
  servedBy: PlayerRef | null;
  /** For an ice hockey suspension: the offence under a camelCase key that does not change ("tripping", "interference", "crossChecking", "slashing", "roughing"), or "minor" if the source does not name one, with `reason` holding the same thing as display text. Expect new keys over time. Null in other sports. Available since 2026-11-18. */
  infraction: string | null;
  /** For an ice hockey suspension: the class of penalty (minor, major, …); null if the source leaves it out, and always null outside ice hockey. Available since 2026-11-18. */
  severity: PenaltySeverity | null;
  /** For an ice hockey goal, where the source keeps the count (NHL): the scorer’s goals so far this season, this one included — the number a scoresheet prints in brackets after the name, as in "(12)". Null otherwise. Available since 2026-11-18. */
  seasonGoals: number | null;
  /** For an ice hockey goal (NHL): each assisting player’s assists so far this season, this one included — one entry for each entry of `assists`, in the same order, and null for a player the source has no count for. An empty list when the source keeps no counts. Available since 2026-11-18. */
  seasonAssists: (number | null)[];
  /** Home score immediately after the event (on goals, period rows and shoot-out kicks). For period rows in set sports (volleyball, table tennis, badminton) it is the number of sets won so far; the points inside each set are given by /points and by the fixture’s `periods`. */
  homeScore: number | null;
  /** Away score immediately after the event (sets won, on period rows in set sports). */
  awayScore: number | null;
  /** On period rows: the label a scoreboard would show ("HT", "FT", "Q4", "3rd period", "Overtime", "PEN"). For display only. */
  text: string | null;
  /** For a card, why it was shown ("Foul", "Violent conduct"); for a suspension, the offence ("Holding"); for a missed penalty, how it was missed ("Goalkeeper save", "Off target"). */
  reason: string | null;
  /** For a card: true if it was later withdrawn. */
  rescinded: boolean | null;
  /** For a varDecision: true when the original decision was upheld. */
  confirmed: boolean | null;
  /** For a shootoutPenalty: position of the kick in the overall order across both teams (1 is the opening kick of the shoot-out). */
  shootoutSequence: number | null;
  /** For a shootoutPenalty: the round, i.e. whether it was the taking side’s 1st, 2nd, … kick. */
  shootoutRound: number | null;
  /** For a suspension: how long the player is excluded. Unit: seconds. */
  durationSeconds: number | null;
  /** For a football goal: the sequence of passes and shots leading up to it, ending with the goal itself (covered leagues only; empty elsewhere and for all other incidents). */
  buildUp: BuildUpStep[];
}

/** An incident paired with its stable key, as used in events frames. */

export interface KeyedIncident {
  /** Identifier of the incident that stays stable within the fixture, built as `type:side:minute:addedMinute` (e.g. "goal:home:34:0", with "-" standing in for a null side or minute). Additional incidents in the same slot get `#2`, `#3`, … in list order. The player is not part of the key, so correcting the scorer or goal type keeps the key and counts as an update; correcting the minute produces a new key and removes the old one. */
  key: string;
  /** The match event itself. As with all timeline lists, entries run oldest first (chronological order). */
  incident: Incident;
}

/** The difference between an events frame and the one before it. */

export interface IncidentChanges {
  /** Keys of incidents that did not exist in the previous events frame (or in the server’s earlier copy). */
  added: string[];
  /** Keys of incidents whose details were modified (scorer, assist, build-up, rescinded card, …). */
  updated: string[];
  /** Incidents that have disappeared from the source, each with its final content — for example a goal cancelled by VAR. The score reverts through a delta, and the goal shows up here once REST confirms its removal. */
  removed: KeyedIncident[];
}

/** A single action in the move leading to a goal, as mapped by the source (football, covered leagues). */

export interface BuildUpStep {
  /** Type of action performed in this step. */
  action: BuildUpAction;
  /** Team of the player performing the action (for an own goal, the final step belongs to the defending side). */
  side: Side | null;
  /** Player who performed the action. */
  player: PlayerRef | null;
  /** Minute of the match. Unit: minutes. */
  minute: number | null;
  /** Pitch location where the action began. */
  position: PitchSpot | null;
  /** For a pass / cross: where the ball ended up. Null for other actions. */
  endPosition: PitchSpot | null;
  /** True for the pass credited as the assist. */
  assist: boolean;
  /** For the goal: the body part used to strike it. */
  bodyPart: BodyPart | null;
  /** For a goal / savedShot: xG value of the chance on a 0–1 scale, if the source provides it. */
  expectedGoals: number | null;
  /** For a goal / savedShot: expected goals on target (xGOT), if available. */
  expectedGoalsOnTarget: number | null;
  /** For the goal: the area of the goal mouth it went into. */
  goalMouthLocation: GoalMouthLocation | null;
}

/** A location on a football pitch. */

export interface PitchSpot {
  /** Lengthwise position from 0 to 100, oriented in the attacking direction of the SCORING side (100 is the goal the ball ended up in, own goals included). For away goals we rotate the source’s coordinates, in which the home side always attacks towards 100 (corrected 2026-10-23). Unit: percent. */
  x: number;
  /** Widthwise position from 0 to 100, rotated together with x (seen from the scoring side). Unit: percent. */
  y: number;
}

/** The record of the two teams against each other; the endpoint answers null when there is none. */

export interface H2H {
  /** Meetings won by the home team of this fixture. */
  homeWins: number;
  /** Meetings won by the away team of this fixture. */
  awayWins: number;
  /** Number of drawn meetings. */
  draws: number;
  /** How the two managers have fared head to head (football and other sports that have managers). Null if they have never met or the source has no data. */
  managerDuel: ManagerDuel | null;
}

/** Head-to-head record between the two managers, counting every team either of them has managed. Only the counts are given; the managers themselves come from /v2/fixtures/{id}/managers. */

export interface ManagerDuel {
  /** Wins for teams led by the home manager over teams led by the away manager. */
  homeWins: number;
  /** Wins for the away manager’s teams. */
  awayWins: number;
  /** Number of drawn meetings. */
  draws: number;
}

/** The managers (head coaches) in charge of one particular match, kept as they were on the day even long afterwards. Fixture.homeManager / awayManager, by contrast, show each team’s current manager. Both are null when the source names no manager, as in most sports that have none. */

export interface MatchManagers {
  /** Manager of the home side in this match; null if the source names none. */
  homeManager: ManagerRef | null;
  /** Manager of the away side in this match; works like homeManager. */
  awayManager: ManagerRef | null;
}

/** Form of both sides heading into a fixture, within its competition. A side is null if the source has no form for it — tennis, for instance, for which the source has no competition form guide. The latest matches of each side across every competition are on /v2/fixtures/{id}/team-form. */

export interface PregameForm {
  home: TeamForm | null;
  away: TeamForm | null;
}

/** Pre-match form of a single side. */

export interface TeamForm {
  /** Up to five most recent results in this competition prior to the fixture, ordered from oldest to newest. */
  results: FormResult[];
  /** Table position before the fixture. */
  position: number | null;
  /** Points in the table before the fixture, for competitions whose standings use points (football, ice hockey, handball, rugby, …); null otherwise. */
  points: number | null;
  /** Wins going into the fixture, for tables that count wins and losses instead of points (W-L in basketball and baseball, W-D-L in MMA); null otherwise. In MMA it is the source’s tally inside the event’s competition — e.g. Volkanovski at 8-0-3 ahead of UFC 333, with a 28-0-4 career record — not the career record — that lives in TeamDetail.record on /v2/teams/{id}. */
  wins: number | null;
  /** Draws, for records that include them (MMA W-D-L); null otherwise. */
  draws: number | null;
  /** Losses, set alongside `wins`; null otherwise. */
  losses: number | null;
  /** Average player rating of the side over its recent matches (2 decimals). */
  avgRating: number | null;
}

/** A recent match played by a side ahead of a fixture, including its score (from /v2/fixtures/{id}/team-form). */

export interface FormFixture {
  /** DataSportsAPI id of that match (GET /v2/fixtures/{id}). */
  fixtureId: number;
  /** Start time of the match (UTC). */
  startTime: string | null;
  /** Competition the match belonged to, of any type (league, cup, European, friendly). */
  league: LeagueRef | null;
  /** Whether the team was home or away in that match. */
  side: Side;
  /** The opposing team. */
  opponent: TeamRef | null;
  /** Score the team achieved, equal to its side’s Fixture score `current` (goals, points; sets in tennis). */
  scoreFor: number | null;
  /** Score of the opposing team. */
  scoreAgainst: number | null;
  /** Outcome for the team as interpreted by the source; matches settled in overtime or on penalties count as a win for the side that prevailed. */
  result: FormResult | null;
}

/** The latest matches of each side before a fixture, across every competition, each with opponent, score and result. Filled for tennis as well, where the competition form guide (/v2/fixtures/{id}/form) has nothing. */

export interface TeamFormFixtures {
  /** Up to five finished matches the home side played in ANY competition before this fixture, ordered oldest to newest; empty if the source has none. */
  home: FormFixture[];
  /** The same list for the away side. */
  away: FormFixture[];
}

/** Runs of form for both teams heading into a fixture. */

export interface Streaks {
  /** For both sides, the streaks that run through their latest matches in every competition before this fixture. After the final whistle it keeps the streaks the match was played with. */
  general: Streak[];
  /** Streaks drawn from matches between the two sides. */
  headToHead: Streak[];
}

/** A noteworthy team streak to highlight before a fixture. */

export interface Streak {
  /** English description of the streak, such as "Wins", "No losses" or "More than 2.5 goals". Display text only, since the source provides no stable key. */
  name: string;
  /** How to read the figure: an average, a consecutive run, or x out of the last y. */
  kind: StreakKind;
  /** The figure exactly as the source formats it: "5" for five in a row, "7/8" when seven of the last eight qualified, "83" for an average. */
  value: string;
  /** Number of matches for which the streak holds (the 5 in "5", the 7 in "7/8"); null for an average. */
  count: number | null;
  /** The y in an "x of the last y" streak; null for consecutive runs and averages. */
  outOf: number | null;
  /** For kind average, the value itself (83 points a game); null otherwise. */
  average: number | null;
  /** Which team the streak belongs to. */
  side: StreakSide;
  /** True if the streak is still active. */
  continued: boolean | null;
}

/** Top performers for each team. */

export interface BestPlayers {
  /** The player of the match, in sports that award one. */
  playerOfTheMatch: BestPlayer | null;
  home: BestPlayer[];
  away: BestPlayer[];
  /** One ranking of the match across both teams, best first, where the source keeps one: handball’s ten leading scorers, basketball by points, every baseball top performer. home and away then list only each team’s best. [] when the source ranks none. Available since 2026-11-23. */
  leaderboard: RankedBestPlayer[];
}

/** One of the standout players in a match. */

export interface BestPlayer {
  /** Player reference. */
  player: PlayerRef | null;
  /** Figure the ranking is based on (a rating, points, goals, yards). Baseball (since 2026-11-23): a top-performer score from the source with label rating, higher meaning better; the source publishes no scale for it. */
  value: number | null;
  /** Describes what `value` measures. */
  label: BestPlayerLabel | null;
  /** Basketball: the player’s stat line, using the same keys as lineup statistics (points, rebounds, assists, steals, blocks, rating). For baseball, available since 2026-11-04, the numbers — pitching or batting — that got the player picked (pitchingInningsPitched, pitchingStrikeOuts, battingHits, battingHomeRuns, battingRbi, …). Null in any sport where the source lists nothing. */
  statistics: Record<string, number> | null;
  /** Baseball (since 2026-11-04): pitcher or batter, i.e. the role the player was picked for; null for every other sport. */
  role: BestPlayerRole | null;
}

/** A place on a match’s leaderboard (BestPlayers.leaderboard): the fields of a BestPlayer plus the team the player was on. Available since 2026-11-23. */

export interface RankedBestPlayer {
  /** Player reference. */
  player: PlayerRef | null;
  /** The figure the place rests on: a rating, points, goals or yards; in baseball the source’s top-performer rating. */
  value: number | null;
  /** What value measures. */
  label: BestPlayerLabel | null;
  /** Basketball and baseball: the player’s line, in the keys of lineup statistics; null where the source lists none. */
  statistics: Record<string, number> | null;
  /** Baseball: whether he made the list as a pitcher or as a batter; null in other sports. */
  role: BestPlayerRole | null;
  /** His club at the time; null if the source's row leaves it out. */
  side: Side | null;
}

/** Values for drawing a momentum chart: one per game in tennis, one per minute in football, basketball, handball, ice hockey and the like. */

export interface Momentum {
  /** One value for every minute, in match order; points in added time come after the final minute of their period. */
  points: {
    minute: number;
    addedMinute: number | null;
    value: number;
  }[];
  /** How long one regulation period lasts — 45 minutes in football, 10 in basketball, 20 in ice hockey. Unit: minutes. */
  periodLengthMinutes: number | null;
  /** Number of regulation periods. */
  periodCount: number | null;
  /** Duration of a single overtime period. Unit: minutes. */
  overtimeLengthMinutes: number | null;
  /** How many overtime periods were played, if the source reports it. */
  overtimeCount: number | null;
  /** Tennis: a value for each game in sequence (minute points stay empty). Empty in other sports. */
  games: {
    period: PeriodKey;
    game: number;
    value: number;
    breakOfServe: boolean;
  }[];
}

/** A single shot attempt (football, ice hockey, basketball field goals). Lists run chronologically, oldest first, with shoot-out kicks at the end in kick order. Basketball is the exception: the source gives no timing, so one team’s shots (team=home|away) arrive in whatever order the source lists them, and side, outcome and position are the only fields filled. */

export interface Shot {
  /** Team that took the shot. */
  side: Side | null;
  /** Player who took the shot. */
  player: PlayerRef | null;
  /** Football: the opposing goalkeeper. */
  goalkeeper: PlayerRef | null;
  /** Result of the shot. */
  outcome: ShotOutcome | null;
  /** Ice hockey: type of shot. */
  technique: ShotTechnique | null;
  /** Set on goals only: regular, ownGoal or penalty. */
  goalType: ShotGoalType | null;
  /** Football: the phase of play that produced the shot. */
  situation: ShotSituation | null;
  /** Football: body part used to strike the ball. */
  bodyPart: BodyPart | null;
  /** Ice hockey: the manpower situation at the time. */
  strength: ShotStrength | null;
  /** xG value of the chance on a 0–1 scale. */
  expectedGoals: number | null;
  /** Football: post-shot expected goals (xGOT), set for shots on target. */
  expectedGoalsOnTarget: number | null;
  /** Minute of the match. Unit: minutes. */
  minute: number | null;
  /** How far into stoppage time the shot came. Unit: minutes. */
  addedMinute: number | null;
  /** Game clock reading in seconds. Unit: seconds. */
  second: number | null;
  /** Period in which the shot came. In football the minute decides it (shoot-out kicks → penalties, 45+2 → period1, 92 → extra1); in ice hockey it is the source’s period (overtime1 for a shot in overtime); basketball has no timing, so it stays null. */
  period: PeriodKey | null;
  /** Where the shot was taken from. Football: pitch percentages 0–100, with x measured from the goal line under attack and y across the pitch. Ice hockey: x roughly 0–240 along the ice (rink units from the source, each side attacking one end) and y covering 0–100 from side to side. Basketball: tenths of a foot measured from the basket being attacked; x runs across the court (−250…250 sideline to sideline), y away from the basket (0 is the rim, and the NBA three-point arc sits at 237.5). */
  position: Point | null;
  /** Football: point at which the ball crossed the goal line (y 0–100 across the goal mouth, z for height). */
  goalMouth: Point | null;
  /** Football: zone of the goal mouth the shot reached, or of the near miss. */
  goalMouthLocation: GoalMouthLocation | null;
  /** Football: the point at which a blocked or saved shot was halted. */
  blockPosition: Point | null;
  /** Football shoot-out kicks: where the kick falls in the combined order of both teams (the same numbering the shoot-out incidents use). */
  shootoutSequence: number | null;
  /** Football shoot-out kicks: which of the shooting side’s kicks this was (1st, 2nd, …). */
  shootoutRound: number | null;
}

/** A coordinate pair; see Shot for each sport’s coordinate system. */

export interface Point {
  x: number | null;
  y: number | null;
  z: number | null;
}

/** Activity map of one player across a fixture (football, covered leagues). */

export interface Heatmap {
  /** All recorded samples, meant to be drawn as a density map. If the source has no heatmap for this player and fixture — always so outside football — the list comes back empty with 200, not 404. */
  points: HeatPoint[];
}

/** A single touch or position sample within a heatmap. */

export interface HeatPoint {
  /** Lengthwise position from 0 to 100, oriented in the player’s attacking direction (100 is the goal being attacked). Unit: percent. */
  x: number;
  /** Widthwise position from 0 to 100. Unit: percent. */
  y: number;
}

/** Mean on-pitch positions of every player on both sides (football, covered leagues). */

export interface AveragePositions {
  home: AveragePosition[];
  away: AveragePosition[];
}

/** Where a player was positioned on average during a fixture. */

export interface AveragePosition {
  /** Player reference. */
  player: PlayerRef | null;
  /** The player’s shirt number. */
  jerseyNumber: string | null;
  /** Position as used in lineups, derived from `positionCode`. */
  position: Position | null;
  /** Single-letter position code from the source ("G", "D", "M", "F"). */
  positionCode: string | null;
  /** Mean lengthwise position from 0 to 100, oriented in the team’s attacking direction. Unit: percent. */
  x: number | null;
  /** Mean widthwise position from 0 to 100. Unit: percent. */
  y: number | null;
  /** Number of position samples the average is computed from. */
  pointsCount: number | null;
}

/** A fixture’s point-by-point record, shaped by sport: sets → games → points in tennis, sets → rallies in rally sports, innings → overs → balls in cricket, at-bats in baseball, and sets → legs → visits in darts. */

export interface Points {
  /** Names the list among `sets` / `innings` / `atBats` / `darts` that has data. Null until something arrives, and in sports without any point-by-point data — those get 200 with empty lists rather than 404. */
  format: PointsFormat | null;
  /** Tennis and rally sports: an entry for each set, in sequence. */
  sets: PointSet[];
  /** Cricket: an entry for each innings, in sequence. */
  innings: InningsBalls[];
  /** Baseball: all plate appearances in chronological order, oldest first. */
  atBats: AtBat[];
  /** Darts: nested sets → legs → visits, in sequence. */
  darts: DartsSet[];
}

/** Point-by-point detail of a single set. */

export interface PointSet {
  /** Which set this is: period1, period2, … */
  period: PeriodKey;
  /** Games (tennis) or points (rally sports) the home side won in the set, taken from the final listed score. For a tennis match tie-break the points are counted (10-8), consistent with the fixture’s period score. */
  homeScore: number | null;
  /** Games / points the away side won in the set. */
  awayScore: number | null;
  /** Tennis: each game in sequence. Empty for rally sports. */
  games: TennisGame[];
  /** Rally sports: each rally in sequence as recorded by the source. Lower-tier coverage may skip a rally, which shows up as a jump in the running score. Empty for tennis. */
  points: RallyPoint[];
}

/** A single game within a tennis set. */

export interface TennisGame {
  /** Position of the game in the set (13 is the tie-break). When a match tie-break stands in for the deciding set, it is that set’s game 1, played to 10 points. */
  number: number;
  /** The serving side. For a tie-break the source reports whoever served its LAST point rather than its first (verified against real tie-breaks on 2026-10-19). */
  server: Side | null;
  /** Side that took the game; if it differs from the server, serve was broken. For a completed tie-break we take the winner from its final point, because in a check on 2026-10-19 the source had the wrong game winner on 3 of 8 match tie-breaks. */
  winner: Side | null;
  /** Games won by the home side in the set once this game is over. */
  homeGames: number | null;
  /** Games won by the away side in the set once this game is over. */
  awayGames: number | null;
  /** Each point in sequence. For a completed game the final point is the one that decided it (its `winner` matches the game’s winner); for a game still under way, the points played so far. */
  points: TennisPoint[];
}

/** A single point within a tennis game. */

export interface TennisPoint {
  /** Home side’s game score following the point: "0", "15", "30", "40", "A" (plain numbers in a tie-break). It is a string to accommodate "A". Null on the point that closes a regular game, since no score exists once the game is over. */
  homeScore: string | null;
  /** Away side’s game score following the point; null in the same case as `homeScore`. */
  awayScore: string | null;
  /** Side that won the point, inferred from how the score changed; null if that cannot be inferred. */
  winner: Side | null;
  /** Marks an ace or a double fault; null for all other points and for the game-winning point we append. The source does not list that final point, so an ace that closes a game goes unmarked. */
  description: TennisPointDescription | null;
  /** What the point means for the home side (point won, now holding break or set point, mini-break in a tie-break). Null on the game-winning point added at the end. */
  homeType: TennisPointType | null;
  /** Significance of the point for the away side, as for homeType. */
  awayType: TennisPointType | null;
}

/** A single rally within a set (volleyball, table tennis, badminton). */

export interface RallyPoint {
  /** Side that won the rally. */
  winner: Side | null;
  /** Home side’s points in the set following the rally. */
  homeScore: number | null;
  /** Away side’s points in the set following the rally. */
  awayScore: number | null;
}

/** Ball-by-ball record of a single cricket innings. */

export interface InningsBalls {
  /** Innings key (inning1, inning2, …), matching ScoreSide.innings. */
  inning: PeriodKey;
  /** Side at bat during this innings. */
  battingSide: Side | null;
  /** Each over in sequence. */
  overs: Over[];
}

/** A single over within an innings. */

export interface Over {
  /** Over number, starting at 1 for the opening over. Cricket notation counts completed overs instead, so the 3rd ball of over 46 reads "45.3". */
  number: number;
  /** Each delivery in sequence. */
  balls: Ball[];
}

/** A single cricket delivery. */

export interface Ball {
  /** Running delivery counter from the source across the whole match, useful for ordering deliveries between overs. */
  sequence: number | null;
  /** Delivery number inside the over; extras can take it above 6. */
  ball: number | null;
  /** Result of the delivery. */
  outcome: BallOutcome;
  /** Runs scored off the bat. */
  runs: number | null;
  /** All runs the delivery contributed, extras included. */
  totalRuns: number | null;
  /** True if a wicket fell on this ball. */
  wicket: boolean;
  /** Manner of dismissal, when a wicket fell. */
  dismissal: Dismissal | null;
  /** Batter facing the delivery. */
  batter: PlayerRef | null;
  /** Bowler who delivered the ball. */
  bowler: PlayerRef | null;
  /** Fielder who took part in a dismissal (catch, run-out, stumping). */
  fielder: PlayerRef | null;
  /** Batter who was dismissed, which is not always the striker (run-outs). */
  dismissedBatter: PlayerRef | null;
  /** Batting side’s total runs once the delivery is complete. */
  scoreRuns: number | null;
  /** Wickets fallen once the delivery is complete. */
  scoreWickets: number | null;
  /** English ball-by-ball commentary for the delivery, verbatim from the source — e.g. "FOUR! … driven firmly through the covers". Null if the source has none (lower-tier matches, or deliveries stored before 2026-11-04). Available since 2026-11-04. */
  commentary: string | null;
  /** Direction the ball travelled off the bat, as plotted on a wagon wheel. Null if the source records no direction (an unhit dot ball, a leave, a bye; lower-tier matches). Available since 2026-11-04. */
  shot: CricketShot | null;
  /** Landing spot of the ball for a pitch map, in the source’s units: y increases with distance from the batter’s stumps (yorker ≈ 25, good length ≈ 41, short ball ≈ 54) and x spans the width of the pitch (values of ≈ 6–26 observed); z is always null. Null if the source has no data. Available since 2026-11-04. */
  pitchedAt: Point | null;
}

/** Direction and distance of a cricket shot, forming one line on the wagon wheel. */

export interface CricketShot {
  /** Field sector of the shot; null if the source provides only an angle. */
  zone: CricketShotZone | null;
  /** Shot direction in degrees in the source’s reference frame, seen from a right-handed batter: 0 ≈ square leg, 90 ≈ right behind the keeper, 180 ≈ point, 270 ≈ straight back down the pitch. Unit: degrees. */
  angle: number | null;
  /** How far the ball went, on a 1–5 scale set by the source: 1–2 near the bat (say, back to the bowler or edged to the keeper), 3 the ring, 4 the deep, 5 the boundary — every four and six. We inferred these bands from the data on 2026-11-04; the source does not document them. */
  distance: number | null;
}

/** A single baseball plate appearance. The at-bat list has no outcome field; the result is that of the final pitch (`/at-bats/{atBatId}/pitches`). */

export interface AtBat {
  /** DataSportsAPI id of the at-bat, for use with /v2/fixtures/{id}/at-bats/{atBatId}/pitches. Present since 2026-11-04; lists saved before then show null. */
  id: number | null;
  /** Inning number (10, 11, … indicate extra innings). */
  inning: number;
  /** top: the away team is batting; bottom: the home team is batting. */
  half: "top" | "bottom";
  /** Side at bat, derived from the half. */
  battingSide: Side;
  /** Batter reference. */
  batter: PlayerRef | null;
  /** Pitcher reference. */
  pitcher: PlayerRef | null;
  /** Home win probability before the at-bat on a 0–100 scale, as calculated by the SOURCE (these are not bookmaker odds). Unit: percent. */
  homeWinProbabilityBefore: number | null;
  /** Home win probability after the at-bat according to the source, 0–100; the away probability is 100 − home. Unit: percent. */
  homeWinProbabilityAfter: number | null;
  /** Time the at-bat was recorded. */
  at: string | null;
}

/** A single set in darts; a match played in legs consists of one set. */

export interface DartsSet {
  /** Set number, always 1 in a legs match. */
  number: number;
  /** Winner of the set; null in a match played in legs and while the set is still going. */
  winner: Side | null;
  /** Sets won by the home side once this set is over; null in a legs match. */
  homeSets: number | null;
  /** Sets won by the away side once this set is over; null in a legs match. */
  awaySets: number | null;
  /** Each leg in sequence. */
  legs: DartsLeg[];
}

/** A single darts leg broken down visit by visit. */

export interface DartsLeg {
  /** Leg number inside the set (in a legs match, the whole match is one set). */
  number: number;
  /** Starting score for each player in the leg (501), as listed by the source. */
  startScore: number | null;
  /** Side that threw first in the leg according to the source (the throw alternates between legs). The visit list may still open with the other player; this has been seen once on a first leg. */
  throwingFirst: Side | null;
  /** Side that won the leg; null while it is still being played. */
  winner: Side | null;
  /** Legs won by the home side in the set once this leg is over. */
  homeLegs: number | null;
  /** Legs won by the away side in the set once this leg is over. */
  awayLegs: number | null;
  /** Score of the visit that won the leg (the checkout); null while the leg is in progress or if the final visit is missing. */
  checkout: number | null;
  /** Each visit in sequence. */
  visits: DartsVisit[];
}

/** One player’s turn at the board: a visit of up to three darts. The source does not report how many darts were thrown. */

export interface DartsVisit {
  /** Side that threw. */
  side: Side;
  /** Points scored in the visit, computed as the thrower’s remaining score before minus after. 0 covers both a scoreless visit and a bust, which the source does not distinguish. Null if the drop is impossible for one visit (over 180, meaning the source skipped a visit). */
  scored: number | null;
  /** Home side’s remaining score once the visit is done. */
  homeRemaining: number;
  /** Away side’s remaining score once the visit is done. */
  awayRemaining: number;
  /** True if this visit won the leg by bringing the thrower to 0; `scored` then holds the checkout. */
  checkout: boolean;
}

/** Baseball: occupancy of each base. */

export interface Bases {
  /** True when first base is occupied. */
  first: boolean;
  /** True when second base is occupied. */
  second: boolean;
  /** True when third base is occupied. */
  third: boolean;
}

/** Baseball: the current game situation — inning, half, count, outs and runners. It contains no batter or pitcher because the source does not provide them here; find the current at-bat’s in /points `atBats`. The source’s live feed refreshes this state roughly once a minute rather than after each pitch, so the count may trail the game by up to a minute. */

export interface InningState {
  /** Current inning (10, 11, … indicate extra innings). */
  inning: number;
  /** top: the away team is batting; bottom: the home team is batting. */
  half: "top" | "bottom";
  /** Side at bat, derived from the half. */
  battingSide: Side;
  /** Number of balls in the current count. */
  balls: number | null;
  /** Number of strikes in the current count. */
  strikes: number | null;
  /** Outs recorded in the half-inning; 3 means the half has just finished. */
  outs: number | null;
  /** Occupancy of each base. */
  bases: Bases;
}

/** Basketball and, since 2026-11-23, American football: the timeouts each side has left and the one being taken right now, as tracked by the source. */

export interface Timeouts {
  /** Timeouts still available to the home side. */
  homeRemaining: number | null;
  /** Timeouts still available to the away side. */
  awayRemaining: number | null;
  /** Timeouts each side is allotted: for the game in basketball (7 in the NBA), per half in American football (3 in the NFL). */
  perTeam: number | null;
  /** The timeout in progress; null while none is running. Available since 2026-11-21. */
  active: ActiveTimeout | null;
}

