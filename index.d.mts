  /** The team’s home ground. */
  venue: Venue | null;
  /** Set for doubles teams only (kind `pair`, as in padel or tennis doubles), listing the two people who form the pair; each is a competitor with a profile of their own. Null for every other kind of team. Available since 2026-11-25. */
  members: TeamRef[] | null;
  /** The complete name, when the source keeps one next to the short form used as `name`. Mostly single competitors written "Surname, Given name": table tennis ("Neborak, Dmytro" against "Neborak D.") and snooker. Null otherwise. Available since 2026-11-25. */
  fullName: string | null;
  /** Kit colours in #rrggbb form. Null when the source has no real colours for the team (the source fills in a placeholder blue for every individual competitor and most minor teams). */
  colors: {
    primary: string | null;
    secondary: string | null;
    text: string | null;
  } | null;
  /** Whether the team is men’s, women’s or mixed; null if the source does not specify. */
  gender: TeamGender | null;
  /** True for a national team, false for a club; null if the source does not specify. */
  national: boolean | null;
  /** Distinguishes a team, a single competitor in an individual sport and a doubles pair; null if the source does not specify. */
  kind: TeamKind | null;
  /** Current manager or head coach, if the source names one. */
