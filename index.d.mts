  create(params: ExportsCreateParams, options?: RequestOptions): Promise<ExportsCreateResponse>;
  /**
   * Exports. `GET /v2/exports` (business, enterprise).
   * @see https://datasportsapi.com/docs/exports/list/
   */
  list(options?: RequestOptions): Promise<ExportsListResponse>;
  /**
   * Export status. `GET /v2/exports/{id}` (business, enterprise).
   * @see https://datasportsapi.com/docs/exports/get/
   */
  get(id: number | string, options?: RequestOptions): Promise<ExportsGetResponse>;
}

/* ------------------------------------------------------------------- stream */

/** Every frame the server sends, by its type. */
export interface WsFrameMap {
  welcome: WsWelcome;
  snapshot: WsSnapshot;
  delta: WsDelta;
  fixture: WsFixture;
  subscribed: WsSubscribed;
  events: WsEvents;
  statistics: WsStatistics;
  lineups: WsLineups;
  playByPlay: WsPlayByPlay;
  momentum: WsMomentum;
  shotmap: WsShotmap;
  race: WsRace;
  raceSessions: WsRaceSessions;
  raceResults: WsRaceResults;
  odds: WsOdds;
  ball: WsBall;
  trackedEvent: WsTrackedEvent;
  timelineEvent: WsTimelineEvent;
  trackingStatus: WsTrackingStatus;
  unsubscribed: WsUnsubscribed;
  pong: WsPong;
  error: WsError;
}
export type WsServerFrame = WsFrameMap[keyof WsFrameMap];

export interface StreamOptions {
  /** A WebSocket constructor, for runtimes without a global one. */
  WebSocket?: unknown;
}

/**
 * The live WebSocket stream (Business and up). It mints its own single-use tickets,
 * subscribes, reconnects (immediately on a server restart, with backoff otherwise),
 * replays or resyncs what it missed, and keeps a merged copy of every fixture on the
 * fixture-carrying channels.
 */
export declare class Stream {
  /** The welcome frame of each (re)connection. */
  on(event: "open", listener: (frame: WsWelcome) => void): this;
  /** Every frame, of any type. */
  on(event: "frame", listener: (frame: WsServerFrame) => void): this;
  /** An error frame from the server, or a fatal problem (then the stream ends). */
  on(event: "error", listener: (error: StreamError | DataSportsAPIError) => void): this;
  /** The socket closed and the stream will connect again after delay milliseconds. */
  on(event: "reconnect", listener: (info: { code: number; reason: string; delay: number }) => void): this;
  /** The stream has ended: close() was called, or a fatal error. */
  on(event: "close", listener: () => void): this;
  on<K extends "welcome" | "snapshot" | "delta" | "fixture" | "subscribed" | "events" | "statistics" | "lineups" | "playByPlay" | "momentum" | "shotmap" | "race" | "raceSessions" | "raceResults" | "odds" | "ball" | "trackedEvent" | "timelineEvent" | "trackingStatus" | "unsubscribed" | "pong">(event: K, listener: (frame: WsFrameMap[K]) => void): this;
  off(event: string, listener: (...args: any[]) => void): this;
  /** The stream's own copy of the fixtures on a channel, deltas applied (list order). */
  fixtures(channel: string): Fixture[];
  subscribe(channel: string): void;
  /** Leaves a channel and forgets its state. */
  unsubscribe(channel: string): void;
  close(): void;
  /** The channels the stream is on. */
  readonly channels: string[];
}

