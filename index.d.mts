   * Race sessions. `GET /v2/races/{id}/sessions` (every plan).
   * @see https://datasportsapi.com/docs/races/sessions/
   */
  sessions(id: number | string, options?: RequestOptions): Promise<RacesSessionsResponse>;
  /**
   * Race results. `GET /v2/races/{id}/results` (every plan).
   * @see https://datasportsapi.com/docs/races/results/
   */
  results(id: number | string, params?: RacesResultsParams, options?: RequestOptions): Promise<RacesResultsResponse>;
  /**
