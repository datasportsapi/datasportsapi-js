  /** For an individual competitor: the team they compete for today, such as a cyclist’s trade team or a racing driver’s constructor (which motorsport.constructor also gives). Teams themselves, and competitors with no team, read null. Available since 2026-11-24. */
  currentTeam: TeamRef | null;
