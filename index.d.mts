  /** Combat sports: how many weight divisions the organisation runs, if known. Available since 2026-11-23. */
  divisionCount: number | null;
  /** How many competitors the organisation has on its roster, if known (UFC: 600). Available since 2026-11-23. */
  competitorCount: number | null;
}

