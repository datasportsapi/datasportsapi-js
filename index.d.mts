  name: string;
  /** Slug for use in URLs. */
  slug: string | null;
  /** Abbreviated display name, if the source provides one. */
  shortName: string | null;
  /** Abbreviation of 1–4 characters as used on scoreboards (e.g. "ARS", "LA"); generated artificially for individual sports. */
  code: string | null;
  /** Team logo hosted on our CDN; null if the team has no image. */
  image: string | null;
}

/** Full profile of a team. */

export interface TeamDetail {
  /** The team’s DataSportsAPI id. */
  id: number;
  /** Name of the team. Individual sports (tennis, table tennis, darts, MMA, …) also model each competitor as a team — a single player, or a doubles pair. */
  name: string;
  /** Slug for use in URLs. */
  slug: string | null;
  /** Abbreviated display name, if the source provides one. */
  shortName: string | null;
  /** Abbreviation of 1–4 characters as used on scoreboards (e.g. "ARS", "LA"); generated artificially for individual sports. */
  code: string | null;
  /** Team logo hosted on our CDN; null if the team has no image. */
  image: string | null;
