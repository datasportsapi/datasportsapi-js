    kind: "dated" | "loan" | null;
    contractUntil: string | null;
  }[];
  /** Clients whose market value moved over the past 30 days, in the source’s order (rises, then falls). The source shows this or latestTransfers depending on the agency, so it can be []. Available since 2026-11-25. */
