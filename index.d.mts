  batter: PlayerRef | null;
  /** Current status of the batter’s innings. */
  state: BatterState;
  /** Manner of dismissal; only set when `state` is out. */
  dismissal: Dismissal | null;
  /** State as phrased by the source ("Not out", "LBW", "Did not bat", "Caught & Bowled"). For display only. */
  description: string | null;
  /** Bowler involved in the dismissal, who is credited with the wicket unless it was a run out. The source also names a bowler on a retired-hurt line. */
  bowler: PlayerRef | null;
  /** Fielder involved in the dismissal: whoever took the catch (the bowler for caught & bowled), the wicket-keeper for a stumping, or the fielder who effected a run out. */
  fielder: PlayerRef | null;
  /** Runs the batter made. */
  runs: number | null;
  /** Number of deliveries faced. */
  balls: number | null;
  /** Number of boundaries for four. */
  fours: number | null;
  /** Number of sixes struck. */
  sixes: number | null;
