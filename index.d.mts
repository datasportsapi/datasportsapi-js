  /** Outfield players’ creativity rating, 0–100. */
  creativity: number | null;
  /** Goalkeepers’ saves rating on a 0–100 scale; outfield players get null. */
  saves: number | null;
  /** Goalkeepers’ anticipation rating, 0–100. */
  anticipation: number | null;
  /** Goalkeepers’ ball-distribution rating, 0–100. */
  ballDistribution: number | null;
  /** Goalkeepers’ aerial-play rating, 0–100. */
