export interface FallOfWicket {
  /** Wicket number, counting from 1 for the first dismissal. */
  wicket: number;
  /** Team score at the moment the wicket went down. */
  runs: number | null;
  /** Point in the innings at which it went down, in cricket notation: 4.2 is the second ball of the fifth over, while the sixth ball of that over is written 5 (never 4.6). */
  overs: number | null;
