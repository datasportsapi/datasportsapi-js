}

/** Runs credited to the batting side that did not come off the bat. */

export interface Extras {
  /** Combined extras, computed as wides + noBalls + byes + legByes + penalties. */
  total: number | null;
  /** Extras from wides. */
  wides: number | null;
  /** Extras from no-balls. */
  noBalls: number | null;
  /** Extras from byes. */
  byes: number | null;
  /** Extras from leg byes. */
  legByes: number | null;
  /** Runs awarded as penalties. */
  penalties: number | null;
}

/** A single standings table within a season — the overall table, or a conference, division or group. */

export interface StandingsGroup {
  /** The table’s label, such as "Eastern Conference", "Group A" or "NHL". */
  name: string | null;
  /** Marks the table that /standings returns when none is requested. Each season has exactly one: the overall table if it exists, otherwise the largest one (for a group stage, the first group). */
  primary: boolean;
  /** `true` when the table includes all of the season’s teams (a league table); `false` for conference and division tables and for the individual groups of a group stage. */
  overall: boolean;
  /** How ties are broken, as described by our data source. */
  tieBreakRule: string | null;
  /** Remarks our data source attaches to the table, in its own words (a team withdrawing from the tournament, for example); an empty list when there are none. Available since 2026-11-20. */
  notes: string[];
  /** Unit behind this table’s scoresFor / scoresAgainst columns. Tables without score columns (cricket) return null. */
  scoreUnit: StandingsScoreUnit | null;
  rows: StandingsRow[];
}

/** A team’s line in a standings table. Any column that is irrelevant to the sport is null. */

export interface StandingsRow {
  /** Position in this table, from 1 to n. When our data source’s positions do not run 1..n, we number the rows ourselves: tables ranked by win share (NBA early in a season) are sorted by win share, then wins, then fewer losses; points tables whose positions skip or repeat a number keep the source’s row order, because its ties are settled by head-to-head results the rows do not show (since 2026-11-23). */
  position: number | null;
  /** The team this row describes. */
  team: TeamRef | null;
  /** Number of games played. */
  played: number | null;
  /** Total wins, including those in overtime. */
  wins: number | null;
  /** Drawn games — filled in American football, cricket, football, futsal, handball and rugby, and since 2026-11-23 in darts and snooker. Where a table has no draw column (baseball, basketball, esports, ice hockey, volleyball, water polo, …) the value is null, meaning the column does not exist — not that no draws have happened yet. Water polo leagues that award draws (Serie A1) fill it since 2026-11-25. */
  draws: number | null;
  /** Total losses, overtime and shoot-out defeats included, so wins + draws + losses = played. In tables where the source counts regulation losses only and keeps the overtime ones apart (the NHL seasons 2013/14 to 2020/21), we add the two together (fixed on 2026-11-23). */
  losses: number | null;
  /** Ice hockey only: overtime wins as tallied by our data source. Where shoot-outs are counted separately (the KHL, the NHL’s league table) this covers overtime alone; elsewhere it combines overtime and shoot-out wins. Null where no figure is listed. */
  overtimeWins: number | null;
  /** Ice hockey only. Across all NHL tables — league, conference, division, and the home / away tables we compute — it counts losses in overtime and in shoot-outs together, i.e. the NHL’s OTL column, each worth a point. Elsewhere it is the overtime-loss figure our data source reports (for the KHL, overtime losses only). */
  overtimeLosses: number | null;
  /** Ice hockey only: wins decided in regulation time, without overtime or a shoot-out, where the source’s table carries the figure (the NHL’s league table, though not its conference or division tables, as well as the KHL, SHL, AHL and the Champions Hockey League, …; also our computed home / away tables when the matches reproduce the source’s figures). Null elsewhere. Available since 2026-11-18. */
  regulationWins: number | null;
  /** Ice hockey only: defeats within regulation time, for tables in which the source gives the figure (the NHL’s L column; its OTL column is `overtimeLosses`), or gives them as its losses (the NHL seasons 2013/14 to 2020/21, since 2026-11-23). Null elsewhere. Available since 2026-11-18. */
  regulationLosses: number | null;
  /** Ice hockey only: shoot-out wins, where the source’s table counts them separately (the KHL; `overtimeWins` then covers overtime alone). Null elsewhere. Available since 2026-11-18. */
  shootoutWins: number | null;
  /** Ice hockey only: shoot-out losses, where the source’s table counts them separately (the KHL). Because `overtimeLosses` includes shoot-out defeats, subtract shootoutLosses from overtimeLosses to get the defeats in overtime proper. Null elsewhere. Available since 2026-11-18. */
  shootoutLosses: number | null;
  /** How much the team has scored — goals, points, runs, sets, … depending on the table’s `scoreUnit`. */
  scoresFor: number | null;
  /** How much the team has conceded, expressed in the table’s `scoreUnit`. */
  scoresAgainst: number | null;
  /** Difference between the two: scoresFor − scoresAgainst. */
  scoreDifference: number | null;
  /** Points in the table; null for tables ordered by win percentage (NBA). Cricket points are exact, fractional bonus points included (a first-class table can read 19.95; since 2026-11-23). */
  points: number | null;
  /** Basketball, baseball and American football: proportion of games won, from 0 to 1, calculated the league’s way (in the NFL a tie is worth half a win). Unit: ratio. */
  winPercentage: number | null;
  /** Volleyball: rally points the team has won over its matches, next to `scoresFor`, which counts sets. Null outside volleyball, or when the source omits it. Available since 2026-11-25. */
  secondaryScoresFor: number | null;
  /** Volleyball: rally points the team has given away; null in the same cases as secondaryScoresFor. Available since 2026-11-25. */
  secondaryScoresAgainst: number | null;
  /** Aussie rules: points scored divided by points conceded, to four decimals. It is the ladder's percentage column over 100 (1.2345 stands for 123.45 %), which separates teams level on points. Null in other sports and until the team has conceded. Unit: ratio. Available since 2026-11-25. */
  scoringRatio: number | null;
  /** Basketball and baseball: how many games the team trails the leader (the side with the best wins − losses), calculated as ((leader wins − wins) + (losses − leader losses)) / 2. Our data source shows 0 for every row of its EuroLeague tables; the computed NBA home / away tables work it out separately for each table. */
  gamesBehind: number | null;
  /** The team’s ongoing streak in this competition: +3 means three wins in a row, −2 two defeats in a row. Present when our data source’s table includes it (NBA, EuroLeague, Liga ACB, …); null for other tables and for home / away tables. */
  streak: number | null;
  /** Name of the zone (qualification or relegation) this row sits in — for example "Champions League", "Playoffs" or "Relegation". */
  zone: string | null;
  /** Remarks our data source attaches to this row, in its own words, such as a points deduction ordered by the federation; an empty list when there are none. Available since 2026-11-20. */
  notes: string[];
  /** Football only: the mean rating of the team’s players across the season, on the 0–10 scale; null in other sports. Available since 2026-11-20. */
  averageRating: number | null;
  /** Cricket only: matches that ended without a result (abandoned games, which most leagues score as a point each). In first-class (multi-day) tables the source counts drawn matches here too, not under draws. Null in other sports. Available since 2026-11-20. */
  noResults: number | null;
  /** Cricket only: net run rate, the usual tie-breaker: the runs a side scores per over less the runs it concedes per over. Null in other sports. Available since 2026-11-20. */
  netRunRate: number | null;
  /** Averages tables only, the kind that decides relegation on points per game across several seasons (the source's “Promedios”): the points-per-game figure the table is ranked by, to three decimals. Such a table is never the season's main one; it comes as an extra group, so call GET /v2/leagues/{id}/standings with group=all and pick it out by name. Null in all other tables. Available since 2026-11-27. */
  pointsPerGame: number | null;
  /** Averages tables: the current season's points that go into the average. Null in all other tables. Available since 2026-11-27. */
  pointsThisSeason: number | null;
  /** Averages tables: last season's points that go into the average; a club that played elsewhere that season scores 0 here, following the source. Null in all other tables. Available since 2026-11-27. */
  pointsPreviousSeason: number | null;
  /** Averages tables: the points from two seasons back that go into the average, with the same 0 and null rules as pointsPreviousSeason. Available since 2026-11-27. */
  pointsTwoSeasonsAgo: number | null;
  /** Up to five of the team’s latest results in the part of the competition this table covers (its group or stage, since 2026-11-23; the whole season where no single part covers the table), ordered oldest first so the newest comes last; a home / away table shows only home / away results. Null when our data source gives no form for this table — computed tables, rows stored earlier, or a read that failed. */
  form: FormResult[] | null;
}

/** Bracket view of a league season’s knockout phase: cup rounds, playoffs or a tennis draw. */

export interface CupTree {
  /** What the bracket is called — "CONMEBOL Libertadores 2026, Knockout stage" or "NBA 25/26, Playoffs", for instance. */
  name: string | null;
  /** `order` of the round currently being played, or the next one due. Null if our data source does not supply it, or once the bracket is complete (at that point the source points to a round beyond the final one). */
  currentRound: number | null;
  /** The bracket’s rounds, beginning with the first. */
  rounds: CupRound[];
}

/** A single round within a knockout bracket. */

export interface CupRound {
  /** Position of the round in the bracket, starting at 1 for the opening round. */
  order: number;
  /** Label our data source gives the round, such as "1/8", "Quarterfinals", "Round of 32" or "Conference finals". */
  name: string | null;
  /** Ties in this round, listed from the top of the bracket down. */
  blocks: CupBlock[];
}

/** A single tie in a knockout round — one match, a two-legged tie or a series. */

export interface CupBlock {
  /** Where the tie sits in its round, counting from the top as our data source lays out the bracket. Values rise but are not guaranteed to run 1..n: byes or late-entering teams leave gaps (UCL qualifiers 15, 16, 19, …). */
  order: number;
  /** The participant listed first (first-leg home side or higher seed); null if the slot is unfilled. */
  home: CupParticipant | null;
  /** The participant listed second; null if the slot is unfilled (a bye). */
  away: CupParticipant | null;
  /** `true` once the tie is settled — a participant has been marked as winner, or our data source reports it finished. */
  finished: boolean;
  /** `true` while any of the tie’s fixtures is live. */
  inProgress: boolean;
  /** Start time of the tie’s opening fixture, in UTC; null if it has not been scheduled. */
  startTime: string | null;
  /** Number of fixtures that make up the tie (2 for two legs, 7 for a best-of-7, or 1); 0 for a bye. */
  matchCount: number | null;
  /** Fixture ids for the tie (usable with /v2/fixtures/{id}), in the order our data source gives them. */
  fixtureIds: number[];
  /** Flag from our data source indicating the participant advances without playing a fixture. */
  automaticProgression: boolean;
  /** Venue of the tie when our data source provides one (for a one-off final, or the ground of the first leg). */
  venue: Venue | null;
}

/** One of the two sides in a knockout tie. */

export interface CupParticipant {
  /** The team or individual competitor. Null as long as the slot is only a placeholder (“winner of quarter-final 1”); check `fromBlock` in that case. */
  team: TeamRef | null;
  /** Seeding or entry label in our data source’s own spelling ("1", "Q" for qualifier, "WC" for wild card); null if there is none. */
  seed: string | null;
  /** `true` if this side won the tie and advanced. */
  winner: boolean;
  /** This side’s score in the tie as reported by our data source: aggregate goals across the legs in football, series games won in basketball and ice hockey, sets in a single tennis match. Null until the tie has been played. */
  score: number | null;
  /** Football only: goals this side scored in a penalty shoot-out, if the tie needed one; otherwise null. */
  penalties: number | null;
  /** The `order` value of the block, one round back (PREVIOUS round), that this participant advanced from. Null in the opening round, or when our data source provides no link and the team did not appear in the previous round (a new entrant). */
  fromBlock: number | null;
}

/** A single search match, ordered by our data source’s relevance ranking. Competitors in tennis and other individual sports come back as `team` results. Since 2026-10-24 managers, referees, racing series and races can match too; since 2026-11-04, fixtures and venues as well, plus a player’s `team`. Agencies (type agency, since 2026-11-23) come only from a type=agency search. */

export interface SearchResult {
  /** The kind of entity matched, which tells you which endpoint its id is for. */
  type: SearchType;
  /** Identifier of the matched entity. Which endpoint it works with depends on `type`: /v2/teams, /v2/players, /v2/leagues, /v2/managers, /v2/referees, /v2/series, /v2/races, /v2/fixtures, /v2/venues or /v2/agencies. */
  id: number;
  /** Name to show; for a fixture it is our data source’s "Home - Away" string. */
  name: string;
  slug: string | null;
  /** Slug of the sport; null for venues, as a venue does not belong to a single sport. */
  sport: string | null;
  /** Where the hit belongs, for team, player, manager, referee and agency hits: for a national team the nation itself, for a player his nationality (since 2026-11-23). League and series hits whose category is a country carry that country too (since 2026-11-25). Null for the remaining types, for categories that are regions, tours or games, and when nothing is given. */
  country: Country | null;
  /** League and series hits: what the competition is filed under, in LeagueRef.category terms, be it a nation ("Kazakhstan"), a wider area ("International"), a tour or a video game title. Other hit types give null. Available since 2026-11-25. */
  category: string | null;
  /** Filled for `team` hits (since 2026-11-04) and `league` hits (since 2026-11-25) with the same male / female / mixed value TeamDetail or LeagueDetail would give. Null for the other hit types and for a single athlete flagged mixed; a team that the source calls mixed by name, as in badminton team events, reads `mixed`. */
  gender: TeamGender | null;
  /** Team hits: true for a national team, false for a club. Null for every other type. Available since 2026-11-23. */
  national: boolean | null;
  /** Image on our CDN — a logo for teams and leagues, a photo for players, managers and referees. Series, races, fixtures and venues never have one; for other entities it is null when no image exists or it is still to be uploaded. */
  image: string | null;
  /** For player results, the club our data source currently lists them at (since 2026-11-04), and for manager results the team they manage (since 2026-11-24). Null for other types and for anyone without a team (free agents, retired). */
  team: TeamRef | null;
  /** Player hits: his position, in Player.position's terms; null for hits of another type or where the source has none. Available since 2026-11-23. */
  position: Position | null;
  /** Player hits: the source’s own position code ("F", "G", "SS"); null otherwise. Available since 2026-11-23. */
  positionCode: string | null;
  /** Player hits: true if the source has the player down as retired; null for hits of another type or where the source is silent. Available since 2026-11-23. */
  retired: boolean | null;
  /** Player hits: true if the source has the player down as deceased; null for hits of another type or where the source is silent. Available since 2026-11-24. */
  deceased: boolean | null;
  /** Populated only for `fixture` results (since 2026-11-04) with the key facts of the match; null otherwise. */
  fixture: SearchFixture | null;
  /** Populated only for `venue` results (since 2026-11-04) with the venue’s city, country and capacity; null otherwise. */
  venue: Venue | null;
  /** Present on hits of type `race`: the season’s year, the first day and the country of the race. Null on every other type. Available since 2026-11-20. */
  race: SearchRace | null;
}

/** The match summary carried by a `fixture` search result (since 2026-11-04). For status, score and everything else, call /v2/fixtures/{id}. */

export interface SearchFixture {
  /** The home side; null until it has been determined. */
  home: TeamRef | null;
  /** The away side; null until it has been determined. */
  away: TeamRef | null;
  /** Competition the match belongs to; null if our data source does not name one. */
  league: LeagueRef | null;
  /** Planned start time in UTC; null if our data source does not provide one. */
  startTime: string | null;
  /** Broad match state when the search ran (no more detailed state is available here); null if our data source gives none. */
  status: StatusType | null;
}

/** One leaderboard for a season. */

export interface TopPlayersCategory {
  /** Which leaderboard this is — for example football: goals, averageRating, expectedGoals; basketball: rebounds, points; ice hockey: savePercentage, points. It equals `statistic`, except for football’s `mostConceded` / `leastConceded`, which rank goalkeepers by goals conceded with the most / fewest first. */
  category: string;
  /** The `statistics` key this leaderboard is built on; each entry’s `value` holds it as a season total. The ordering is our data source’s: counting statistics are generally ranked PER APPEARANCE (value ÷ appearances, so 104 NBA points in 3 games sits above 115 in 4), while ratings and shares rank by the value itself. Treat list position, not `value`, as the rank. */
  statistic: string;
  players: TopPlayerEntry[];
}

/** A single player on a leaderboard. */

export interface TopPlayerEntry {
  player: PlayerRef | null;
  /** The player’s team. Baseball leaderboards fill it from our team record (since 2026-11-23) and leave it null for a player who turned out for several teams that season. */
  team: TeamRef | null;
  /** This player’s figure for the ranked statistic, i.e. `statistics[statistic]`. */
  value: number | null;
  /** Number of appearances. */
  appearances: number | null;
  /** `true` if the player has played enough minutes or games to qualify for the ranking. */
  playedEnough: boolean | null;
  /** All numeric statistics supplied with the ranked entry, under v2 keys that match the per-match key for the same measure (naming conventions for season figures: `…PerMatch` is the total divided by matches, `…Per90` is per 90 minutes, `average…` is a season mean, `…Percentage` runs 0–100, `<key>Against` holds the opponents’ figure, and units are spelled out in the key (`…Seconds`, `…Kmh`)). */
  statistics: Record<string, number>;
}

/** For one statistic, the highest individual match figures recorded in a league season (since 2026-11-09). */

export interface TopPerformancesCategory {
  /** Which per-match player statistic the list ranks. Keys match those in a lineup player’s `statistics` — for football rating, goals, assists, kilometersCovered, topSpeed, keyPass, …; for basketball points, rebounds, …; for ice hockey points, hits, …. */
  category: string;
  /** At most 10 entries, top performance first in our data source’s ranking — for turnovers, errors and misses that means the highest count, not the lowest. */
  performances: TopPerformance[];
}

/** A single player’s figure from a single match. */

export interface TopPerformance {
  player: PlayerRef | null;
  /** The fixture in which the figure was recorded. */
  fixture: Fixture;
  /** The figure itself, in whatever unit the category’s per-match statistic uses — e.g. rating 0–10, topSpeed in km/h, kilometersCovered in km. */
  value: number;
}

/** A single round of a league draft, as returned by GET /v2/leagues/{id}/draft. Available since 2026-11-09. */

export interface DraftRound {
  /** Picks in this round, sorted by overall pick number. */
  picks: DraftPick[];
  /** Clubs that hold no pick in this round because they traded or forfeited it. */
  teamsWithoutPick: TeamRef[];
}

/** A single selection in a draft (since 2026-11-09). */

export interface DraftPick {
  /** Pick number counted across the entire draft. */
  overallPick: number;
  /** Round in which the pick falls. */
  round: number;
  /** Pick number counted within its round. */
  pickInRound: number | null;
  /** Club that makes the selection. */
  team: TeamRef | null;
  /** For a traded pick, the club that originally owned it; null if it was not traded. */
  tradedFrom: TeamRef | null;
  /** The drafted player as a record available from /v2/players/{id}; null if our data source has no player entry for them. */
  player: PlayerRef | null;
  /** The drafted player as described in the draft listing; null while the pick is still to be made. */
  prospect: DraftProspect | null;
}

/** How the draft itself describes the selected player. */

export interface DraftProspect {
  /** Name of the prospect as printed in the draft. */
  name: string;
  /** Listed position, using our data source’s abbreviations: G, F, C, FC, … in basketball; QB, WR, OT, … in American football. */
  position: string | null;
  /** `true` if they were flagged as a top prospect ahead of the draft. */
  topProspect: boolean;
  /** The college or former club they come from, when our data source holds it as a team. */
  fromTeam: TeamRef | null;
  /** Name of that college or club as given in the draft — filled even when fromTeam is null. */
  fromTeamName: string | null;
}

/** One team leaderboard for a season. */

export interface TopTeamsCategory {
  /** Leaderboard identifier — in football, for example, averageRating, goalsScored or cleanSheets. */
  category: string;
  /** The `statistics` key this leaderboard is built on; each entry’s `value` holds it as a season total. The ordering is our data source’s: counting statistics are generally ranked PER APPEARANCE (value ÷ appearances, so 104 NBA points in 3 games sits above 115 in 4), while ratings and shares rank by the value itself. Treat list position, not `value`, as the rank. */
  statistic: string;
  /** Teams on the leaderboard, top-ranked first. */
  teams: TopTeamEntry[];
}

/** A single team on a leaderboard. */

export interface TopTeamEntry {
  team: TeamRef | null;
  /** This team’s figure for the ranked statistic, i.e. `statistics[statistic]`. */
  value: number | null;
  /** Number of matches played. */
  matches: number | null;
  /** All numeric statistics supplied with the ranked entry, under v2 keys that match the per-match key for the same measure (naming conventions for season figures: `…PerMatch` is the total divided by matches, `…Per90` is per 90 minutes, `average…` is a season mean, `…Percentage` runs 0–100, `<key>Against` holds the opponents’ figure, and units are spelled out in the key (`…Seconds`, `…Kmh`)). */
  statistics: Record<string, number>;
}

/** Statistics for one team in a given league, season and type. */

export interface TeamSeasonStatistics {
  /** Totals and averages for the season under v2 keys, which match the per-match key for the same measure (naming conventions for season figures: `…PerMatch` is the total divided by matches, `…Per90` is per 90 minutes, `average…` is a season mean, `…Percentage` runs 0–100, `<key>Against` holds the opponents’ figure, and units are spelled out in the key (`…Seconds`, `…Kmh`)). Football examples: goalsScored, goalsConceded, matches, averageRating, totalShots, averageBallPossession, cleanSheets, …. Ratings are rounded to two decimal places. */
  statistics: Record<string, number>;
}

/** Key facts about a season: running totals and the teams new to it. */

export interface SeasonInfo {
  /** Totals for the season under our data source’s own names (football: goals, yellowCards, redCards, homeTeamWins, awayTeamWins, draws, numberOfCompetitors; in other sports numberOfCompetitors may be the only one). */
  statistics: Record<string, number>;
  /** Newcomers this season that came down from the division above. */
  newcomersUpperDivision: TeamRef[];
  /** Newcomers this season that came up from the division below. */
  newcomersLowerDivision: TeamRef[];
  /** Newcomers that arrived by any other route. */
  newcomersOther: TeamRef[];
  /** Host nations of a tournament held in particular countries, listed in our data source’s order — Canada, Mexico and USA for the 2026 World Cup, eleven of them for EURO 2020. League seasons usually leave it empty, though a few name their country (Germany for the Bundesliga; USA for MLS and the NFL). `code` is null when the name is missing from our data source’s country list. */
  hostCountries: Country[];
  /** The cities hosting the season, named and ordered as the source gives them; mostly tennis tournaments (an ATP Challenger in Playford reads ["Playford"]). [] when none are named, which is the case for most league seasons. Available since 2026-11-24. */
  hostCities: string[];
  /** Total prize pool of the season together with its currency (esports tournaments, for example 50,000 USD for DreamLeague Division 2); null when the source states none. Available since 2026-11-18; copies stored earlier show null until they are fetched again. */
  prizeMoney: Money | null;
  /** Esports only: the grade the source gives the tournament, as a lowercase letter ("s" is the top tier, followed by "a", "b", "c" …); null in other sports and for ungraded tournaments. Available since 2026-11-18. */
  tier: string | null;
}

/** A league in which the player has recorded statistics, together with the relevant seasons. */

export interface PlayerLeagueSeasons {
  /** League or competition reference — the same structure /v2/leagues/{id} and all league lists return. */
  league: LeagueRef;
  seasons: {
    id: number;
    name: string | null;
    year: string | null;
    startYear: number | null;
    endYear: number | null;
    types: SeasonStatsType[];
  }[];
  /** Where the source keeps one, the id of the league's all-time season. Use it as the `season` of /v2/players/{id}/statistics to read the player's career totals in this league; because those totals cover every season, a plan with a history window is refused with 403 history_not_in_plan. This id never appears in the league's own list of seasons. Null when the source has no all-time season. Available since 2026-11-27. */
  allTimeSeasonId: number | null;
}

/** Statistics for one player in a given league, season and type. */

export interface PlayerStatistics {
  team: TeamRef | null;
  /** Totals and averages for the season under v2 keys, which match the per-match key for the same measure (naming conventions for season figures: `…PerMatch` is the total divided by matches, `…Per90` is per 90 minutes, `average…` is a season mean, `…Percentage` runs 0–100, `<key>Against` holds the opponents’ figure, and units are spelled out in the key (`…Seconds`, `…Kmh`)). Football examples: appearances, minutesPlayed, goals, averageRating, expectedGoals, … — the complete football key list, with what each key measures, is under season statistic keys in this reference. Ratings are rounded to two decimal places. */
  statistics: Record<string, number>;
  /** Football: how the season rating breaks down across parts of the game; null if the source gives no breakdown (other sports, or seasons that have no ratings). Since 2026-11-11. */
  ratingBreakdown: RatingBreakdown | null;
}

/** Football only, since 2026-11-11: how each part of a player’s game pushed their season rating up or down, as the source works it out — expressed as rating points per match, positive when above a neutral contribution and negative when below (e.g. 0.13 for dribbling, −0.02 for passing). */

export interface RatingBreakdown {
  /** Contribution of shooting to the season rating; null when the source omits it (as for goalkeepers). */
  shotValue: number | null;
  /** Contribution of passing to the season rating. */
  passValue: number | null;
  /** Contribution of dribbling to the season rating. */
  dribbleValue: number | null;
  /** Contribution of defending to the season rating. */
  defensiveValue: number | null;
  /** Contribution of goalkeeping to the season rating; set for goalkeepers only, null for everyone else. */
  goalkeeperValue: number | null;
}

/** An entry in a player’s fixture list: a Fixture plus the player’s personal involvement (`playerMatch`). */

export interface PlayerFixture {
  /** The fixture’s id. */
  id: number;
  /** Slug of the sport, matching /v2/sports. */
  sport: string;
  /** Current state of the match. */
  status: Status;
  /** When the match starts: initially the planned time, swapped for the actual kick-off once our data source logs it (its live feed delivers this a few minutes after the start). Every endpoint and every WebSocket delta carries the same value. */
  startTime: string | null;
  /** When the match finished, as the source logged it; null until then and when it logged no time. A cricket Test or other multi-day match is in the date lists for every day from startTime to this. Fixtures saved before 2026-11-26 read null until they are fetched again. Available since 2026-11-26. */
  endTime: string | null;
  /** Competition the fixture belongs to. Null if our data source places the fixture in a competition without a matching league — seen on 2026-10-23 in minor regional football, e.g. South Africa’s National Second Division; in that case season and round are null as well. */
  league: LeagueRef | null;
  /** The season the source places the fixture in. When a league runs a competition of its own within its season, those games sit in that competition's season: NBA Cup group games belong to "NBA Cup 2026" with its group tables, and the conference and division tables stay with the regular season. /v2/leagues/{id}/seasons lists both. */
  season: Season | null;
  /** Round of the fixture, for competitions organised in rounds. */
  round: Round | null;
  /** In the US leagues (NFL, NBA, NHL), the home team’s season record as it stands for this game: the "9-4" (in the NHL the W-L-OTL "15-5-2") a broadcast prints beside the team’s name. Null in every other competition. Available since 2026-11-20. */
  homeRecord: SeasonRecord | null;
  /** The away team’s season record, on the same terms. Available since 2026-11-20. */
  awayRecord: SeasonRecord | null;
  /** Cricket’s official player of the match once it has been announced; null before that and in other sports (football’s fan vote is served by /best-players). Available since 2026-11-20. */
  playerOfTheMatch: PlayerRef | null;
  /** Competition levels our data source assigns to the fixture’s competition ("topCompetitions", "pro", "youth", …), so top-level, professional or youth fixtures can be filtered without keeping a list of leagues. An empty list when it assigns none. Available since 2026-11-20. */
  levels: FixtureLevel[];
  /** Tennis only: "lower" marks an event of the Challenger or ITF tier and null a tour-level one; always null in other sports. Available since 2026-11-20. */
  tier: "lower" | null;
  /** Name of the group when the match is part of a group stage ("Group A", as in the round robin of the ATP Finals), otherwise null. The group’s matches are listed by /v2/leagues/{id}/groups/{groupId}/fixtures. Available since 2026-11-20. */
  group: string | null;
  /** Where inside the season the source places the match, if that is somewhere below the league: a qualifier ("UK Championship Qualifiers 2026"), a stage like the playoffs ("NWSL, Playoffs") or a fight card. For a one-off tournament that has no league (league null) it carries the tournament’s name (since 2026-11-24). Null when the match sits straight under its league. It is text to show, not a key to match on; fixtures stored before it existed read null until they are fetched again. Available since 2026-11-23. */
  stage: string | null;
  /** The home side; null until it is known (our data source shows a placeholder such as "WQF1", the winner of quarter-final 1). */
  home: TeamRef | null;
  /** The away side; null until it is known (our data source shows a placeholder such as "WQF1"). */
  away: TeamRef | null;
  /** Doubles in tennis, padel, badminton and table tennis: the two players who make up the home pair, ordered as the source gives them. Each of them is a competitor in their own right (a TeamRef of kind individual, at /v2/teams/{id}, with the id their singles matches and rankings use). Null for a single competitor or a team, for a side still to be decided, and when the source’s answer leaves the players out (some lists, and fixtures stored before 2026-11-23 that have not been read since). Available since 2026-11-23. */
  homeMembers: TeamRef[] | null;
  /** The two players of the away pair, on the same terms as homeMembers. Available since 2026-11-23. */
  awayMembers: TeamRef[] | null;
  /** The home side’s score. */
  homeScore: ScoreSide;
  /** The away side’s score. */
  awayScore: ScoreSide;
  /** Remains null until status.type is finished, and stays null for a fight declared a no contest (`fightResult.method` noContest). If a match was settled on penalties, this is always the shoot-out winner, regardless of our data source (which, on a second leg, names whoever won the 90 minutes). When the source omits a winner, or reports a draw in a sport where draws are impossible, we derive it from the score (matches ending in regular time or overtime; cricket excluded). */
  winner: Winner | null;
  /** Where the match is played, if known (lower tiers often have none). Populated on /fixtures/{id} and, when our data source provides it, in date lists. Round, team, player and live lists never include a venue, so null there means "not included" rather than "unknown"; fetch /fixtures/{id} to get it. */
  venue: Venue | null;
  /** Running match clock; null if our data source has no clock for the fixture, and after the match ends. */
  clock: Clock | null;
  /** Deprecated since 2026-10-23 — mirrors `serving`. Because our data source refreshes it every game / leg, it reflects the side serving (throwing) at present, not the one that served first; use `serving` instead. */
  firstToServe: Side | null;
  /** Tennis, darts and other sports with a serve: which side is serving (throwing) at the moment, refreshed by our data source each game / leg. Null if the source does not report it. */
  serving: Side | null;
  /** Darts: which side threw first in the match (`serving` tells you who is throwing at present). Set when play starts and unchanged afterwards; null before the start, when the source is silent, and for every sport other than darts. Since 2026-11-11. */
  servedFirst: Side | null;
  /** In seeded events — tennis draws, or playoff seeding in basketball and other sports — the seed of the home side ("1", "12") or the way it entered ("Q" qualifier, "WC" wild card, "LL" lucky loser, "PR" protected ranking, …) as printed on the draw. Unseeded sides get null. */
  homeSeed: string | null;
  /** Seed or entry status of the away side, following the same rules as homeSeed. */
  awaySeed: string | null;
  /** Ranking of the home side as the source attaches it to the fixture. On UFC bouts: the fighter’s position in the division’s rankings when the bout took place, with 0 for the champion. Tennis players (since 2026-11-23): their ATP or WTA singles position, the one shown in the `atp` / `wta` lists of /v2/rankings rather than the live lists, taken from the source’s most recent reply about the match; doubles pairs and unranked players get null. Other sports (since 2026-11-23): the side’s own standing where the source keeps one, such as the world ranking of a rugby team. Since 2026-11-23 lists carry it as well, with the side’s own ranking; the UFC position at fight time comes only with /fixtures/{id}. MMA (since 2026-11-25): once a bout is over, lists show null here, because all a list knows is today's rank (homeCurrentRanking); the rank on fight night stays on /v2/fixtures/{id}. Null when no ranking is attached, as for most fixtures. Available since 2026-11-18. */
  homeRanking: number | null;
  /** Ranking of the away side; see homeRanking. Available since 2026-11-18. */
  awayRanking: number | null;
  /** MMA fixture lists only: where the home fighter sits in his division today, as of the list's latest refresh (0 is the champion). After the bout this can drift away from `homeRanking`, the rank he held on fight night. Null on /v2/fixtures/{id} (which keeps the fight-night rank), in other sports and for a fighter with no rank. Available since 2026-11-25. */
  homeCurrentRanking: number | null;
  /** Today's division rank of the away fighter; see homeCurrentRanking. Available since 2026-11-25. */
  awayCurrentRanking: number | null;
  /** Cricket only: our data source’s match note, which becomes the result line after the finish ("Pakistan beat Sri Lanka by 37 runs"). Intended for display only. */
  note: string | null;
  /** Cricket only: the side currently batting. Null when no innings is under way, and for all other sports. */
  battingSide: Side | null;
  /** MMA and boxing: how, in which round and at what time the fight ended. Null until status.type is finished, or when our data source gives no method. */
  fightResult: FightResult | null;
  /** Combat sports: the discipline of this bout when our data source tags one (the `mma` sport includes boxing, kickboxing and Muay Thai cards too). Only some cards get a tag — ONE, Queensbury and some OKTAGON fights, but never UFC or PFL — so null tells you nothing about whether the bout is MMA. */
  fightDiscipline: FightDiscipline | null;
  /** Named only if our data source has one (football and some other sports; in cricket, the match referee). You get it on /fixtures/{id}; list endpoints return null since it is not included there. */
  referee: Referee | null;
  /** Manager or head coach of the home side as named in the source’s fixture, which means whoever leads the team NOW. Up to and during the match that coincides with the person in charge of it; once a finished match is read after a change of manager, the successor appears instead. The managers of the match itself are on /v2/fixtures/{id}/managers. Present on /fixtures/{id}; null in lists. */
  homeManager: ManagerRef | null;
  /** Current manager or head coach of the away side; behaves like homeManager. */
  awayManager: ManagerRef | null;
  /** Court surface for tennis matches, returned on /fixtures/{id} and in live lists; other sports get null. */
  surface: Surface | null;
  /** Tennis: singles or doubles, or team for a tie between two nations made of several rubbers (since 2026-11-24; a client that only knows singles and doubles should treat an unknown value as neither). Present on every fixture endpoint, in lists and in WebSocket snapshots; null in other sports and when the source specifies neither. Since 2026-11-11. */
  discipline: MatchDiscipline | null;
  /** Cricket only: the toss result, once it has taken place. Populated on /fixtures/{id}; null for every other sport. */
  toss: CricketToss | null;
  /** Cricket only: the on-field umpires in our data source’s wording (frequently with a country code, e.g. "Asif Yaqoob (PAK)"); null if none are listed, and for every other sport. */
  umpires: string[] | null;
  /** Cricket only: the TV (third) umpire, handled the same way as umpires. */
  tvUmpire: string | null;
  /** For two-legged ties and playoff series: the fixture id of the tie’s preceding leg / game, if our data source links it. Look it up via /fixtures/{id} to get the first-leg score. */
  previousLegFixtureId: number | null;
  /** Tennis team competitions (Davis Cup, Billie Jean King Cup): on a singles or doubles rubber, the fixture id of the nations’ tie it is part of, and the tie itself has discipline team. The source makes the link late, often just before the rubber starts, so expect null until then. Null on every other match. Available since 2026-11-24. */
  parentFixtureId: number | null;
  /** For knockout ties and playoff series: the number of matches the tie is decided over, if the source states it — 1 for a one-off match, 2 for a two-legged football cup tie, 7 for a best-of-seven basketball series. Null on a league fixture, whenever the source is silent about it, and on any fixture stored before 2026-11-18 until it is fetched again. Related: previousLegFixtureId. Available since 2026-11-18. */
  matchesInTie: number | null;
  /** Set only once a two-legged tie’s return leg has finished: the team that progressed. We take our data source’s verdict; failing that, we use `aggregated` (the higher total goes through) or, when the aggregate is level, the shoot-out. Null in all other cases, including a level aggregate the source leaves unresolved (an away-goals rule). Compare `winner`, which is this match’s winner: after a second leg settled on penalties both point to the shoot-out winner, but otherwise they can disagree (a team can win the second leg yet be eliminated). Only /fixtures/{id} fills it; lists and live snapshots leave it out and may show null. */
  aggregateWinner: Side | null;
  /** MMA and boxing: the bout’s card section, position on the card and weight class, if our data source lists them. */
  fightCard: FightCard | null;
  /** Crowd size, if our data source reports one (observed for NBA and MLB games, often appearing only after the game has started). Populated on /fixtures/{id}; lists return null because it is not included. */
  attendance: number | null;
  /** Match format for darts and esports — best of N sets / legs / games — when our data source provides it. Other sports get null. */
  matchFormat: MatchFormat | null;
  /** Baseball only: the game situation right now — inning, half, balls, strikes, outs and runners on base. It is null while the game is not in progress or interrupted, and in every other sport. WebSocket deltas carry it live. */
  inningState: InningState | null;
  /** Basketball and, since 2026-11-23, American football: timeouts left for each side and the one being taken (`active`), filled only during an in-progress or interrupted game and only if our data source tracks them; null otherwise. WebSocket deltas carry live updates. */
  timeouts: Timeouts | null;
  /** American football only: down, distance and field position at this moment. It is null while the game is not in progress or interrupted, and in every other sport. Delivered live through WebSocket deltas. Available since 2026-11-09. */
  downAndDistance: DownAndDistance | null;
  /** Football only: an ongoing VAR review; null when there is none, outside play, and for every other sport. Delivered live through WebSocket deltas. Available since 2026-11-09. */
  varCheck: VarCheck | null;
  /** Basketball only: the side or sides in the bonus. It is null while the game is not in progress or interrupted, and when our data source gives no value; the source’s live feed lacks it, so you only get it over REST and in lists. Available since 2026-11-09. */
  bonus: BasketballBonus | null;
  /** `true` if our data source covers only the final result of this fixture, with no live score, clock or events during play (since 2026-11-09). */
  finalResultOnly: boolean;
  /** true for a match the source shows as running although it has gone quiet: no change in 45 minutes, and kick-off longer ago than any match in that sport could take. Such a match is already missing from /v2/livescores and the WebSocket; the date, league, team and fixture endpoints still report the source's status, with this flag set, so treat it as finished rather than live. false otherwise. Available since 2026-11-23. */
  stale: boolean;
  /** `true` when the result was awarded rather than played — a forfeit, or a ruling by a disciplinary body or federation. The score is then the awarded one (usually 3–0, or whatever the score was when an abandoned match was allowed to stand), and `status` shows finished just as for a played match. `false` for a result decided on the field and for a fixture still to finish. Fixtures stored before 2026-11-18 carry null until they are fetched again (finished fixtures keep their stored copy). Available since 2026-11-18. */
  awarded: boolean | null;
  /** Sports played in sets or rounds: the length of every finished period (since 2026-11-04). Null for sports our data source does not time by period (football, basketball, …) and until the first period is over. Delivered live through WebSocket deltas. */
  durations: Durations | null;
  /** true where the source lists the visitors first ("Away @ Home": NFL, NBA, NCAA, NHL, AHL and some baseball leagues), false where home leads. Null on fixtures saved before 2026-11-26 until they are fetched again. Available since 2026-11-26. */
  awayFirst: boolean | null;
  /** Running-clock sports such as football: the announced stoppage minutes per period, keyed like ScoreSide.periods (period1, period2, extra1, extra2), kept after each period ends (clock.injuryTimeMinutes covers only the period in play). Null when none was announced, and on fixtures saved before 2026-11-26 until they are fetched again. Unit: minutes. Available since 2026-11-26. */
  addedTime: Record<string, number> | null;
  /** `true` once our data source has published lineups for the fixture, whether predicted or official (`confirmed` on /v2/fixtures/{id}/lineups tells you which); `false` if they were withdrawn. We set it the moment the source’s live feed announces lineups, or when a lineup we fetch contains players. Null means we have no information (no announcement observed, nothing fetched). WebSocket deltas carry it live — on fixture:{id} from before kick-off, and on the list channels once play starts. After the final whistle the flag keeps the value it had during play, in REST and in every list (until 2026-11-26 it turned null there). Available since 2026-11-04. */
  lineupsAvailable: boolean | null;
  /** `true` once official lineups have been released (`confirmed` on /v2/fixtures/{id}/lineups), set in the same way as lineupsAvailable; null means we have no information. Delivered live through WebSocket deltas. Available since 2026-11-04. */
  lineupsConfirmed: boolean | null;
  /** Knockout stages: how many ties the round holds, which is how the source codes it: 1 for a final, 2 for semi-finals, 4 for quarter-finals, 8 for the last 16, 16 for the last 32. Null in league play and wherever the source leaves the round uncoded. Available since 2026-11-27. */
  tiesInRound: number | null;
  /** true when the source holds expected-goals figures for this match, which then appear in /v2/fixtures/{id}/statistics and on the shot map; null when it gives no answer either way. Available since 2026-11-27. */
  xgAvailable: boolean | null;
  /** true when the source keeps a statistics line per player for this match, read through /v2/fixtures/{id}/lineups; null when it gives no answer either way. Available since 2026-11-27. */
  playerStatisticsAvailable: boolean | null;
  /** true when the source keeps a heatmap per player for this match; null when it gives no answer either way. Available since 2026-11-27. */
  playerHeatmapAvailable: boolean | null;
  /** Same as on Fixture: during a live cricket innings, the current batter by our player id. */
  currentBatterId: number | null;
  /** Same as on Fixture: during a live cricket innings, the current bowler by our player id. */
  currentBowlerId: number | null;
  /** The player’s own involvement in this fixture, or null when our data source has nothing listed. */
  playerMatch: PlayerMatch | null;
}

/** One player’s personal involvement in a single fixture. */

export interface PlayerMatch {
  /** Which side the player represented. */
  side: Side | null;
  /** `true` if the player was a named substitute who never came on. */
  onBench: boolean;
  /** Player’s match rating (for example 7.4), rounded to two decimal places; null if there is none — the player did not take part, was not rated, or the match has not been played yet. */
  rating: number | null;
  /** Statistics for this match as supplied with the player’s fixture list, using the same keys as lineup statistics (football: minutesPlayed; basketball: points, rebounds, assists, fieldGoalsMade, fieldGoalsAttempted, secondsPlayed, plusMinus …; ice hockey: goals, assists, shotsOnGoal, secondsPlayed …). All …Percentage values are on a 0–100 scale. An empty object when nothing is available. */
  statistics: Record<string, number>;
  /** Per-player tallies built from the match incidents, e.g. goals (penalties included), penaltyGoals (spot-kicks among those goals), assists, yellowCards, redCards …; an empty object if nothing applies. */
  incidents: Record<string, number>;
}

/** An entry in GET /v2/rankings describing one ranking table; use its `type` with GET /v2/rankings/{type}. */

export interface RankingTypeInfo {
  /** Identifier of an available ranking table; GET /v2/rankings lists them all with names. */
  type: RankingTypeSlug;
  /** Human-readable name, such as "ATP singles ranking". */
  name: string;
  /** Slug of the sport, matching /v2/sports. */
  sport: string;
  /** Whether the ranking is for men or women; null for rankings of countries. */
  gender: TeamGender | null;
  /** What each row of the ranking represents. */
  entry: RankingEntry;
}

/** A full ranking table, as returned by GET /v2/rankings/{type}. */

export interface Ranking {
  /** Identifier of an available ranking table; GET /v2/rankings lists them all with names. */
  type: RankingTypeSlug;
  /** Time of our data source’s most recent update to the table. */
  updatedAt: string | null;
  /** All rows, highest-ranked first. */
  rows: RankingRow[];
}

/** A single entry in a ranking table. */

export interface RankingRow {
  /** Rank, where 1 is the top spot. In MMA division rankings the champion leads the list with position 0. */
  position: number;
  /** Rank in the ranking’s previous edition (0 marks the MMA champion); null if our data source does not provide it. */
  previousPosition: number | null;
  /** Points in the ranking. UEFA uses coefficients and UTR the rating itself (e.g. 16.45); rankings with no points, such as MMA, give null. */
  points: number | null;
  /** Previous edition’s points; null if our data source does not include them. */
  previousPoints: number | null;
  /** Highest rank ever reached (tennis); null for other rankings. */
  bestPosition: number | null;
  /** Number of tournaments that count towards the total (ATP); null for other rankings. */
  tournamentsPlayed: number | null;
  /** Team-type object for whoever is ranked; tennis players and fighters are modelled as teams too. In a ranking of countries this is null. */
  team: TeamRef | null;
  /** For a country ranking (UEFA): that country’s top league; null for other rankings. */
  league: LeagueRef | null;
  /** Country of the team or competitor, or — for UEFA’s country ranking — the ranked country itself; null if unknown. */
  country: Country | null;
  /** MMA: the fighter’s most recent fight; null for other rankings. Available since 2026-11-20. */
  lastFixture: Fixture | null;
  /** Live tennis rankings only: the points total the player would hold after winning the next match; null in other rankings. Available since 2026-11-20. */
  pointsIfNextWin: number | null;
  /** Live tennis rankings only: the highest points total still within the player’s reach at the tournament in progress; null in other rankings. Available since 2026-11-20. */
  maxPoints: number | null;
  /** Date on which the career-high rank in `bestPosition` was first reached; null when our data source does not give it. Available since 2026-11-20. */
  bestPositionAt: string | null;
  /** The label the source shows on this row: the team or player name, or a country's name in rankings of national associations such as UEFA's, where `team` stays null. Null when the source shows none. Available since 2026-11-27. */
  rowName: string | null;
  /** The family of table the source puts this ranking in, in its own word: "team" for official team and player rankings, "livetennis" for the live tennis race, "utr" for the Universal Tennis Rating, and others. Null when the source does not classify it. Available since 2026-11-27. */
  rankingClass: string | null;
}

/** A bucket of leagues inside a sport, forming the top tier of the league directory. */

export interface Category {
  /** Category identifier. Use it as the `category` parameter of GET /v2/leagues, or of GET /v2/fixtures to list that category’s fixtures on a given day (since 2026-11-04). */
  id: number;
  /** Category label: a country such as "England", a region such as "International" or "World", a tour such as "ATP", or a game in esports. */
  name: string;
  /** Slug for use in URLs. */
  slug: string | null;
  /** Slug of the sport, matching /v2/sports. */
  sport: string | null;
  /** The country this category represents, if it is a country; null for regions, tours and games. Pass its `code` to GET /v2/leagues as `country`. */
  country: Country | null;
  /** Motorsport: whether the category’s series are raced in cars or on motorcycles. Null outside motorsport and for categories the source does not classify (International); rows stored before 2026-11-24 read null until they are refreshed. Available since 2026-11-24. */
  vehicle: RacingVehicle | null;
}

/** A single player’s row in the player-statistics explorer for a league season. */

export interface PlayerStatisticsRow {
  /** The player, in the reference shape used by every other object. */
  player: PlayerRef;
  /** Club the player represented in this league season — after a mid-season move, the most recent one. */
  team: TeamRef | null;
  /** Totals for the season in the requested statistics group, keyed with v2 season-statistic names (identical to /v2/players/{id}/statistics: averageRating, goals, expectedGoals, shotsOnGoal, cleanSheets, …; `…Percentage` runs 0–100). Keys our data source omits for a player are left out, and averageRating is missing for unrated players (for whom the source sends 0). */
  statistics: Record<string, number>;
}

/** A racing series, which plays the role of a league in race sports: a motorsport championship, or in cycling the complete men’s or women’s road calendar. Races sit inside its seasons, and /v2/series/{id}/standings ranks competitors across a season. */

export interface SeriesRef {
  /** The series’ id. */
  id: number;
  /** Name of the series, for example "Formula 1", "MotoGP" or "NASCAR Cup Series". Cycling is organised differently: our data source bundles each gender’s road races into a single series ("Cycling Men", "Cycling Women"). */
  name: string;
  /** Slug for use in URLs. */
  slug: string | null;
  /** Slug of the sport, matching /v2/sports. */
  sport: string | null;
  /** Whether the series is for men or women: cycling’s two road calendars read male and female; series open to everyone (Formula 1, MotoGP) read null. Present wherever a series appears: on a race, in /v2/series lists, race careers and race seasons. Available since 2026-11-24. */
  gender: TeamGender | null;
}

/** The track hosting a motorsport race. */

export interface Circuit {
  /** Name of the track ("Circuit of the Americas"). */
  name: string | null;
  /** City where the circuit is located. */
  city: string | null;
  /** Country where the circuit is located. */
  country: Country | null;
  /** Length of one lap, in metres. Unit: meters. */
  lengthMeters: number | null;
  /** URL of the circuit map on our CDN, drawn as light lines on a dark background; null if the source has none or it has not been uploaded yet. Available since 2026-11-20. */
  image: string | null;
}

/** Covers either a motorsport weekend (with practice, qualifying, sprint and race sessions) or a cycling event — a one-day race or a stage race. The sessions themselves come from /v2/races/{id}/sessions. */

export interface Race {
  /** The race’s id. */
  id: number;
  /** What the race is called, e.g. "USA GP", "Tour de France", "Gran Piemonte". */
  name: string;
  /** Slug for use in URLs. */
  slug: string | null;
  /** Slug of the sport, matching /v2/sports. */
  sport: string | null;
  /** Series that includes this race. */
  series: SeriesRef | null;
  /** Which season of the series the race falls in ("Formula 1 2026"); its id is what the /v2/series/{id}/… endpoints expect. */
  season: Season | null;
  /** Championship round number as assigned by our data source; cancelled races may leave gaps in the sequence. In a motorsport season where the source numbers no rounds (Formula E), we number the races by date and skip the called-off ones (since 2026-11-25). */
  round: number | null;
  /** State of the race: notstarted before its first session, inprogress, finished after all sessions are complete, canceled, or postponed. Races the source has yet to start now read notstarted (since 2026-11-24; previously null). */
  status: StatusType | null;
  /** First day of the race (UTC). Once we hold its sessions or stages it is the day the first one runs (cycling since 2026-11-24, motorsport since 2026-11-25, because the source often dates the event a day early); until then it is the source's date. Exact session times are on /v2/races/{id}/sessions. */
  startDate: string | null;
  /** Last day of the race (UTC), using the event’s own date; null if our data source gives none. */
  endDate: string | null;
  /** Country hosting the race. */
  country: Country | null;
  /** Track used (motorsport); null for cycling. */
  circuit: Circuit | null;
  /** How many laps the main race is scheduled for (motorsport), as stated for the event; null where only the race session carries it (NASCAR: RaceSession.laps). */
  laps: number | null;
  /** Main-race distance for motorsport, in metres, as stated for the event; null where only the race session carries it. Unit: meters. */
  distanceMeters: number | null;
  /** Cycling: the race category (e.g. "World Tour 1 Grand Tour"), as our data source labels it. */
  category: string | null;
  /** Who won — the main race in motorsport, the general classification in a cycling stage race — filled only after the finish. Drivers and riders are TeamRefs (kind individual), just as tennis players are. */
  winner: TeamRef | null;
}

/** The sessions of a race: in motorsport every practice, the qualifying and its parts, any sprint and the race itself; in cycling the stages of a stage race. */

export interface RaceSessions {
  /** All sessions ordered by start time, oldest first; empty if the source lists none. */
  sessions: RaceSession[];
}

/** Snapshot sent on the race:{id} channel: the race, its sessions and the results of the current session. */

export interface RaceSnapshot {
  /** Covers either a motorsport weekend (with practice, qualifying, sprint and race sessions) or a cycling event — a one-day race or a stage race. The sessions themselves come from /v2/races/{id}/sessions. */
  race: Race;
  /** The race’s sessions, as returned by /v2/races/{id}/sessions. Available since protocol 5. */
  sessions: RaceSession[];
  /** Which session the results belong to — the live one if any, otherwise the most recently finished; null until a session has run. */
  session: number | null;
  /** Classification for that session, as from /v2/races/{id}/results?session=; [] while none exists. */
  results: RaceResult[];
}

/** A race in a season listing; its sessions come from /v2/races/{id}/sessions. */

export interface RaceSummary {
  /** The race’s id. */
  id: number;
  /** What the race is called, e.g. "USA GP", "Tour de France", "Gran Piemonte". */
  name: string;
  /** Slug for use in URLs. */
  slug: string | null;
  /** Slug of the sport, matching /v2/sports. */
  sport: string | null;
  /** Series that includes this race. */
  series: SeriesRef | null;
  /** Which season of the series the race falls in ("Formula 1 2026"); its id is what the /v2/series/{id}/… endpoints expect. */
  season: Season | null;
  /** Championship round number as assigned by our data source; cancelled races may leave gaps in the sequence. In a motorsport season where the source numbers no rounds (Formula E), we number the races by date and skip the called-off ones (since 2026-11-25). */
  round: number | null;
  /** State of the race: notstarted before its first session, inprogress, finished after all sessions are complete, canceled, or postponed. */
  status: StatusType | null;
  /** First day of the race (UTC). Once we hold its sessions or stages it is the day the first one runs (cycling since 2026-11-24, motorsport since 2026-11-25, because the source often dates the event a day early); until then it is the source's date. Exact session times are on /v2/races/{id}/sessions. */
  startDate: string | null;
  /** Last day of the race (UTC), using the event’s own date; null if our data source gives none. */
  endDate: string | null;
  /** Country hosting the race. */
  country: Country | null;
  /** Track used (motorsport); null for cycling. */
  circuit: Circuit | null;
  /** How many laps the main race is scheduled for (motorsport), as stated for the event; null where only the race session carries it (NASCAR: RaceSession.laps). */
  laps: number | null;
  /** Main-race distance for motorsport, in metres, as stated for the event; null where only the race session carries it. Unit: meters. */
  distanceMeters: number | null;
  /** Cycling: the race category (e.g. "World Tour 1 Grand Tour"), as our data source labels it. */
  category: string | null;
  /** Who won — the main race in motorsport, the general classification in a cycling stage race — filled only after the finish. Drivers and riders are TeamRefs (kind individual), just as tennis players are. */
  winner: TeamRef | null;
}

/** A timed segment of a race. In motorsport that is a practice, qualifying, sprint or the race itself; in cycling it is a stage of a stage race (a one-day race consists of a single session, the race). */

export interface RaceSession {
  /** Identifier of the session, accepted by /v2/races/{id}/results?session=. */
  id: number;
  /** Name of the session as provided by our data source ("Practice 1", "Qualification", "Grand Prix", "Stage 5"). */
  name: string;
  /** Kind of session. */
  type: RaceSessionType;
  /** State of the session, using the fixture status types; null if our data source gives none. When the source delays a session’s start, the session stays notstarted and is tracked from its actual start (since 2026-11-22). */
  status: StatusType | null;
  /** Planned start time in UTC. */
  startTime: string | null;
  /** Planned lap count (motorsport races). */
  laps: number | null;
  /** Laps actually completed; fewer than `laps` if the race was shortened. */
  lapsCompleted: number | null;
  /** How far the session covers in metres — for cycling, the stage length. Unit: meters. */
  distanceMeters: number | null;
  /** Town the stage departs from (cycling). */
  departureCity: string | null;
  /** Town where the stage finishes (cycling). */
  arrivalCity: string | null;
  /** Stage terrain profile (cycling). */
  profile: StageProfile | null;
  /** Weather conditions, available after the session has run. */
  weather: RaceWeather | null;
  /** Whether the track was dry or wet. */
  trackCondition: TrackCondition | null;
  /** Measured air temperature, in degrees Celsius. Unit: celsius. */
  airTemperatureC: number | null;
  /** Measured track-surface temperature in degrees Celsius (motorsport). Unit: celsius. */
  trackTemperatureC: number | null;
  /** Humidity as a relative percentage (0–100). Unit: percent. */
  humidityPercent: number | null;
  /** `true` if the safety car was deployed; null if this was not reported. */
  safetyCar: boolean | null;
  /** Winner of the session (the quickest in practice / qualifying), set only after the session ends. */
  winner: TeamRef | null;
  /** The box score of a NASCAR race (lead changes, cautions, average speed and duration). Every other session and series has null here. Available since 2026-11-20. */
  stats: RaceSessionStats | null;
  /** The segments of the session in run order: the rounds of a knock-out qualifying (Q1, Q2…) or the single part of a Formula 1 practice ("Part 1"), whose table holds the live timing (request /v2/races/{id}/results?session={part id}). An empty list means our data source keeps no parts for the session. */
  parts: RaceSessionPart[];
}

/** One segment of a session, listed in run order: a round of a knock-out qualifying (Q1–Q3 in Formula 1, Q1 / Q2 in MotoGP), or the one part of a Formula 1 practice — while the practice runs, its live timing sits in that part’s table, while the practice’s own table is just the entry list. */

export interface RaceSessionPart {
  /** Id of the segment; use it as session= on /v2/races/{id}/results to fetch only that segment’s results. */
  id: number;
  /** Label numbered by run order: "Q1", "Q2", "Q3" in qualifying, "SQ1"… in sprint qualifying, "Part 1"… in every other kind of session (a single one for a Formula 1 practice). */
  name: string;
  /** State of the segment; null when our data source gives none (Formula 1 segments). */
  status: StatusType | null;
  /** Planned start time in UTC; null if our data source gives none. */
  startTime: string | null;
  /** Which elimination stage of a knock-out session this part is, numbered by the source: 1, 2 and 3 for Q1–Q3 in Formula 1 qualifying and SQ1–SQ3 in sprint qualifying. Null for parts without a number, such as practice. Available since 2026-11-27. */
  round: number | null;
}

/** A single competitor’s entry in the classification of a session or race. */

export interface RaceResult {
  /** Finishing position; null for a competitor who is not classified (check `state`). In qualifying, a driver knocked out in an early part gets the place of that part (since 2026-11-24). */
  position: number | null;
  /** Who raced: a driver or rider, represented as a TeamRef with kind individual. */
  competitor: TeamRef | null;
  /** Constructor or cycling team the competitor belongs to. */
  team: TeamRef | null;
  /** Whether the competitor is classified, and if not, the reason. */
  state: RaceResultState;
  /** Reason for being out, in our data source’s wording ("Retired", "Not Finished 1st Lap"), including a retirement the source words only in its remark; null for classified competitors. In a series that keeps ranking cars that are out (NASCAR) the source’s reason is filled too: Engine, Electrical, Accident (since 2026-11-24). */
  outReason: string | null;
  /** The note the source prints next to this line, word for word: a penalty ("Penalized 5 seconds" in F1), whether the car was still running or why it stopped (IndyCar’s "Running" or "Contact"; IndyCar ranks its retirements by laps completed, so `state` stays classified), or a retirement ("Retired"). Null when there is no note. Available since 2026-11-19. */
  remark: string | null;
  /** Race number on the car or bike (motorsport). Always null on the rows of a session part, which the source leaves unnumbered: find the number by looking the competitor up in the parent session’s table. */
  carNumber: number | null;
  /** Grid slot as declared for the start (races); null for a pit-lane start or when unknown. The order the cars actually started in is `startPosition`. */
  gridPosition: number | null;
  /** Where the car actually started once grid penalties were applied, numbered 1…n with no gaps: pit-lane starters and cars that never took the start come at the end. At the 2026 Las Vegas Grand Prix, for example, a car slotted 17th on the grid lined up 15th because two cars ahead of it did not take their grid slots. Null when the source gives none; lines stored before 2026-11-22 read null until their next refresh. Available since 2026-11-22. */
  startPosition: number | null;
  /** Set to `true` for a pit-lane start. */
  startedFromPitLane: boolean | null;
  /** Lap count according to our data source. */
  laps: number | null;
  /** How many laps down on the winner (for lapped cars); null if on the lead lap. */
  lapsBehind: number | null;
  /** Number of laps spent in the lead. */
  lapsLed: number | null;
  /** Number of pit stops made. */
  pitStops: number | null;
  /** Overall time in ms for a race or stage, or the best lap in practice and qualifying. Null for lapped and non-classified competitors, and for a classified rider without a time in our data source; in series that only publish gaps (Formula E, DTM, MotoGP before 2025) the winner alone has one. Since 2026-11-25 a value is treated as a total or as a gap by its own shape, wherever in the source's row it arrives. Unit: milliseconds. */
  timeMs: number | null;
  /** Gap to the winner. Null for the winner itself, for lapped or non-classified competitors, and for a classified rider with no time logged by our data source. Unit: milliseconds. */
  gapMs: number | null;
  /** Gap to the competitor immediately in front; null for the winner, for lapped and non-classified competitors, and for a classified rider without a time in our data source. Unit: milliseconds. */
  intervalMs: number | null;
  /** Quickest lap this competitor set, in ms (races). Unit: milliseconds. */
  bestLapMs: number | null;
  /** Number of the lap on which that best time came. */
  bestLapNumber: number | null;
  /** `true` for the competitor who set the single fastest lap of the session. Null where the source counts fastest laps lap by lap instead (NASCAR; read `fastestLaps`) and where it keeps no fastest lap at all. Up to 2026-11-19 the flag was true on a NASCAR row whenever its driver had been quickest on any lap at all. */
  fastestLap: boolean | null;
  /** NASCAR: how many laps the driver was fastest on (41 for the winner of a 267-lap race, for example). Null for series that flag a single fastest lap of the session (`fastestLap`). Available since 2026-11-19. */
  fastestLaps: number | null;
  /** Championship points earned from this result. */
  points: number | null;
  /** NASCAR: the part of `points` that came from stages and bonuses, as the source lists it; null in other series. Available since 2026-11-19. */
  bonusPoints: number | null;
  /** Sequence of tyre stints (Formula 1 races only; empty elsewhere). */
  tyreStints: TyreStint[];
  /** The set of tyres currently fitted (Formula 1 sessions while running, then the final set once over); null if our data source does not report it. Available since 2026-11-09. */
  currentTyre: CurrentTyre | null;
  /** Whether the car is currently in the pit lane during a live session (`true`); null if our data source does not report it, and on every row once the session has finished. Available since 2026-11-09. */
  inPit: boolean | null;
  /** Secondary classifications, present on the overall result of a cycling stage race; null elsewhere. */
  cycling: CyclingStanding | null;
  /** Time of the source’s latest update to this line (ISO 8601, to the second). This is the line’s own timestamp, not the moment we fetched it; null when the source supplies none. Available since 2026-11-19. */
  updatedAt: string | null;
  /** Deprecated: always null since 2026-11-19, as no classification is pieced together from qualifying segments any more — fetch a segment on its own with session={part id}. The field stays so that the object and the WebSocket frames keep the same shape. */
  part: string | null;
}

/** A run on a single set of tyres. */

export interface TyreStint {
  /** Tyre compound used. */
  compound: TyreCompound;
  /** Number of laps completed on this set. */
  laps: number | null;
}

/** Secondary-classification standings for one rider within a stage race’s overall result. */

export interface CyclingStanding {
  /** Leader’s jersey worn by this rider, if there is one. */
  jersey: CyclingJersey | null;
  /** Where the rider sits in the points classification. */
  pointsPosition: number | null;
  /** Points tallied in the points classification. */
  points: number | null;
  /** Where the rider sits in the mountains classification. */
  mountainsPosition: number | null;
  /** Points tallied in the mountains classification. */
  mountainsPoints: number | null;
  /** Where the rider sits in the young-rider classification. */
  youngRiderPosition: number | null;
  /** Time on which the young-rider classification is based (total, in ms). Unit: milliseconds. */
  youngRiderTimeMs: number | null;
}

/** A single entry in a series championship table. */

export interface SeriesStandingsRow {
  /** Position in the championship. */
  position: number | null;
  /** The ranked entity — a driver or rider with `type=competitors`, a team with `type=teams`. */
  competitor: TeamRef | null;
  /** For drivers and riders, the team they race for; null in the teams table. */
  team: TeamRef | null;
  /** Points in the championship. */
  points: number | null;
  /** Number of races won. */
  wins: number | null;
  /** Number of podium finishes. */
  podiums: number | null;
  /** Number of pole positions. */
  polePositions: number | null;
  /** Number of fastest laps. */
  fastestLaps: number | null;
  /** Number of races started. */
  racesStarted: number | null;
  /** Number of races finished in the points. */
  racesWithPoints: number | null;
  /** Formula 1 only: the constructor’s chassis ("MCL40A"), meaning the row’s team in the teams table and the driver’s constructor in the drivers table; null in other series. Available since 2026-11-20. */
  chassis: string | null;
  /** Formula 1 only: the power unit, e.g. "Mercedes-AMG F1 M17". Available since 2026-11-20. */
  engine: string | null;
}

/** Our data source’s play-by-play text, with an entry for each action (football, basketball, …). The source’s data provider writes it, not DataSportsAPI. */

export interface PlayByPlay {
  /** Entries in chronological order, oldest first, as in every timeline list. */
  entries: PlayByPlayEntry[];
  /** American football: every drive of the game, numbered from 1 in the order played; an empty list in other sports. Available since 2026-11-25. */
  drives: PlayByPlayDrive[];
}

/** A single play-by-play line from our data source’s text commentary. */

export interface PlayByPlayEntry {
  /** The kind of action the entry describes. */
  type: PlayByPlayType;
  /** Side that `player` belongs to (or the team the entry concerns); null for entries about the match as a whole (kick-off, period ends, delays). Football corners (cornerKick) name the player who gave the corner away, so side is the conceding team; the team taking the kick is the other one, as text says. */
  side: Side | null;
  /** Period in which the action took place, with overtime split by overtime period (overtime1, overtime2, …); null when our data source gives none (football’s final whistle). */
  period: PeriodKey | null;
  /** Football: the match minute, with added time held separately (45+6 → minute 45, addedMinute 6). Null for clock sports (basketball uses `periodSecond`) and when our data source gives no time. Unit: minutes. */
  minute: number | null;
  /** Added-time minutes in football (45+6 → 6); other cases give null. Unit: minutes. */
  addedMinute: number | null;
  /** Basketball and other clock sports: elapsed seconds in the current period. Football gives null. Unit: seconds. */
  periodSecond: number | null;
  /** Basketball and other clock sports: the game clock, counting down the seconds left in the period. Football gives null. Unit: seconds. */
  periodSecondsLeft: number | null;
  /** UTC time the action was logged, where our data source timestamps it (basketball); null elsewhere. */
  at: string | null;
  /** The English commentary text, verbatim from our data source. */
  text: string;
  /** The player the line concerns — the shooter, scorer, booked or fouling player, rebounder, and so on. For an ice hockey suspension this is the player who was penalised (from 2026-11-18; earlier it held the player the offence was committed on, who now sits in `drawnBy`). */
  player: PlayerRef | null;
  /** Player credited with the assist, if our data source names one (basketball baskets). */
  assist: PlayerRef | null;
  /** substitution: the incoming player. */
  playerIn: PlayerRef | null;
  /** substitution: the outgoing player. */
  playerOut: PlayerRef | null;
  /** foul (basketball): the player who was fouled; suspension (ice hockey): whoever drew the penalty. */
  drawnBy: PlayerRef | null;
  /** suspension (ice hockey): the player who sat out the penalty in the box when that was not the penalised player (`player`); null otherwise. Available since 2026-11-18. */
  servedBy: PlayerRef | null;
  /** suspension (ice hockey): the offence under the camelCase keys Incident.infraction uses ("tripping", "crossChecking", …); null for every other entry. Available since 2026-11-18. */
  infraction: string | null;
  /** suspension (ice hockey): the class of penalty; null otherwise. Available since 2026-11-18. */
  severity: PenaltySeverity | null;
  /** possessionChange (basketball): who made the steal. */
  stolenBy: PlayerRef | null;
  /** hit (ice hockey): the player on the receiving end of the check, while `player` is the one who delivered it; null on every other entry. Available since 2026-11-23. */
  targetPlayer: PlayerRef | null;
  /** shotBlocked: the opponent who got in the way of the shot (`player` is the shooter), when the source names one, which so far means ice hockey; null otherwise. Available since 2026-11-23. */
  blockedBy: PlayerRef | null;
  /** Ice hockey: how the entry's side stood in skaters at that moment (`even`, `powerplay` or `shorthanded`); null in every other sport and when the source leaves it out. Available since 2026-11-23. */
  strength: PlayStrength | null;
  /** Goalkeeper our data source links to a shot (football). The source also fills it on a handful of basketball shots; what it means there has not been verified. */
  goalkeeper: PlayerRef | null;
  /** scoreChange / penaltyScored: the home side’s score once the action is counted; null on all other entries. */
  homeScore: number | null;
  /** scoreChange / penaltyScored: the away side’s score once the action is counted; null on all other entries. */
  awayScore: number | null;
  /** scoreChange: in basketball, how many points the basket counted for; in ice hockey, whether the puck went past a goalkeeper (`goal`) or into an empty net (`emptyNetGoal`). Null in football and on every other entry. */
  scoreType: PlayByPlayScoreType | null;
  /** Basketball only: court location of the action, or null if our data source has none. */
  position: CourtPosition | null;
  /** Basketball: the area of the court. Ice hockey: `offensive`, `neutral` or `defensive`, from the point of view of the entry's side. Null when our data source provides none. */
  zone: CourtZone | null;
  /** American football: the `number` of the drive this play is part of (see PlayByPlayDrive); null outside a drive and in other sports. Available since 2026-11-25. */
  drive: number | null;
  /** American football: the side in possession for the play; on a kickoff or a punt, the side doing the kicking. Available since 2026-11-25. */
  possession: Side | null;
  /** American football: which down it is, 1 to 4; null on kickoffs, conversion tries and entries that are not plays. Available since 2026-11-25. */
  down: number | null;
  /** American football: the distance still needed for a new set of downs. Unit: yards. Available since 2026-11-25. */
  yardsToGo: number | null;
  /** American football: true when only a score earns the next first down (first and goal); null whenever `down` is null. Available since 2026-11-25. */
  goalToGo: boolean | null;
  /** American football: the spot the play started from. Available since 2026-11-25. */
  ballOn: BallOn | null;
  /** American football: `run` or `pass`, when the source tells. Available since 2026-11-25. */
  playType: PlayKind | null;
  /** American football: the yardage of the play when the source records it, below zero for a loss. Unit: yards. Available since 2026-11-25. */
  yardsGained: number | null;
}

/** American football: a single possession, from the play that opened it to the one that closed it (/v2/fixtures/{id}/drives, and `drives` on PlayByPlay). Available since 2026-11-25. */

export interface PlayByPlayDrive {
  /** Order of the drive in the game, starting at 1; a play-by-play entry refers to it through `drive`. */
  number: number;
  /** The offence on this drive; null when the source’s plays do not say. */
  side: Side | null;
  /** Order of the drive among that side’s drives only, starting at 1. */
  teamDriveNumber: number | null;
  /** Period of the drive’s first play. */
  period: PeriodKey | null;
  /** Seconds remaining in `period` at the drive’s first play. Unit: seconds. */
  startSecondsLeft: number | null;
  /** Period of the drive’s last play, which can differ from `period` when a quarter ends mid-drive. */
  endPeriod: PeriodKey | null;
  /** Seconds remaining in `endPeriod` at the drive’s last play. Unit: seconds. */
  endSecondsLeft: number | null;
  /** How much game clock the drive used. Unit: seconds. */
  durationSeconds: number | null;
  /** What gave the side the ball: kickoff, punt, interception and so on. */
  startReason: DriveReason | null;
  /** What ended the drive: touchdown, punt, turnover on downs and so on; null for a drive not yet over. */
  endReason: DriveReason | null;
  /** Number of plays in the drive, by the source’s count. */
  plays: number | null;
  /** New sets of downs earned on the drive. */
  firstDowns: number | null;
  /** Yards gained overall, below zero when the offence lost ground. Unit: yards. */
  netYards: number | null;
  /** Yardage that came from penalties during the drive. Unit: yards. */
  penaltyYards: number | null;
  /** Starting spot, as the distance to the end zone being attacked (from its own 35 → 65). Unit: yards. */
  startYardsToGoal: number | null;
  /** Spot of the final play, measured the same way. Unit: yards. */
  lastPlayYardsToGoal: number | null;
  /** Shortest distance to that end zone the drive reached. Unit: yards. */
  closestYardsToGoal: number | null;
  /** true if the drive put points on the board. */
  scoring: boolean;
  /** Following a touchdown, what the try after it went for: 1 for a kick, 2 for a two-point attempt; 0 or null for other drives. */
  extraPointsAttempted: number | null;
}

/** Court location of a basketball action, expressed in our data source’s court units. */

export interface CourtPosition {
  /** Position on the horizontal axis, measured in our data source’s court units. */
  x: number;
  /** Position on the vertical axis, measured in our data source’s court units. */
  y: number;
}

/** American football: the spot of the ball at the snap, written the way a broadcast does ("KC 35" is side KC, yardLine 35). Available since 2026-11-25. */

export interface BallOn {
  /** The team in whose half the ball rests. */
  side: Side;
  /** Distance from that side’s own goal line, 0 to 50, where 50 is midfield. Unit: yards. */
  yardLine: number;
}

/** Full league profile from /v2/leagues/{id}: everything in LeagueRef, plus the league’s level, current champion, record title-holders and the divisions directly above and below. Host countries are given per season (/v2/leagues/{id}/seasons/{seasonId}). */

export interface LeagueDetail {
  /** The league’s id. */
  id: number;
  /** Name of the league or competition. */
  name: string;
  /** Slug for use in URLs. */
  slug: string | null;
  /** Slug of the sport, matching /v2/sports. */
  sport: string | null;
  /** How our data source groups the league: by country ("England"), region ("International", "North America", "World"), tour ("ATP", "WTA") or game (esports: "Counter Strike"). It is not necessarily a country; use `country` for that. */
  category: string | null;
  /** Country of the league when its category is a country. Since 2026-11-25 a competition filed under a region can still carry its own home country where the source records one, as MMA promotions do (the UFC and PFL are American, ONE is based in Singapore). Otherwise null, as for the remaining regions, tours and games. */
  country: Country | null;
  /** CDN URL of the league logo; null if the league has none. */
  image: string | null;
  /** Our data source’s prominence score for the competition, handy for sorting leagues: a higher value means a bigger competition (for example 719 for the Champions League, 704 for the Premier League, 702 for LaLiga, 519 for Primeira Liga), and 0 means unranked. It is filled only where the source supplies it: on the league embedded in a fixture and in the /v2/fixtures?date&sport day lists. Everywhere else — league profiles, directories, search — it is null, as it is on rows saved before 2026-11-04. Available since 2026-11-04. */
  priority: number | null;
  /** Tier within the national league pyramid: 1 for the top flight (Premier League), 2 for the second level (Championship); null for cups, international competitions and anything outside a pyramid. */
  tier: number | null;
  /** Whether the competition is for men or women; null if our data source does not specify. */
  gender: TeamGender | null;
  /** Current title holder — the winner of the most recent completed season — if our data source names one. */
  titleHolder: TeamRef | null;
  /** Total number of times the current title holder has won this competition. */
  titleHolderTitles: number | null;
  /** Highest number of titles any single team has won. */
  mostTitles: number | null;
  /** Team or teams holding that record (more than one if tied); [] if our data source names none. */
  mostTitlesTeams: TeamRef[];
  /** Leagues directly above — the destination of promoted teams; [] for a top flight or a cup. */
  upperDivisions: LeagueRef[];
  /** Leagues directly below — the destination of relegated teams; [] if none is listed. */
  lowerDivisions: LeagueRef[];
  /** Start date of the current (or next) season, in UTC. */
  currentSeasonStart: string | null;
  /** Planned end date of the current season, in UTC. */
  currentSeasonEnd: string | null;
  /** Tennis only: the court surface the tournament is played on; null in other sports. Available since 2026-11-20. */
  surface: Surface | null;
  /** Tennis only: the most sets a match can run to, 3 or 5; null in other sports. Available since 2026-11-20. */
  bestOf: number | null;
  /** Competitions the source ties to this one: its pre-season, its postseason or a sister event run by the same body (the NFL lists NFL Preseason, NCAA Division I basketball lists March Madness). [] when there are none. Available since 2026-11-21. */
  relatedLeagues: LeagueRef[];
