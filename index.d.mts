/** Career statistics for an MMA fighter, calculated by our data source from the fights it holds detailed data on (which may not be the full career). Includes per-round and per-15-minute rates, 0–100 shares and time spent in each position. Keys take the match-statistics names (`significantStrikesHeadLanded`, `takedownsSucceeded`, …) and add the rate as a suffix. Null means the source has no figure. */

export interface FighterCareerStatistics {
  /** Average strikes landed per round, counting every strike. */
  strikesLandedPerRound: number | null;
  /** Average strikes landed per round while at distance. */
  strikesDistanceLandedPerRound: number | null;
  /** Strikes landed at distance as a share of all their landed strikes, 0–100. Unit: percent. */
  strikesDistancePercentage: number | null;
  /** Average strikes landed per round from the clinch. */
  strikesClinchLandedPerRound: number | null;
  /** Clinch strikes as a share of all their landed strikes, 0–100. Unit: percent. */
  strikesClinchPercentage: number | null;
  /** Average strikes landed per round on the ground. */
  strikesGroundLandedPerRound: number | null;
  /** Ground strikes as a share of all their landed strikes, 0–100. Unit: percent. */
  strikesGroundPercentage: number | null;
  /** Average strikes taken from opponents per round. */
  strikesReceivedPerRound: number | null;
  /** Per-round average of significant strikes landed. */
  significantStrikesLandedPerRound: number | null;
  /** Significant strikes as a share of all their landed strikes, 0–100. Unit: percent. */
  significantStrikesPercentage: number | null;
  /** Per-round average of significant strikes landed to the head. */
  significantStrikesHeadLandedPerRound: number | null;
  /** Head strikes as a share of their significant strikes, 0–100. Unit: percent. */
  significantStrikesHeadPercentage: number | null;
  /** Per-round average of significant strikes landed to the body. */
  significantStrikesBodyLandedPerRound: number | null;
  /** Body strikes as a share of their significant strikes, 0–100. Unit: percent. */
  significantStrikesBodyPercentage: number | null;
  /** Per-round average of significant strikes landed to the legs. */
  significantStrikesLegsLandedPerRound: number | null;
  /** Leg strikes as a share of their significant strikes, 0–100. Unit: percent. */
  significantStrikesLegsPercentage: number | null;
  /** Per-round average of significant strikes landed at distance. */
  significantStrikesDistanceLandedPerRound: number | null;
  /** Significant strikes at distance as a share of all their significant strikes, 0–100. Unit: percent. */
  significantStrikesDistancePercentage: number | null;
  /** Per-round average of significant strikes landed in the clinch. */
  significantStrikesClinchLandedPerRound: number | null;
  /** Significant strikes in the clinch as a share of all their significant strikes, 0–100. Unit: percent. */
  significantStrikesClinchPercentage: number | null;
  /** Per-round average of significant strikes landed on the ground. */
  significantStrikesGroundLandedPerRound: number | null;
  /** Significant strikes on the ground as a share of all their significant strikes, 0–100. Unit: percent. */
  significantStrikesGroundPercentage: number | null;
  /** Average significant strikes taken from opponents per round. */
  significantStrikesReceivedPerRound: number | null;
  /** Number of takedowns they attempt per 15 minutes. */
  takedownsAttemptedPer15Min: number | null;
  /** Successful takedowns per 15 minutes. */
  takedownsSucceededPer15Min: number | null;
  /** Share of their takedown attempts that succeed (landed / attempted), 0–100. Unit: percent. */
  takedownsSucceededPercentage: number | null;
  /** Takedown attempts made against them per 15 minutes. */
  takedownsReceivedPer15Min: number | null;
  /** Of those attempts, the number they stopped per 15 minutes. */
  takedownsDefendedPer15Min: number | null;
  /** Takedown defence rate — attempts stopped divided by attempts against them, 0–100. Unit: percent. */
  takedownsDefendedPercentage: number | null;
  /** Ground advances (positional transitions) they completed per 15 minutes. */
  transitionsSucceededPer15Min: number | null;
  /** Positional transitions completed against them per 15 minutes. */
  transitionsReceivedPer15Min: number | null;
  /** How many submissions they attempt per 15 minutes. */
  submissionsAttemptedPer15Min: number | null;
  /** How many submissions they complete per 15 minutes. */
  submissionsSucceededPer15Min: number | null;
  /** Submission success rate — completed divided by attempted, 0–100. Unit: percent. */
  submissionsSucceededPercentage: number | null;
  /** How many submissions opponents attempt on them per 15 minutes. */
  submissionsReceivedPer15Min: number | null;
  /** Of those attempts, how many they fended off per 15 minutes. */
  submissionsDefendedPer15Min: number | null;
  /** Share of submission attempts against them that they defend, 0–100. Unit: percent. */
  submissionsDefendedPercentage: number | null;
  /** Total career time spent fighting at distance. Unit: seconds. */
  distanceSeconds: number | null;
  /** Average time per round spent at distance. Unit: seconds. */
  distanceSecondsPerRound: number | null;
  /** Per-round average of the proportion of fight time spent at distance, 0–100. This is our data source’s own number: it can exceed 100 slightly (100.2 has been observed), and the distance, clinch and ground shares do not necessarily sum to 100. Unit: percent. */
  distancePercentage: number | null;
  /** Total career time spent in the clinch. Unit: seconds. */
  clinchSeconds: number | null;
  /** Average time per round spent in the clinch. Unit: seconds. */
  clinchSecondsPerRound: number | null;
  /** Per-round average of the proportion of fight time spent in the clinch, 0–100 (caveats as for `distancePercentage`). Unit: percent. */
  clinchPercentage: number | null;
  /** Total career time spent controlling an opponent in the clinch. Unit: seconds. */
  clinchControlSeconds: number | null;
  /** Clinch control as a share of total fight time, 0–100. Unit: percent. */
  clinchControlPercentage: number | null;
  /** Total career time spent on the ground. Unit: seconds. */
  groundSeconds: number | null;
  /** Average time per round spent on the ground. Unit: seconds. */
  groundSecondsPerRound: number | null;
  /** Per-round average of the proportion of fight time spent on the ground, 0–100 (caveats as for `distancePercentage`). Unit: percent. */
  groundPercentage: number | null;
  /** Total career time spent in control on the ground. Unit: seconds. */
  groundControlSeconds: number | null;
  /** Ground control as a share of total fight time, 0–100. Unit: percent. */
  groundControlPercentage: number | null;
}

/** The CAREER record (e.g. 28-0-4) of a fighter in MMA or boxing. It is not the same as /v2/fixtures/{id}/form, where our data source gives pre-fight form inside the event’s competition (8-0-3 for that fighter, for example). */

