  /** All innings, in the order played; empty until the first ball is bowled, and in other sports. */
  innings: ScorecardInnings[];
}

/** One cricket innings: totals, the batting card and the bowling card, falls of wicket and partnerships. */

export interface ScorecardInnings {
  /** Innings key in match order (inning1, inning2, …): the second innings of the match is always inning2, regardless of who bats. Uses the same keys as Points.innings. */
  inning: PeriodKey;
  /** Side currently at bat. */
