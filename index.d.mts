  date?: string;
  sport?: string | null;
  league?: number;
  category?: number;
  country?: string;
  categoryIds?: number[];
  page?: number;
  count?: number;
  leagueCount?: number;
  hasNextPage?: boolean;
  nextCursor?: string | null;
  complete?: boolean;
  tz?: string;
  utcFrom?: string;
  utcTo?: string;
};

