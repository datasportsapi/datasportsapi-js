  /** Team in the field in this innings. */
  bowlingTeam: TeamRef | null;
  /** Innings total, combining runs off the bat and extras. */
  runs: number | null;
  /** Wickets fallen, including a batter retired hurt who is unable to return. */
  wickets: number | null;
  /** Overs received, in cricket notation (19.3 means 19 overs plus 3 balls). */
  overs: number | null;
  /** Runs conceded other than off the bat. */
  extras: Extras;
  /** Batting card in order of appearance, including did-not-bat entries. */
  batting: ScorecardBatter[];
  /** Bowling card in the order the bowlers were used. */
  bowling: ScorecardBowler[];
  /** Each fall of wicket in sequence; retirements are not counted as falls. */
  fallOfWickets: FallOfWicket[];
  /** Each batting partnership in sequence. */
  partnerships: Partnership[];
