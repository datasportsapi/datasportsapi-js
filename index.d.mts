  /** Given name of the player from the source's records; `player` carries the in-game handle. Available since 2026-11-25. */
  firstName: string | null;
  /** Family name of the player from the source's records. Available since 2026-11-25. */
  lastName: string | null;
  /** Counter-Strike, while a map is under way: true if the player is still standing in the current round, false once killed in it. Null for other titles and whenever the source does not report it. Available since 2026-11-25. */
  alive: boolean | null;
  /** Role the player filled in this game. */
  role: EsportsRole;
  /** Champion / hero the player used. */
  character: EsportsCharacter | null;
  /** Kill count. */
  kills: number | null;
  /** Death count. */
  deaths: number | null;
  /** Assist count. */
  assists: number | null;
  /** League of Legends: total gold earned. */
  gold: number | null;
  /** Creeps killed — minions and monsters in League of Legends, last hits in Dota 2. */
  creepScore: number | null;
  /** Champion / hero level when the game ended (League of Legends, Dota 2). */
  level: number | null;
  /** Dota 2: friendly creeps the player last-hit to deny the opponent their gold. */
  denies: number | null;
  /** Dota 2: final net worth in gold (gold held plus items). */
  netWorth: number | null;
  /** Dota 2: average gold earned per minute of play. */
  goldPerMinute: number | null;
  /** Dota 2: average experience earned per minute of play. */
  experiencePerMinute: number | null;
  /** Counter-Strike: ADR — hit points of damage dealt per round, on average. */
  averageDamagePerRound: number | null;
  /** Counter-Strike: number of kills scored with a headshot. This is a count capped by `kills`, not a percentage. */
  headshotKills: number | null;
  /** Counter-Strike: KAST, the 0–100 share of rounds in which the player recorded a kill or assist, survived, or was traded. Unit: percent. */
  kastPercentage: number | null;
  /** Counter-Strike: kills minus deaths; negative if the player died more often than they killed. */
  killDeathDifference: number | null;
  /** Counter-Strike: opening kills minus opening deaths — an opening duel being the round’s first kill, whether by or on the player. Summed over every player on a map, the values come to 0. */
  firstKillDifference: number | null;
  /** Counter-Strike: kills made by teammates on opponents this player had blinded with a flash. */
  flashAssists: number | null;
