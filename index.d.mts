export type PeriodKey = string;

/** A season export (Business and up). Poll it until status is ready or failed. */

export interface Export {
  /** The export's id, for polling. */
  id: number;
  /** Our league id, as you sent it. */
  league: number;
  /** The season id, as you sent it. */
  season: number;
  /** The format you asked for. */
  format: "json" | "csv" | "parquet";
  /** Where the build stands. */
  status: "pending" | "running" | "ready" | "failed";
  /** Why a failed export failed or, on a ready one, which parts could not be read (e.g. "not included: topPlayers"). */
  error?: string | null;
  /** How many fixtures the export holds, once it is ready. */
  fixtureCount?: number | null;
  /** When you started it. */
  createdAt?: string;
  /** When it became ready or failed. */
  finishedAt?: string | null;
  /** One entry per file; empty until the export is ready. */
  files: ExportFile[];
  /** When the url values in files stop working: an hour after you read them. */
  linksExpireAt?: string;
}

/** One file of a ready export. */

export interface ExportFile {
  /** File name, e.g. fixtures.parquet or season.json. */
  name?: string;
  /** Size in bytes. */
  bytes?: number;
  /** MIME type of the file. */
  contentType?: string;
  /** Signed download link; no API key needed, valid until linksExpireAt. */
  url?: string;
}

/** The body of every failed request. Branch on error.code; the message may be reworded. */

export interface Error {
  error: {
    /** Stable, snake_case code, e.g. not_found. Part of the contract. */
    code: string;
    /** A readable sentence for logs; never parse it. */
    message: string;
    /** history_not_in_plan only: the first day your plan can read. */
    historyFrom?: string;
    /** rate_limited and quota_exceeded only: the address of the pricing page. */
    upgradeUrl?: string;
  };
}

