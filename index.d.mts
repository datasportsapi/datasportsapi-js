/** Profile of a stadium or arena covering its location, capacity, resident teams and match record for each sport. */

export interface VenueProfile {
  /** The venue’s id — the same one found on Fixture.venue, TeamDetail.venue and venue search results. */
  id: number;
  /** Name of the stadium or arena. */
  name: string | null;
  /** Slug for use in URLs. */
  slug: string | null;
  /** City where the venue is located. */
  city: string | null;
  /** The state or region of the venue’s city as an ISO 3166-2 code (US-FL), where the source names one. Available since 2026-11-24. */
  state: string | null;
  /** Country where the venue is located. */
  country: Country | null;
  /** Number of seats. */
  capacity: number | null;
  /** The day the venue opened, if known. Available since 2026-11-24. */
  openedOn: string | null;
  /** Geographic latitude (WGS 84, degrees). */
  latitude: number | null;
  /** Geographic longitude (WGS 84, degrees). */
  longitude: number | null;
  /** CDN URL of a venue photo; null if our data source has none or it has not been uploaded yet. */
  image: string | null;
  /** Teams that use the venue as their home ground. */
  teams: TeamRef[];
  /** One entry per sport played at the venue, busiest first; the sport slug is the `sport` value accepted by /v2/venues/{id}/fixtures. */
  sports: VenueSportStatistics[];
}

/** Aggregate results for a single sport at a venue, across all matches our data source holds for it. */

export interface VenueSportStatistics {
  /** Slug of the sport. */
  sport: string;
  /** Number of matches in that sport our data source records at the venue. */
  matchCount: number;
  /** Total goals (or points, runs …) scored by both sides in those matches. */
  scored: number | null;
  /** How often the home side won those matches, as a percentage (0–100). Unit: percent. */
  homeWinPercentage: number | null;
  /** How often those matches ended in a draw, as a percentage (0–100). Unit: percent. */
  drawPercentage: number | null;
  /** Football only: goals scored at the venue by home sides. Null in other sports and when the source has no figure. Available since 2026-11-18. */
  homeScored: number | null;
  /** Football only: goals scored at the venue by away sides. Available since 2026-11-18. */
  awayScored: number | null;
  /** Football only: how often the away side won those matches, as a percentage (0–100). Available since 2026-11-18. Unit: percent. */
  awayWinPercentage: number | null;
  /** Football only: average red cards per match at the venue, both sides together, to 2 decimal places. Available since 2026-11-18. */
  redCardsPerMatch: number | null;
  /** Football only: average corner kicks per match at the venue, both sides together, to 2 decimal places. Available since 2026-11-18. */
  cornerKicksPerMatch: number | null;
}

/** A player’s international record for a single national side. */

export interface NationalTeamRecord {
  /** The national side, at senior or youth level. */
  team: TeamRef;
  /** Caps: international matches played for that side. */
  appearances: number | null;
  /** Goals scored for that side in international matches. */
  goals: number | null;
  /** Date of their debut for the side; our data source gives only the day, so the time is midnight UTC. */
  debut: string | null;
}

/** A player’s areas of activity across a league season (football, covered leagues), built by summing their per-match heatmaps. */

export interface SeasonHeatmap {
  /** All points with their counts; draw them as a weighted density map. */
  points: SeasonHeatPoint[];
  /** Number of matches feeding the heatmap, as counted by our data source. */
  fixtureCount: number | null;
  /** Fixture ids of those matches, to the extent our data source lists them. */
  fixtureIds: number[];
}

/** A single point on a season heatmap along with how many samples it holds. */

export interface SeasonHeatPoint {
  /** Lengthwise position on the pitch, 0–100, using the match heatmap’s scale. Unit: percent. */
  x: number;
  /** Position across the width of the pitch, 0–100. Unit: percent. */
  y: number;
  /** Number of samples recorded at this point during the season; use it to weight the density. */
  count: number;
}

/** The rating a player received in a single match of a season, forming one point on their rating chart. */

export interface PlayerRating {
  /** Fixture id of the match. */
  fixtureId: number;
  /** Kick-off time of the match. */
  startTime: string | null;
  /** Match rating from our data source (0–10). */
  rating: number | null;
  /** Side they represented in that match. */
  side: Side | null;
  /** The opposing team. */
  opponent: TeamRef | null;
}

/** A player’s past twelve months as a single timeline (GET /v2/players/{id}/last-year). Available since 2026-11-22. */

export interface PlayerYearSummary {
  /** The lines of the timeline, oldest first. */
  entries: PlayerYearEntry[];
  /** The leagues the lines refer to by leagueId. */
  leagues: LeagueRef[];
}

/** One line of a player’s last twelve months, recording a game he played, a game he sat out (on the bench or absent), an injury or a transfer. The match figures are filled on match lines and null on every other type. */

export interface PlayerYearEntry {
  /** What the line records. */
  type: PlayerYearEntryType;
  /** When it happened; for a match, its kick-off. */
  at: string;
  /** The match, on match, bench and missing lines. */
  fixtureId: number | null;
  /** DataSportsAPI id of the team he was with (/v2/teams/{id}). */
  playedForId: number | null;
  /** League of the match, listed in `leagues`. */
  leagueId: number | null;
  /** Match rating (match lines). */
  rating: number | null;
  /** Minutes on the pitch (match lines). */
  minutesPlayed: number | null;
  /** Goals scored (match lines). */
  goals: number | null;
  /** Assists (match lines). */
  assists: number | null;
  /** Expected goals (match lines). */
  expectedGoals: number | null;
  /** Goals his team let in while he was playing (match lines). */
  goalsConceded: number | null;
  /** Saves made (match lines, goalkeepers). */
  saves: number | null;
  /** Why he missed the match (missing lines). */
  missingReason: PlayerMissingReason | null;
}

/** One row of a player’s career table: their statistics for a single competition, season and type. */

export interface PlayerCareerSeason {
  /** Competition the row covers. */
  league: LeagueRef;
  /** Season of this row. Its id goes into the `season` parameter of /v2/players/{id}/statistics, together with this league. */
  season: Season;
  /** Club they represented in this competition, or a national side in international competitions. */
  team: TeamRef | null;
  /** Which matches are included: overall, or regularSeason / playoffs in leagues that separate them. */
  type: SeasonStatsType;
  /** Totals and averages for the season, keyed exactly as in /v2/players/{id}/statistics (naming conventions for season figures: `…PerMatch` is the total divided by matches, `…Per90` is per 90 minutes, `average…` is a season mean, `…Percentage` runs 0–100, and units are spelled out in the key). Ratings are rounded to two decimal places. */
  statistics: Record<string, number>;
}

/** One row from /v2/rankings/{type}, showing a team’s or competitor’s position in that ranking table. */

export interface TeamRanking {
  /** Which ranking table this is; fetch the full table with GET /v2/rankings/{type}. */
  type: RankingTypeSlug;
  /** Current rank in the table (0 for MMA champions). */
  position: number;
  /** Rank in the previous edition; null if our data source does not provide it. */
  previousPosition: number | null;
  /** Ranking points — for UTR, the Universal Tennis Rating value itself (e.g. 16.45). Rankings without points return null. */
  points: number | null;
  /** Previous edition’s points. */
  previousPoints: number | null;
  /** Best rank ever reached (tennis), if our data source provides it. */
  bestPosition: number | null;
  /** Date the career-high rank was reached, if our data source provides it (which is rare). */
  bestPositionAt: string | null;
  /** Number of tournaments that count towards the total (ATP / WTA); null for other rankings. */
  tournamentsPlayed: number | null;
  /** Live tennis rankings: the total the player would reach by winning the next match; null for other rankings, as on RankingRow. Available since 2026-11-25. */
  pointsIfNextWin: number | null;
  /** Live tennis rankings: the highest total the player can still reach at the tournament in progress; null for other rankings. Available since 2026-11-25. */
  maxPoints: number | null;
  /** The family of table this ranking belongs to, in the source's word, as in RankingRow.rankingClass ("team", "livetennis", "utr", …); null when the source does not classify it. Available since 2026-11-27. */
  rankingClass: string | null;
}

/** Our data source’s player of the season for a completed league season — the highest average rating among players who met the playing-time threshold. */

export interface PlayerOfTheSeason {
  /** The winning player. */
  player: PlayerRef;
  /** Team they played for that season. */
  team: TeamRef | null;
  /** Average match rating across the season, from our data source, rounded to two decimal places. */
  rating: number | null;
  /** Number of matches in which they received a rating. */
  appearances: number | null;
}

/** A candidate for player of the season; candidates are ordered by average rating, highest first. */

export interface PlayerOfTheSeasonCandidate {
  /** The candidate. */
  player: PlayerRef;
  /** Team they played for that season. */
  team: TeamRef | null;
  /** Average match rating across the season, from our data source, rounded to two decimal places. */
  rating: number | null;
  /** Number of matches in which they received a rating. */
  appearances: number | null;
  /** `true` if they have played enough of the season to be eligible. */
  playedEnough: boolean | null;
}

/** A single pitch in a baseball at-bat, or a play that happens between pitches, with its type, speed, location, outcome, the resulting count, runners and fielders. */

export interface Pitch {
  /** Whether this is a pitch or a play between pitches. */
  kind: PitchEventKind;
  /** Pitch number within the at-bat, starting at 1; a play between pitches reuses the number of the preceding pitch (0 if no pitch has been thrown yet). */
  number: number | null;
  /** Time the pitch was delivered. */
  at: string | null;
  /** Player on the mound. */
  pitcher: PlayerRef | null;
  /** Player at the plate. */
  batter: PlayerRef | null;
  /** Throwing hand of the pitcher. */
  pitcherHand: Handedness | null;
  /** Side of the plate the batter hits from. */
  batterHand: Handedness | null;
  /** Kind of pitch; null for a play between pitches. */
  pitchType: PitchType | null;
  /** Pitch name in our data source’s words ("Four-Seam Fastball"), intended for display only. */
  pitchName: string | null;
  /** Speed of the ball at release. Unit: kilometersPerHour. */
  speedKmh: number | null;
  /** Location where the ball crossed the plate, using MLB Statcast zones: 1–9 cover the strike zone as a 3 × 3 grid numbered from the top left from the catcher’s view, and 11–14 are the four quadrants outside it. */
  zone: number | null;
  /** Result of the pitch; null for a play between pitches. */
  outcome: PitchOutcome | null;
  /** Raw outcome code from our data source ("bB", "kKS", "oFO", …), for outcomes that `other` leaves unnamed. */
  outcomeCode: string | null;
  /** `true` if the at-bat finished on this pitch. */
  endsAtBat: boolean;
  /** Ball count once the pitch is recorded. */
  balls: number | null;
  /** Strike count once the pitch is recorded. */
  strikes: number | null;
  /** Outs in the half-inning once the pitch is recorded. */
  outs: number | null;
  /** Home side’s runs once the pitch is recorded. */
  homeScore: number | null;
  /** Away side’s runs once the pitch is recorded. */
  awayScore: number | null;
  /** `true` if the pitch resulted in a base hit. */
  hit: boolean;
  /** `true` if the batter bunted. */
  bunt: boolean;
  /** `true` if it was a wild pitch. */
  wildPitch: boolean;
  /** `true` if it was a passed ball. */
  passedBall: boolean;
  /** `true` if a double play resulted. */
  doublePlay: boolean;
  /** `true` if a triple play resulted. */
  triplePlay: boolean;
  /** `true` if the call was reversed after review. */
  overturned: boolean;
  /** Details of the ball put in play, if any. */
  battedBall: BattedBall | null;
  /** Point where the pitch crossed the plate, in the pixel coordinates of MLB Gameday’s pitch plot (seen from behind the plate: x grows towards the catcher’s right, y grows downwards). Null for a play between pitches and when our data source has no location. Available since 2026-11-20. */
  location: PlotPoint | null;
  /** Top and bottom of this batter’s strike zone for the pitch, as heights above the ground in feet (MLB Statcast). Available since 2026-11-20. */
  strikeZone: {
    top: number;
    bottom: number;
  } | null;
  /** Where a ball put in play was fielded, in the pixel coordinates of MLB Gameday’s 250 × 250 field image, with home plate close to x 125, y 200: the points of a spray chart. Available since 2026-11-20. */
  hitLocation: PlotPoint | null;
  /** Runner movements on the play in the order listed, including the batter once they start running. */
  runners: PitchRunner[];
  /** Fielders who received credit on the play. */
  fielders: PitchFielder[];
}

/** Movement of one runner during a pitch or a play between pitches. */

export interface PitchRunner {
  /** Someone named on a pitch as a runner or a fielder. */
  player: PitchActor;
  /** Starting base: 0 for the batter at the plate, 1–3 for first through third base. */
  fromBase: number | null;
  /** Base reached: 1–3 for first through third, 4 for home (a run scored); null if they were put out. */
  toBase: number | null;
  /** `true` if the runner was retired on the play. */
  out: boolean;
}

/** Someone named on a pitch as a runner or a fielder. */

export interface PitchActor {
  /** The player’s id; null if our data source supplies none. */
  id: number | null;
  /** Name in our data source’s listing. */
  name: string | null;
}

/** Credit given to a fielder on a play. */

export interface PitchFielder {
  /** Someone named on a pitch as a runner or a fielder. */
  player: PitchActor;
  /** The fielder’s part in the play. */
  role: FielderRole;
  /** Sequence within the play, where 1 is the first fielder to touch the ball. */
  order: number | null;
}

/** Details of a ball hit into play. */

export interface BattedBall {
  /** Flight path of the ball. */
  trajectory: BattedBallTrajectory | null;
  /** Strength of contact off the bat. */
  hardness: BattedBallHardness | null;
}

/** A match highlight video that lives on a third-party platform. */

export interface Highlight {
  /** Video title, for example "Liverpool FC 0-1 Arsenal". */
  title: string;
  /** Secondary title such as "Full Highlights", or the text of the post. */
  subtitle: string | null;
  /** Link to the video on its platform (YouTube, X, …). DataSportsAPI does not host video, so link to or embed it from that platform. */
  url: string;
  /** Platform hosting the video. */
  provider: HighlightProvider;
  /** Thumbnail hosted by the video platform itself (i.ytimg.com, pbs.twimg.com); any other platform gives null. */
  thumbnailUrl: string | null;
  /** `true` if our data source marks this as the match’s primary highlight. */
  main: boolean;
  /** Two-letter codes of the countries to which our data source restricts the video (broadcast rights); an empty list means it is available everywhere. */
  countries: string[];
  /** Time our data source added the highlight. */
  publishedAt: string | null;
}

/** A video about a team or a player from an official channel (extended highlights, interviews), hosted by a third party (GET /v2/teams/{id}/videos, /v2/players/{id}/videos). Available since 2026-11-22. */

export interface Video {
  /** Video title. */
  title: string;
  /** The description the host shows with it. */
  description: string | null;
  /** Link to the video on its host. DataSportsAPI does not host video, so link to or embed it from there. */
  url: string;
  /** Platform hosting the video. */
  provider: HighlightProvider;
  /** Thumbnail hosted by the platform itself; null for other hosts. */
  thumbnailUrl: string | null;
  /** `true` when the host allows the video to be embedded. */
  embeddable: boolean;
}

/** Period lengths for sports played in sets or rounds (tennis, table tennis, badminton, volleyball, MMA, …), as timed by our data source. */

export interface Durations {
  /** Duration in seconds of every COMPLETED period, using the same keys as ScoreSide.periods (in tennis period1 is the first set; in MMA / boxing the keys are the rounds). The period under way is excluded; its start is clock.periodStartedAt. */
  periods: Record<string, number>;
  /** Adds up `periods`: once the match has ended this is its playing time, not counting breaks between periods. Null when `periods` is empty, except in padel (since 2026-11-25): the source clocks only the match as a whole there, so `periods` stays empty and this alone holds the playing time. Unit: seconds. */
  totalSeconds: number | null;
}

/** Fixture totals for a UTC day, broken down by sport (today only) or by category within one sport (any day), A client can use it to print something like “1,172 matches today, 45 live” without walking through every page of the day. */

export interface FixtureCounts {
  /** Date (UTC, YYYY-MM-DD) the counts refer to. */
  date: string;
  /** Sport being counted; null covers all sports, in which case only today can be requested. */
  sport: string | null;
  /** All fixtures on the day regardless of state. With `sport`, this sums the per-category counts; without it, it sums the per-sport totals. For the same sport the two methods can disagree by a few percent, because the per-category list includes some matches carried over from late on the previous day. */
  fixtureCount: number;
  /** Fixtures currently live, taken from our live index (the same as /v2/sports); null unless `date` is today (UTC). */
  liveCount: number | null;
  /** When `sport` is omitted: each sport we cover that has fixtures today, ordered by fixture count, highest first. Empty when `sport` is given. */
  sports: SportFixtureCount[];
  /** With `sport` set: every category (country, region, tour) that has fixtures on the day, sorted by fixture count, highest first, then by name. Empty when `sport` is omitted, and for race sports (motorsport, cycling — use /v2/races). */
  categories: CategoryFixtureCount[];
}

/** Today’s fixture total for a single sport, along with the number currently live. */

export interface SportFixtureCount {
  /** Slug of the sport, matching /v2/sports. */
  sport: string;
  /** All fixtures on the UTC day regardless of state, taken from our data source’s per-sport daily counter. */
  fixtureCount: number;
  /** Fixtures currently live according to our live index — the same number /v2/sports and /v2/livescores report. */
  liveCount: number;
}

/** How many fixtures one category (a country, region or tour) has on a given day. */

export interface CategoryFixtureCount {
  /** A bucket of leagues inside a sport, forming the top tier of the league directory. */
  category: Category;
  /** All fixtures in the category’s leagues on the UTC day, regardless of state. */
  fixtureCount: number;
  /** Number of the category’s leagues that have one or more fixtures that day. */
  leagueCount: number;
}

/** The scope of the API in figures: how many entities carry a DataSportsAPI id, what each sport’s league directory holds and how far back its headline competitions go. */

export interface Coverage {
  /** Time these figures were computed (ISO 8601). The totals are refreshed every hour, the per-sport directories once a day. */
  updatedAt: string;
  /** Number of sports served — the same list as GET /v2/sports. */
  sports: number;
  /** Counts of the entities that have a DataSportsAPI id, each of which can be fetched by that id. The numbers only rise: an id, once issued, is never changed or withdrawn. */
  totals: CoverageTotals;
  /** How deep the headline competitions of all sports go, taken together. */
  history: CoverageHistory;
  /** One entry per sport whose directory has been read, in the order of /v2/sports. Shortly after this endpoint is redeployed a sport can be absent until its directory has been read once. */
  bySport: SportCoverage[];
}

/** Counts of the entities that have a DataSportsAPI id, each of which can be fetched by that id. The numbers only rise: an id, once issued, is never changed or withdrawn. */

export interface CoverageTotals {
  /** Competitions and leagues that have a DataSportsAPI id. */
  leagues: number;
  /** League seasons that have a DataSportsAPI id. */
  seasons: number;
  /** Teams that have a DataSportsAPI id: clubs and national sides, plus the individual competitors of one-on-one sports such as tennis, MMA, darts and snooker. */
  teams: number;
  /** Players that have a DataSportsAPI id. */
  players: number;
  /** Fixtures (matches), played and upcoming, that have a DataSportsAPI id. */
  fixtures: number;
  /** Venues that have a DataSportsAPI id. */
  venues: number;
  /** Managers and head coaches that have a DataSportsAPI id. */
  managers: number;
  /** Referees that have a DataSportsAPI id. */
  referees: number;
}

/** A summary of how deep the headline competitions of all sports go. */

export interface CoverageHistory {
  /** Number of headline competitions (the `headline` lists of every sport) whose firstSeason is known. */
  leagues: number;
  /** Median number of years between those competitions’ first season and the current year; null when no first season is known. */
  medianYears: number | null;
  /** Earliest firstSeason among those competitions; null when none is known. */
  oldestSeason: number | null;
}

/** One sport’s league directory in numbers, and how far back its headline competitions go. */

export interface SportCoverage {
  /** Slug of the sport, as listed by /v2/sports. */
  sport: string;
  /** The endpoint family that serves this sport’s data. */
  kind: SportKind;
  /** Number of categories (countries, regions, tours or games) the sport’s league directory holds (GET /v2/categories?sport=). */
  categories: number;
  /** Number of leagues across all those categories (GET /v2/leagues?category=); motorsport and cycling count series instead (GET /v2/series?category=). */
  leagues: number;
  /** Earliest firstSeason found in `headline`; null if unknown. */
  historyFrom: number | null;
  /** Up to ten headline competitions for the sport: the popular international competitions in its directory or, failing those, the first leagues of the directory, in that order. */
  headline: CoverageLeague[];
}

/** One headline competition of a sport, with the depth of its season list. */

export interface CoverageLeague {
  /** League id issued by DataSportsAPI (for motorsport and cycling, a series id). */
  id: number;
  /** Name of the league, competition or series. */
  name: string;
  /** How many seasons its season list holds (GET /v2/leagues/{id}/seasons; motorsport and cycling use /v2/series/{id}/seasons). */
  seasons: number;
  /** Start year of the oldest season in that list; null when no season label can be parsed. Older seasons carry less detail: results and tables usually reach further back than lineups and statistics. */
  firstSeason: number | null;
}

/** A player’s on-ball actions in one match, each placed on the pitch — the same actions our data source’s player rating is built from (football, covered leagues). When the source has none (the player did not play, the match has not started, or it is another sport) the response is 200 with empty lists. */

export interface PlayerActions {
  /** Passes and crosses in our data source’s order (no timestamps are provided). */
  passes: PlayerAction[];
  /** Dribble attempts (take-ons). */
  dribbles: PlayerAction[];
  /** Defensive actions: tackles, interceptions, ball recoveries, clearances and blocks. */
  defensive: PlayerAction[];
  /** Ball carries, i.e. runs made in possession. */
  ballCarries: PlayerAction[];
}

/** Describes one thing a player did on the ball in a match. */

export interface PlayerAction {
  /** Kind of action. */
  type: PlayerActionType;
  /** Player’s location when the action began. */
  start: ActionPoint;
  /** End point: where the ball travelled to (passes, crosses, clearances) or where it was carried (ball carries). Null for other action types and when our data source has none. */
  end: ActionPoint | null;
  /** Whether the action succeeded — a completed pass or cross, a take-on or tackle won. Our data source marks successes only, so anything else reads false (we checked this against accuratePass / wonContest / wonTackle in the lineups). Ball carries have no outcome and get null. */
  successful: boolean | null;
  /** `true` for a pass or cross that set up a shot. Null for other action types. */
  keyPass: boolean | null;
  /** `true` when our data source counts it as a long ball (passes and crosses); these flags can add up to more than totalLongBalls in the lineups. Null for other action types. */
  longBall: boolean | null;
}

/** Pitch coordinates marking where an action began or finished. */

export interface ActionPoint {
  /** Position along the pitch, 0–100, oriented in the player’s attacking direction (0 at the player’s own goal line, 100 at the goal they are attacking). Both sides use this frame, the same as the match heatmap. Unit: percent. */
  x: number;
  /** Widthwise position on the pitch, 0–100, using the heatmap’s frame. Unit: percent. */
  y: number;
}

/** Lap data for one competitor on one lap of a race session. */

export interface RaceLap {
  /** Number of the lap; 0 represents the starting grid. */
  lap: number;
  /** Position when the lap ended (on lap 0, the grid slot); null on the lap where the competitor retired. */
  position: number | null;
  /** Compound fitted during this lap (Formula 1). */
  tyre: TyreCompound | null;
  /** `true` if the competitor pitted at the end of this lap (the new tyres appear from the next lap). */
  pitStop: boolean;
  /** `true` if the competitor retired during this lap, making it their final one (`position` is null). */
  retired: boolean;
}

/** A competitor’s race broken down lap by lap, showing position, tyre and pit stops for each lap. */

export interface RaceCompetitorLaps {
  /** Driver for this record — a TeamRef of kind individual, resolvable via /v2/teams/{id}. */
  competitor: TeamRef | null;
  /** Constructor the driver races for. */
  team: TeamRef | null;
  /** Race number on the car. */
  number: number | null;
  /** Starts with lap 0 (the grid), followed by each lap completed in sequence; for a competitor who retired, the list ends at that lap. */
  laps: RaceLap[];
}

/** Betting prices for a motorsport race weekend from a single bookmaker, supplied via our data source; the prices carry no bookmaker identity. Outright markets covering the race, qualifying and each practice, with both opening and current prices. Available since 2026-11-20, over REST only. These are third-party prices shown for information only — they are neither advice nor an offer to bet. 18+ only; please gamble responsibly. */

export interface RaceOdds {
  /** The race’s id. */
  raceId: number;
  /** Our last fetch of these prices (no timestamp comes from our data source itself); null when no prices exist. */
  updatedAt: string | null;
  /** All markets the bookmaker offers for the weekend — race, qualifying and practices — in the bookmaker’s order. Empty when there are none: most series, a race still far off, or one already finished. */
  markets: RaceOddsMarket[];
}

/** A market the bookmaker offers for a race weekend. */

export interface RaceOddsMarket {
  /** Identifier of the market that stays stable within its race. It is built from `kind`, followed by `:practice{n}` for a practice market ("winner", "fastestInPractice:practice2"); for `other` markets the label is added ("other:top-6-finish"). When the source lists a market twice, the in-play copy ends in `:live` (since 2026-11-25; it used to end in `#2`). */
  key: string;
  /** What the market is pricing. */
  kind: RaceOddsMarketKind;
  /** Market name as the bookmaker labels it ("To Win Outright", "Fastest In Practice 1"). */
  name: string;
  /** For a `fastestInPractice` market, the number of the practice session (1–3); null for every other market. */
  practice: number | null;
  /** `true` for in-play prices. */
  live: boolean;
  /** Selections in the bookmaker’s order, shortest price first. */
  choices: RaceOddsChoice[];
}

/** A single selection within a race betting market, together with its price. */

export interface RaceOddsChoice {
  /** Label the bookmaker uses for the selection, as passed on by our data source — the name of a driver or constructor, or "Yes" for markets asked once per driver. */
  name: string;
  /** Driver behind the selection; null for markets on constructors. */
  competitor: TeamRef | null;
  /** Constructor: on a constructor market the one being backed, otherwise the driver’s own. */
  team: TeamRef | null;
  /** Current price in fractional form ("6/4"). null while the bookmaker displays no price. */
  fractional: string | null;
  /** Decimal form of the current price (= 1 + fractional), rounded to two decimal places. */
  decimal: number | null;
  /** Opening price of the market, in fractional form. */
  openingFractional: string | null;
  /** Opening price of the market, in decimal form. */
  openingDecimal: number | null;
  /** Settlement as the source marks it: true for a selection that won, false for one that lost. Null before the market is settled and on selections the source leaves unmarked. Available since 2026-11-25. */
  winning: boolean | null;
}

/** Prices on how a league season or competition ends as a whole, from a single bookmaker supplied via our data source (the prices carry no bookmaker identity), with opening and current figures. Available since 2026-11-23, over REST only. These are third-party prices shown for information only — they are neither advice nor an offer to bet. 18+ only; please gamble responsibly. */

export interface LeagueOdds {
  /** The league’s DataSportsAPI id. */
  leagueId: number;
  /** The season’s DataSportsAPI id. */
  seasonId: number;
  /** Our last fetch of these prices (our data source attaches no time of its own); null while no prices exist. */
  updatedAt: string | null;
  /** The season-long markets the bookmaker offers, in the bookmaker’s order. An empty list is normal: most leagues have none, and neither does a season that is over. */
  markets: LeagueOddsMarket[];
}

/** A market the bookmaker offers on a league season as a whole. */

export interface LeagueOddsMarket {
  /** Identifier of the market that stays stable within its season. It is the `kind` ("winner"); for `other` markets the label is added ("other:top-4-finish"), and further markets sharing a key get `#2`, `#3`. */
  key: string;
  /** What the market is pricing. */
  kind: LeagueOddsMarketKind;
  /** Market name as the bookmaker labels it ("To Win Outright"). */
  name: string;
  /** `true` for in-play prices. */
  live: boolean;
  /** Selections in the bookmaker’s order, shortest price first. */
  choices: LeagueOddsChoice[];
}

/** A single selection within a season-long market, together with its price. */

export interface LeagueOddsChoice {
  /** Label the bookmaker uses for the selection, as passed on by our data source — most often the team’s short name ("PSG", "Arsenal"). */
  name: string;
  /** The team being backed; null if the selection is not a team. */
  team: TeamRef | null;
  /** Current price in fractional form ("7/2"). null while the bookmaker displays no price. */
  fractional: string | null;
  /** Decimal form of the current price (= 1 + fractional), rounded to two decimal places. */
  decimal: number | null;
  /** Opening price of the market, in fractional form. */
  openingFractional: string | null;
  /** Opening price of the market, in decimal form. */
  openingDecimal: number | null;
}

/** Who won a league season, who lost the final and who was named finals MVP (NBA, NFL, …). Available since 2026-11-20. */

export interface SeasonChampions {
  /** Team that won the season; null until it is decided. */
  champion: ChampionEntry | null;
  /** Finalist that lost; null if none is named. */
  runnerUp: ChampionEntry | null;
  /** Most valuable player of the finals (the NBA Finals MVP, for example); null if none is named. */
  finalsMvp: PlayerRef | null;
  /** Winners of each conference, in leagues that name them; empty elsewhere. */
  conferenceChampions: ChampionEntry[];
}

/** A finalist of a league season, with how many titles it holds. */

export interface ChampionEntry {
  team: TeamRef | null;
  /** Number of titles the team has won in this competition, this one included, as the source counts them. */
  titles: number | null;
}

/** A season award together with its winner. */

export interface IndividualAward {
  /** Stable identifier of the award, taken from the source’s slug ("most-valuable-player", "rookie-of-the-year", "coach-of-the-year"). */
  key: string;
  /** English name of the award ("Most Valuable Player"). */
  name: string;
  /** Player who received it; null when the award goes to a coach. */
  player: PlayerRef | null;
  /** Coach who received it (Coach of the Year); null when the award goes to a player. */
  manager: ManagerRef | null;
  /** Team of the winner. */
  team: TeamRef | null;
}

/** One of a season’s award teams (All-NBA 1st Team …), as listed by /v2/leagues/{id}/award-teams. */

export interface AwardTeamRef {
  /** The award team’s id, accepted by GET /v2/leagues/{id}/award-teams/{teamId}. */
  id: number;
  /** Stable identifier of the award, taken from the source’s slug ("best-first" is the All-NBA 1st Team; also "best-defensive-first", "best-rookie-first"). */
  key: string;
  /** English name of the award team ("1st Team", "Defensive 1st Team", "Rookie 1st Team"). */
  name: string;
}

/** A single entry in a league’s injury report. */

export interface LeagueInjury {
  player: PlayerRef | null;
  team: TeamRef | null;
  /** The injury in the source’s words ("Calf", "Back", "Knee"); null if none is given. */
  reason: string | null;
  /** Availability status; null if the report gives none. */
  status: InjuryStatus | null;
  /** Time the injury first appeared in the report. */
  since: string | null;
  /** Time of the report’s latest update. */
  updatedAt: string | null;
  /** End date stated by the report: while the player is out, the expected return; once he is back, the day he was cleared. Null if no date is given. */
  until: string | null;
  /** Time this line of the report was published. */
  reportedAt: string | null;
}

/** A single player’s line from one recent match. */

export interface RecentPerformance {
  player: PlayerRef | null;
  team: TeamRef | null;
  /** The fixture in which the line was recorded. */
  fixture: Fixture;
  /** The player’s figures from that match under the sport’s player statistic keys (in basketball: points, rebounds, assists, …). */
  statistics: Record<string, number>;
}

/** The position of one team statistic within its league. */

export interface TeamStatisticRank {
  /** Season figure of the team — the same quantity as that key’s statistic in /v2/teams/{id}/statistics. */
  value: number;
  /** Position among the league’s teams by season total, where 1 is the highest. */
  rank: number | null;
  /** Position by the per-game figure; it can differ from `rank` when teams have played unequal numbers of games. */
  rankPerGame: number | null;
}

/** How a team’s season statistics compare with the rest of its league (NBA, NFL, …). Available since 2026-11-20. */

export interface TeamStatisticRanks {
  /** Number of teams in the ranking. */
  teamCount: number | null;
  /** Number of the team’s matches behind the figures. */
  matches: number | null;
  /** One entry per statistic, keyed by the team season statistic keys of /v2/teams/{id}/statistics: its value and ranks. */
  ranks: Record<string, TeamStatisticRank>;
}

/** A single location on a season shot chart, with its shot counts. */

export interface ShotSpot {
  /** Lateral offset from the basket, measured in tenths of a foot; values below zero lie to the left as the shooter faces the basket, the same convention as a match shot chart. */
  x: number;
  /** Distance up the court from the basket towards half court, in tenths of a foot. */
  y: number;
  /** Number of shots made from here. */
  made: number;
  /** Number of shots missed from here. */
  missed: number;
}

/** A player’s field-goal attempts over one league season, grouped by location (basketball, plus ice hockey where the source has a chart). Available since 2026-11-20. */

export interface SeasonShotChart {
  /** All locations the player shot field goals from during the season, each with its made and missed counts. */
  spots: ShotSpot[];
}

/** One group of a league season’s group stage; today these are tennis round robins, the groups of the ATP and WTA Finals. */

export interface LeagueGroup {
  /** Group id issued by DataSportsAPI; pass it to GET /v2/leagues/{id}/groups/{groupId}/fixtures. */
  id: number;
  /** Name of the group, for example "Group A". */
  name: string;
}

/** Racing details of a motorsport driver or constructor. */

export interface MotorsportInfo {
  /** The number a driver races under; null on a constructor. */
  racingNumber: number | null;
  /** On a driver, `true` when he holds a race seat at his constructor and `false` when he is its reserve; null on a constructor. */
  mainDriver: boolean | null;
  /** The constructor a driver currently races for; null on a constructor itself. */
  constructor: TeamRef | null;
  /** Chassis name such as "RB22": a constructor’s own, and on a driver that of his constructor. */
  chassis: string | null;
  /** Power unit, such as "Red Bull Ford DM01". */
  engine: string | null;
  /** On a constructor: its drivers, in the source's order; each `id` opens that driver's own profile at /v2/teams/{id}. [] on a driver, or when the source lists none. Available since 2026-11-21. */
  drivers: TeamRef[];
}

/** A span of years in which a team was active. Available since 2026-11-21. */

export interface ActivePeriod {
  /** First year of the span. */
  from: number;
  /** Last year of the span; null while the team is still active. */
  to: number | null;
}

/** The player the source picks out for one of a team’s upcoming matches (GET /v2/teams/{id}/featured-players). */

export interface FeaturedPlayer {
  /** The upcoming match he is featured for. */
  fixtureId: number;
  /** The player. */
  player: PlayerRef;
  /** The rating that earned him the spot. */
  rating: number | null;
  /** The match that rating comes from. */
  ratedFixtureId: number | null;
}

/** One of a team’s recent matches with the source’s score for its result (GET /v2/teams/{id}/performance). */

export interface TeamPerformanceEntry {
  /** The match. */
  fixture: Fixture;
  /** Form score of the result: above 0 for a good one, below 0 for a poor one, and larger in either direction against a stronger opponent. */
  score: number | null;
}

/** Tennis: one of a player’s latest tournaments, with his best round there (GET /v2/teams/{id}/recent-leagues). */

export interface RecentLeague {
  /** The tournament. */
  league: LeagueRef;
  /** The furthest round he reached, e.g. "Semifinals". */
  round: string | null;
  /** `true` if he won the tournament. */
  won: boolean;
}

/** A series season a driver, rider or constructor took part in (GET /v2/teams/{id}/race-seasons). Available since 2026-11-22. */

export interface RaceSeason {
  /** The series. */
  series: SeriesRef | null;
  /** The season of that series. Its id is what the `season` parameter of /v2/teams/{id}/races and the /v2/series/{id}/… endpoints expects. */
  season: Season;
}

/** Box-score figures of an oval race (NASCAR). */

export interface RaceSessionStats {
  /** Average speed of the winner across the whole race, in km/h. Unit: kilometersPerHour. */
  averageSpeedKmh: number | null;
  /** How often the lead passed from one car to another. */
  leadChanges: number | null;
  /** Number of caution (yellow-flag) periods. */
  cautions: number | null;
  /** Laps completed under caution. */
  cautionLaps: number | null;
  /** Length of the race from the green flag to the chequered flag. Unit: seconds. */
  durationSeconds: number | null;
}

/** A point given in the coordinates of the plot it belongs to; the field that carries it says which plot. */

export interface PlotPoint {
  /** Position on the horizontal axis. */
  x: number;
  /** Position on the vertical axis. */
  y: number;
}

/** Extra details carried by a race hit in search results. */

export interface SearchRace {
  /** Year of the season the race is part of, e.g. "2026". */
  seasonYear: string | null;
  /** First day of the race weekend, in UTC. */
  startDate: string | null;
  /** Country hosting the race. */
  country: Country | null;
}

/** Activity map of one side across a fixture (football, covered leagues). Available since 2026-11-20. */

export interface TeamHeatmap {
  /** Position samples of the outfield players, on the frame a player heatmap uses with this side attacking from left to right; meant to be drawn as a density map. Empty when our data source has no heatmap for the match. */
  points: HeatPoint[];
  /** Position samples of the goalkeeper, kept apart from the outfield ones. */
  goalkeeperPoints: HeatPoint[];
}

/** Football: the fans’ vote for player of the match (GET /v2/fixtures/{id}/player-of-the-match). Available since 2026-11-22. */

export interface PlayerOfTheMatch {
  /** Whether fans can still vote. */
  status: PlayerOfTheMatchStatus;
  /** Moment the vote opened. */
  opensAt: string | null;
  /** Moment the vote closed, once status is closed. */
  closesAt: string | null;
  /** Number of votes cast. */
  totalVotes: number;
  /** The player with the most votes once the vote has closed; null while it is still open. */
  winner: PlayerOfTheMatchCandidate | null;
  /** All players in the vote, the most voted first. */
  candidates: PlayerOfTheMatchCandidate[];
}

/** One player in the fans’ vote for player of the match. */

export interface PlayerOfTheMatchCandidate {
  /** The player. */
  player: PlayerRef;
  /** The team he played for in the match. */
  team: TeamRef | null;
  /** His match rating from our data source (0–10). */
  rating: number | null;
  /** Votes the fans gave him. */
  votes: number;
}

/** Volleyball: one point of a set, in the order the points were won (GET /v2/fixtures/{id}/point-sequence). Available since 2026-11-22. */

export interface PointSequenceEntry {
  /** The set the point belongs to. */
  period: PeriodKey;
  /** Position of the point within the set, counted from 1. */
  point: number;
  /** Home side’s points minus away side’s points in the set once this point was played; starts again at every set. */
  homeLead: number;
}

/** A single day in the month calendar of a race sport. */

export interface RaceCalendarDay {
  /** The day, in UTC. */
  date: string;
  /** Ids of the races holding a session on that day; each resolves on GET /v2/races/{id}. */
  raceIds: number[];
}

/** A ban a player is serving in one competition. */

export interface Suspension {
  /** Cause of the ban as a key from our data source, e.g. "red_card_suspension" or "yellow_card_suspension". */
  reason: string;
  /** Length of the ban in matches, when it is counted that way. */
  matches: number | null;
  /** Competition in which the ban is served. */
  league: LeagueRef | null;
  /** Day the ban starts (UTC). */
  from: string | null;
  /** Day the ban ends, for bans set by date. */
  until: string | null;
}

/** A team’s wins and losses over its season. */

export interface SeasonRecord {
  /** Games won. */
  wins: number;
  /** Games lost. In ice hockey only those lost in regulation time — the L of W-L-OTL; overtime and shoot-out defeats are counted in `overtimeLosses`. */
  losses: number;
  /** Tied games (NFL); null in sports that have no ties. */
  draws: number | null;
  /** Ice hockey (NHL): games lost in overtime or a shoot-out, the OTL in a W-L-OTL record: "15-5-2" means 15 won, 5 lost in regulation and 2 lost after it. Every other sport gets null. Available since 2026-11-23. */
  overtimeLosses: number | null;
}

/** How one competitor finished in a single race of a championship table. */

export interface SeriesRaceResult {
  /** Id of the driver (type=competitors) or team (type=teams), matching the ids of /v2/series/{id}/standings. */
  competitorId: number;
  /** Finishing position; null if the competitor was out (check `state`). */
  position: number | null;
  /** Championship points earned in this race; null if none. */
  points: number | null;
  /** Gap to the winner at the finish, in milliseconds; null for the winner, for lapped cars and for anyone out. */
  gapMs: number | null;
  /** finished; dnf for did not finish; dns for did not start; out for any other reason the source leaves unnamed. */
  state: "finished" | "dnf" | "dns" | "out";
}

/** One round of a championship season and the results it produced. */

export interface SeriesRaceColumn {
  /** The race’s id (GET /v2/races/{id}). */
  raceId: number;
  /** What the race is called ("Brazil GP"). */
  name: string;
  /** Country hosting the race. */
  country: Country | null;
  /** Start of the race weekend. */
  startDate: string | null;
  /** Result of every competitor, ordered by finishing position. */
  results: SeriesRaceResult[];
}

/** A championship table broken down race by race (what the source calls its "detailed view"). Available since 2026-11-20. */

export interface SeriesRaceStandings {
  /** Rounds raced so far this season, newest first. */
  races: SeriesRaceColumn[];
  /** Season points per competitor, as totalled by the source. */
  totals: {
    competitorId: number;
    points: number | null;
  }[];
}

/** League-wide shooting from a single court zone. */

export interface ShootingZone {
  /** Court zone as numbered by the source, 1–9 (the zones of its shot charts, numbered the same on every chart). */
  zone: number;
  /** League field-goal percentage from this zone, 0–100. */
  average: number | null;
  /** League field-goal percentage from this zone at five ascending percentiles (the source’s p1–p5), 0–100 — a scale for placing a player’s percentage within the league. */
  percentiles: number[];
}

/** A player’s league-season rank for a single statistic. */

export interface PlayerStatRanking {
  /** Statistic being ranked, named as in /v2/players/{id}/statistics (goals, assists, rating, expectedGoals, …). */
  statistic: string;
  /** Player’s value for this statistic across the league season. */
  value: number;
  /** The player’s rank for this statistic among all league players (1 = top). Equal values share the same rank, as in standard competition ranking. */
  rank: number;
  /** Rank by the per-game value, where the source keeps one (rugby); null elsewhere. Available since 2026-11-25. */
  perGameRank: number | null;
  /** How many players hold that rank, including them (1 means no tie). Can be null: rugby rankings come without it. */
  tiedCount: number | null;
  /** How many players the league season ranks on this statistic. Can be null: rugby rankings come without it. */
  playerCount: number | null;
}

/** The timing of a team’s goals scored and conceded across a league season (football). */

export interface GoalDistribution {
  /** Set of matches included. */
  scope: GoalDistributionScope;
  /** Number of matches included. */
  fixtureCount: number | null;
  /** Goals the team scored in those matches. */
  scored: number | null;
  /** Goals the team conceded in those matches. */
  conceded: number | null;
  /** Six bands of 15 minutes each, in chronological order. */
  bands: GoalDistributionBand[];
}

/** Goal counts for a single 15-minute slice of the match. */

export interface GoalDistributionBand {
  /** Minute at which the band starts (1, 16, 31, …). Unit: minutes. */
  fromMinute: number;
  /** Minute at which the band ends (15, 30, … 90). Stoppage time is counted in the band it is added to. Unit: minutes. */
  toMinute: number;
  /** Goals scored by the team in this band. */
  scored: number;
  /** Goals conceded by the team in this band. */
  conceded: number;
}

/** Figures for a tennis player covering one calendar year and one surface. */

export interface TennisYearStatistics {
  /** Court surface the figures relate to. */
  surface: Surface | null;
  /** Number of matches played. */
  matches: number | null;
  /** Number of matches won. */
  wins: number | null;
  /** Number of tournaments entered. */
  tournamentsPlayed: number | null;
  /** Number of tournaments won. */
  tournamentsWon: number | null;
  /** Aces served. */
  aces: number | null;
  /** Double faults committed. */
  doubleFaults: number | null;
  /** Total service points (= firstServesIn + secondServes). */
  servicePoints: number | null;
  /** First serves that landed in. */
  firstServesIn: number | null;
  /** Service points won after landing the first serve. */
  firstServePointsWon: number | null;
  /** Service points that needed a second serve. */
  secondServes: number | null;
  /** Count of second serves that went in (= secondServes − doubleFaults). */
  secondServesIn: number | null;
  /** Service points won when playing on a second serve. */
  secondServePointsWon: number | null;
  /** Break points they converted while returning serve. */
  breakPointsConverted: number | null;
  /** Break-point chances they created while returning serve. */
  breakPointChances: number | null;
  /** Break points they had to defend while serving. */
  breakPointsFaced: number | null;
  /** Of the break points against them, how many the opponent won. */
  breakPointsLost: number | null;
  /** Number of tie-breaks won. */
  tiebreaksWon: number | null;
  /** Number of tie-breaks lost. */
  tiebreaksLost: number | null;
  /** Number of winners struck. */
  winners: number | null;
  /** Number of unforced errors made. */
  unforcedErrors: number | null;
}

/** The champion of a single league season. */

export interface LeagueChampion {
  /** Id of the season in question, matching a Season from /v2/leagues/{id}/seasons. */
  seasonId: number | null;
  /** Year in which the season finished (2026 for 25/26). */
  year: number | null;
  /** Team that took the title. */
  team: TeamRef | null;
}

/** Betting prices for a fixture from a single bookmaker, supplied via our data source; the prices carry no bookmaker identity. Pre-match and in-play, opening and current, plus settlement flags once the match is over. Available since 2026-11-04. Live updates arrive on the `odds:{fixtureId}` WebSocket channel (on Business and Enterprise). These are third-party prices shown for information only — they are neither advice nor an offer to bet. */

export interface Odds {
  /** The fixture’s id. */
  fixtureId: number;
  /** Our last fetch or receipt of these prices (no timestamp comes from our data source itself); null when no prices exist. */
  updatedAt: string | null;
  /** All markets the bookmaker offers on the fixture, in the bookmaker’s order. Empty when there are none — typically a minor league, a match far in the future, or a finished match whose odds have been removed. */
  markets: OddsMarket[];
}

/** A market the bookmaker offers for a fixture. */

export interface OddsMarket {
  /** Identifier of the market that stays stable within its fixture. It is built from `kind`, followed by `:period` unless the market covers the whole match, `:line` if there is a line, and `:live` for in-play markets ("result", "result:half1", "totalGoals:2.5", "asianHandicap:-1.25", "winner:live"). For `other` markets the label is added ("other:corners-1x2"), and further markets sharing a key get `#2`, `#3`. The `:live` suffix exists because, once play starts, the bookmaker shows the in-play market alongside the closed pre-match one. When a line moves it gets a new key and the old key disappears. Use this key to merge WebSocket `odds` frames. */
  key: string;
  /** What the market is pricing. */
  kind: OddsMarketKind;
  /** Market name as the bookmaker labels it ("Full time", "Match goals", "Asian handicap"). */
  name: string;
  /** Portion of the match the market is settled on: "match" when it covers the whole match in the market’s own sense (see `kind`); otherwise a unit with a number — half1, half2, quarter1…4, period1…3 (ice hockey), set1…, inning1…, map1…, game1…, round1…. Whatever the sport’s division, a half always means half of the match (in basketball, half1 = quarters 1–2). null if our data source’s period label is not recognised (check `name`). */
  period: string | null;
  /** Line value: the over / under threshold for a total, or the home side’s handicap for a handicap market. Null for markets without a line. */
  line: number | null;
  /** `true` for in-play prices — once the match has started and the bookmaker is trading it live. */
  live: boolean;
  /** `true` while a goal, red card, VAR check or similar has paused the market; the prices shown cannot be bet on at that moment. */
  suspended: boolean;
  /** Selections in the bookmaker’s order: home ahead of away, with draw / "no goal" between them. */
  choices: OddsChoice[];
  /** Who set the `winning` flags of its choices: `source` (the bookmaker’s own flags) or `computed` (settled on our side from the final result, since the bookmaker never sends flags for it — football Asian handicaps on half lines, judged on the regular-time score, and total cards when every card of the match was a yellow one shown to a player on the pitch and the incidents agree with the statistics). Null while nobody has settled it. Since 2026-11-12. */
  settledBy: OddsSettledBy | null;
}

/** A single selection within a betting market, together with its price. */

export interface OddsChoice {
  /** Label the bookmaker uses for the selection, as passed on by our data source ("1", "X", "Over", "(-0.5) Galatasaray", a team name). */
  name: string;
  /** What the selection is backing. */
  outcome: OddsOutcome;
  /** Current price in fractional form ("19/20" means 19 profit for every 20 staked). null while the bookmaker displays no price. */
  fractional: string | null;
  /** Decimal form of the current price (= 1 + fractional, which is the total paid back per unit staked), rounded to two decimal places. Null exactly when `fractional` is null. */
  decimal: number | null;
  /** Opening price of the market, in fractional form. */
  openingFractional: string | null;
  /** Opening price of the market, in decimal form. */
  openingDecimal: number | null;
  /** Direction of the price’s most recent movement. */
  change: OddsChange;
  /** Once settled, `true` if this selection won. Null before settlement, and on markets that nobody settles (see the market’s `settledBy`). */
  winning: boolean | null;
}

/** The headline market for a fixture in a daily odds list — the three-way result in sports that allow draws, otherwise the winner market. */

export interface FeaturedOdds {
  /** The fixture’s id; GET /v2/fixtures/{id} returns the match and GET /v2/fixtures/{id}/odds returns all of its markets. */
  fixtureId: number;
  /** A market the bookmaker offers for a fixture. */
  market: OddsMarket;
}

/** Winning-odds figures for a fixture. It takes each side’s win price (from one bookmaker, via our data source) and gives the probability that price implies plus how often sides at that price have won in the past — both figures come from the data source. It is two-way only, so there is no draw entry. Available since 2026-11-06. The prices and statistics come from a third party and are for information only; they are not advice or an offer to bet. */

export interface WinningOdds {
  /** The fixture’s id. */
  fixtureId: number;
  /** Time we last fetched the figures (our data source supplies no timestamp of its own); null if there are no figures. */
  updatedAt: string | null;
  /** Figures for the home side; null if our data source has none for it (it may cover only one side). */
  home: WinningOddsSide | null;
  /** Figures for the away side; null if our data source has none for it. */
  away: WinningOddsSide | null;
}

/** A side’s win price alongside the historical success rate of that price. */

export interface WinningOddsSide {
  /** The side’s win price that the figures are based on, fractional ("33/20"). Our data source chooses this pre-match price itself, so it may not match any current or opening price from GET /v2/fixtures/{id}/odds. */
  fractional: string | null;
  /** Decimal equivalent of that price (= 1 + fractional), rounded to two decimal places. */
  decimal: number | null;
  /** Implied probability of winning at this price, 0–100 (≈ 100 / decimal, rounded by our data source, with the bookmaker’s margin left in). Unit: percent. */
  expectedWinPercentage: number | null;
  /** Historical win rate for sides at this price, 0–100, from the data source’s own records (it discloses neither the sample size nor the time span). Unit: percent. */
  actualWinPercentage: number | null;
}

/** The markets a bookmaker prices next to a fixture's team streaks (GET /v2/fixtures/{id}/odds/streaks), supplied via our data source, in two lists: one for the recent-form streaks and one for the head-to-head streaks. A typical pairing puts the 2.5 match-goals or both-teams-to-score prices next to "More than 2.5 goals 9/10" or "Both teams scoring 7/7" for a side. The streaks themselves come from GET /v2/fixtures/{id}/streaks, and no market is bound to one particular streak. Mostly found on football fixtures in the larger leagues; elsewhere both lists are empty. Available since 2026-11-18. The prices come from a third party and are for information only; they are not advice or an offer to bet. 18+ only; please gamble responsibly. */

export interface StreakOdds {
  /** The fixture's id. */
  fixtureId: number;
  /** When we last fetched the prices (the source attaches no timestamp of its own); null when none are listed. */
  updatedAt: string | null;
  /** Markets priced next to the sides' recent-form streaks (the general list of GET /v2/fixtures/{id}/streaks), in the bookmaker's order with no market repeated, the featured one first; empty when none are listed. */
  general: OddsMarket[];
  /** Markets priced next to the head-to-head streaks (the headToHead list of GET /v2/fixtures/{id}/streaks), ordered the same way, the featured one first; empty when none are listed. */
  headToHead: OddsMarket[];
}

/** What the `livescores` channel published, one change at a time, stored for 7 days: goals and other score changes, red cards, kick-offs, period starts, breaks and final whistles. Each comes with the score and status that followed it and both sides’ names, so a ticker has something to show before its socket delivers a frame. */

export interface LiveWireEvent {
  /** The fixture’s id in our system (/v2/fixtures/{id}). */
  fixtureId: number;
  /** The sport slug, as listed by /v2/sports. */
  sport: string;
  /** The id we give the fixture’s league; null if it has none. */
  leagueId: number | null;
  /** What happened. A moment has exactly one kind: the first that fits, in the order score, redCard, finished, break, kickoff, period. */
  kind: LiveWireKind;
  /** The time we published this change on the `livescores` channel. */
  at: string;
  /** On a score or redCard moment, the side whose count moved, or null when both moved; every other kind carries null. */
  side: Side | null;
  /** The home side’s `current` score just after the change; null if the fixture had no score. */
  homeScore: number | null;
  /** The away side’s `current` score just after the change. */
  awayScore: number | null;
  /** The fixture’s status just after the change (`type`, `phase` and `period`, as on Fixture). */
  status: {
    type: StatusType;
    phase: StatusPhase;
    period: PeriodKey | null;
  };
  /** The home side; null until it is known. */
  home: LiveWireTeam | null;
  /** The away side; null until it is known. */
  away: LiveWireTeam | null;
}

/** One side of a live-wire moment, named as the fixture named it at that time. */

export interface LiveWireTeam {
  /** The team’s id in our system. */
  id: number;
  /** The team’s name (in individual sports the player, or both players of a doubles pair). */
  name: string;
}

/** Which tracking data a fixture holds. In football: a ball track and events recorded live (goals, shots, cards, set pieces, the flow of play), completed after the final whistle by the full event list including passes and positions, and since 2026-11-23 a timeline recorded live. In tennis: a live ball track and tracked events covering every serve and every point, and since 2026-11-23 a live match timeline. In basketball: a live timeline with shot spots and events read after the match. In ice hockey: a live timeline showing where the shots came from. In darts (since 2026-11-13): a live timeline of every dart and every visit. In table tennis (since 2026-11-24): a live timeline with every point and each game won. In American football (since 2026-11-24): a live timeline of every play with the ball’s spot, down and distance. In baseball (since 2026-11-27): a live timeline of every pitch and play, without positions. History starts on 2026-11-07 for every sport. */

export interface TrackingSummary {
  /** Fixture id issued by DataSportsAPI. */
  fixtureId: number;
  /** One of the eight sports with tracking data, as a slug (football, tennis, basketball, ice-hockey, darts, table-tennis, american-football, baseball); darts since 2026-11-13, table tennis and American football since 2026-11-24, baseball since 2026-11-27 (a timeline only). */
  sport: "football" | "tennis" | "basketball" | "ice-hockey" | "darts" | "table-tennis" | "american-football" | "baseball";
  /** The coordinate frame for this fixture, which depends on the sport; every x / y / z the tracking endpoints return is expressed in it. */
  coordinates: TrackingCoordinates;
  /** True once the match is over — finished, or ended another way (canceled, postponed, interrupted, abandoned); no further ball frames will be added. */
  final: boolean;
  /** True once the post-match data has been read, from a few minutes to an hour after the end; from then on the tracked events, the timeline and the player names are final. Until then football has only its live events — goals, shots, cards, substitutions, set pieces and the flow of play, with passes and most of the detail arriving in the post-match read — while basketball, ice hockey and darts have their live timeline (since 2026-11-13). */
  complete: boolean;
  /** Scheduled start of the match (since 2026-11-17): the fixture’s startTime, which it follows when the source reschedules the match (since 2026-11-24; it kept the first listed slot before). For the moment play really began, look for the kick-off / match_started event; darts and table tennis matches often begin away from their slot. */
  startedAt: string | null;
  /** Count of ball frames recorded so far (see GET /v2/fixtures/{id}/tracking/ball): about 14 per minute of football play, about one per tennis shot. They are captured live only, so a frame missed during play never turns up later. */
  ballFrames: number;
  /** Count of events served by GET /v2/fixtures/{id}/tracking/events so far. */
  events: number;
  /** Number of events on the timeline (see GET /v2/fixtures/{id}/tracking/timeline). Darts, basketball and ice hockey have them, as do football and tennis since 2026-11-23 table tennis and American football since 2026-11-24 and baseball since 2026-11-27, when the match was recorded live. */
  timelineEvents: number;
}

/** A spot expressed in the coordinate frame of the fixture (see TrackingSummary.coordinates). */

export interface TrackingSpot {
  /** Position along the pitch, court or rink, in the fixture’s frame (TrackingCoordinates). */
  x: number;
  /** Position across the pitch, court or rink, in that same frame. */
  y: number;
  /** Height of the tennis ball above the court in millimetres (tennis ball positions only); null elsewhere. */
  z: number | null;
}

/** One position from the live ball track (tennis and football). */

export interface BallFrame {
  /** Moment the ball was recorded at this spot, to the millisecond. */
  at: string;
  /** Position along the pitch or court in the fixture’s frame (0–100 in football, millimetres in tennis); null when no position came from the source. */
  x: number | null;
  /** Position across it, in the same frame. In football it runs the same way as the tracked events’ position.y (since 2026-11-13). */
  y: number | null;
}

/** One entry of the tracked play-by-play, with where it happened (football, tennis, basketball). Tennis and football are delivered live — football roughly 9 seconds after the moment (about 15 at most) for goals, shots, cards, substitutions, set pieces and the flow of play, while passes and most of the detail follow in the post-match read. Basketball events mostly come later, with the post-match read of the data. */

export interface TrackedEvent {
  /** Key that identifies the event within the fixture and never changes; REST and WebSocket use the same key. */
  key: string;
  /** What happened, in camelCase. Football: goal, attemptAtGoal, pass, cross, dribble, corner, freeKick, throwIn, goalKick, penalty, foul, offside, duel, tackle, interception, clearance, block, save, yellowCard, secondYellowCard, redCard, substitution; flowAttack / flowDangerousAttack / flowBallSafe describe the flow of play (side is the team in possession, position is where the ball is — together, the live state of the match); possibleCorner / possibleGoal / possiblePenalty (and the matching …Cancelled types) mark a decision still pending; possessionChange has no side; also kickOff, periodStatus, injuryTime, injury, backFromInjury, interruptionStart / interruptionOver, videoReview and more. Tennis: serve, fault, let, point, challenge, ballSituation (where the ball is), playerSituation (where a player is) and more. Basketball: freeThrow, twoPointer, threePointer, rebound, steal, block, turnover, foul, possessionChange, substitutionIn / substitutionOut, timeoutStart, periodStatus and more. Further types may appear; ignore any you do not recognise, or show it as information only. */
  type: string;
  /** Moment of the event. */
  at: string | null;
  /** Side credited with the event; null for neutral ones such as a period change or a loose ball. */
  side: Side | null;
  /** Football: match minute. Null for other sports. Unit: minutes. */
  minute: number | null;
  /** Football: match clock in seconds. Null for other sports. Unit: seconds. */
  second: number | null;
  /** Basketball: period in which it happened (period1…period4, overtime). Null for other sports. */
  period: PeriodKey | null;
  /** Tennis: set number. */
  set: number | null;
  /** Tennis: game number in the set. */
  game: number | null;
  /** Location of the event: for football (pass origin, shot, foul, …) and basketball (shot, foul, rebound, …) on the 0–100 frame; for tennis ballSituation / playerSituation in millimetres, with z as the ball’s height. Null when the source gives no spot. */
  position: TrackingSpot | null;
  /** Football passes: the spot the ball was played to. */
  endPosition: TrackingSpot | null;
  /** Who performed it, if the source names someone the squad list contains. */
  player: TrackedPlayer | null;
  /** Football goals: who provided the assist. */
  assist: TrackedPlayer | null;
  /** Football substitutions: who came on. */
  playerIn: TrackedPlayer | null;
  /** Football substitutions: who went off. */
  playerOut: TrackedPlayer | null;
  /** Result, in camelCase: complete / incomplete for passes; onTarget, offTarget, blocked, woodwork, deflectedOffTarget and more for shots; made / missed in basketball. */
  outcome: string | null;
  /** Football goals: how it was scored, in camelCase (shot, header, ownGoal, penalty, …). */
  goalType: string | null;
  /** Tennis points: who was serving. */
  serving: Side | null;
  /** Tennis points: the score in the game once the point was played. */
  gameScore: TennisGameScore | null;
  /** Tennis points: how the point was won, in camelCase (standard, ace, doubleFault, …). */
  pointOutcome: string | null;
  /** Tennis points: number of shots in the rally, when provided. */
  shots: number | null;
}

/** A player that a tracked event names, taken from the match squad. There is no id: tracked players are not linked to DataSportsAPI player ids. */

export interface TrackedPlayer {
  /** Name as displayed, given name first. */
  name: string;
  /** Number on their shirt in this match. */
  shirtNumber: number | null;
  /** Which side the player is on. */
  side: Side | null;
}

/** The score within a tennis game after a point. */

export interface TennisGameScore {
  /** Home side’s points in the current game — 0, 15, 30, 40 or A (advantage) — or the tie-break count. */
  home: string;
  /** Points of the away side in the game. */
  away: string;
}

/** One entry of a match timeline in basketball, ice hockey or darts, since 2026-11-23 football and tennis, since 2026-11-24 table tennis and American football, and since 2026-11-27 baseball: shots with where they were taken, saves, penalties, goals, set pieces and periods, and in darts each dart and each visit. Live since 2026-11-13, roughly 5 seconds after the moment (football and tennis about 1–2 seconds; also pushed as timelineEvent frames on tracking:{id}); the source can still revise or withdraw an event afterwards. Events the source withdrew are not included. Football and tennis timelines exist only for matches captured live. */

export interface TimelineEvent {
  /** Key that identifies the event within the fixture and never changes. */
  key: string;
  /** Event type as the source names it, in camelCase. Football (since 2026-11-23): goal, shotOnTarget, shotOffTarget, shotBlocked, goalkeeperSaved, corner, freeKick, freeKickTaken, throwIn, goalKick, offside, card (name says which: Yellow card, Red card …), substitution, videoAssistantReferee, possibleEvent, penaltyRewarded, injury, backFromInjury, temporaryInterruption, gameOn, injuryTimeShown, periodStart, periodBreak, periodScore and more. Tennis (since 2026-11-23): serviceTaken, firstServeFault, scoreChangeTennis, ballInPlay, matchAboutToStart, matchEnded, periodStart, periodScore and more. Basketball: goal (a made basket; points gives its value), attemptMissed, freeThrowsAwarded, rebound, block, stealBasket, turnoverBasket, foul, wonJumpBall, timeout, tvTimeoutStart / tvTimeoutStop, videoReview, periodStart, periodScore, matchStarted, matchEnded and more. Ice hockey: goal, canceledEvent (a goal that was taken back), shotOnTarget, goalkeeperSaved, shotOffTarget, shotBlocked, faceoff, giveaway, takeaway, hit, suspension (a penalty; penaltyMinutes gives its length), suspensionOver, delayedPenalty, emptyNet, emptyNetOver, playResumesAfterGoal, timeout, periodStart, periodBreak (an intermission, or the wait before overtime; period is null), periodScore, penalty (a shoot-out attempt, with homeScore / awayScore giving the shoot-out score once it is taken), penaltyRewarded / penaltyMissed (penalty shots) and more. Darts (since 2026-11-13; the detail is in darts): dartThrow (a single dart), visit (a turn at the board, at most three darts), checkout (the visit that closed out the leg), legWon (homeScore / awayScore count legs), setWon, matchWon, throwsFirst, periodStart, matchStarted, matchEnded. Table tennis (since 2026-11-24; the detail is in tableTennis): point (side won it; homeScore / awayScore count games), gameWon, firstServer, let, timeout, timeoutOver, ballInPlay, periodStart, periodBreak, periodScore (the closing summary, in games), playersWarmingUp, playersOnPitch, matchAboutToStart, matchStarted, matchEnded, card. American football (since 2026-11-24; the detail is in americanFootball): pass, rush, sack, kickoff, punt, fieldGoal, extraPoint, twoPointConversion, touchdown (points 6), safety, goal (the score once a scoring play is counted, in homeScore / awayScore), interception, turnoverOnDowns, fumble, penalty, playStart, playOver, driveStart, driveOver, firstDown, kickoffWait / kickoffWaitOver (side is the kicking team), kickoffTeam, coinToss, timeout, timeoutOver, tvTimeoutStart / tvTimeoutStop, videoReview (name “Video review” or “Video review over”), challenge, periodStart, periodScore, matchStarted, matchEnded. Baseball (since 2026-11-27; the detail is in baseball): playStart and playOver (the beginning and end of a plate appearance), ball, strike, foulBall, ballInPlay, batterAdvance, runnerAdvance, batterOut, runnerOut, runScored, goal (the score once a run counts, in homeScore / awayScore), runnerChecked, runnersInMotion, halfInningStart, firstPitch (side is the team that pitches first), periodStart (period holds the inning), periodScore, matchAboutToStart, matchStarted, matchEnded. Other types may be added. */
  type: string;
  /** The source’s English label for the event (“Goalie save”, “1st period”, “2 pt scored”). */
  name: string | null;
  /** Moment of the event. */
  at: string | null;
  /** Side credited with the event; null when neutral. */
  side: Side | null;
  /** Game minute. Unit: minutes. */
  minute: number | null;
  /** Game clock, in seconds from the start. Unit: seconds. */
  second: number | null;
  /** For periodStart / periodScore: the number of the period. */
  period: number | null;
  /** Where the shot or event happened, 0–100, in a frame where home plays towards x = 100 and away towards x = 0 for the whole match (TrackingCoordinates court, rink or pitch). In ice hockey and basketball no attack direction comes from the source, so for each side and period, when that side’s shots sit in the wrong half (x < 50 for home, x > 50 for away), all its positions in that period are mirrored (x → 100 − x, y → 100 − y); when a side has no shots in a period, it borrows the direction from the other side and from the adjacent periods. In football (since 2026-11-23) and basketball (since 2026-11-27) the source counts y from the opposite side to the one its tracked events use, so we serve 100 − y: a spot then carries the same y here as in /tracking/events (and, for football, the ball track). Football spots are never mirrored; a touchline restart sits at y 0 or 100 and a corner kick at x 0 or 100. Null if no spot is given. */
  position: TrackingSpot | null;
  /** Name of the player involved (the scorer of a goal), with the first name first, if the source gives a name. */
  player: string | null;
  /** Names of the players credited with assists on a goal, in order. */
  assists: string[];
  /** Basketball: what the shot was worth (1, 2 or 3). */
  points: number | null;
  /** Ice hockey suspensions: length of the penalty. Unit: minutes. */
  penaltyMinutes: number | null;
  /** Home side’s score once the event is applied (goals, period scores, end of match). On a shoot-out attempt in ice hockey (type penalty) it is the shoot-out tally after that attempt (since 2026-11-13). */
  homeScore: number | null;
  /** Away side’s score once the event is applied. */
  awayScore: number | null;
  /** Darts (since 2026-11-13): the dart or the visit. Null for other sports, and for darts events that are not a dart or a visit. */
  darts: TimelineDarts | null;
  /** Table tennis (since 2026-11-24): the point, or the game won. Null in other sports and on table tennis events of other types. */
  tableTennis: TimelineTableTennis | null;
  /** American football (since 2026-11-24): where the ball is, the down and the yards to go, plus, for a play, how it ended, the yards gained and who took part. Null for every other sport and for events without any of this. */
  americanFootball: TimelineAmericanFootball | null;
  /** Baseball (since 2026-11-27): the count, the outs and the occupied bases after the event, plus a runner’s move and the runs it brought in where that applies. Null for every other sport and for baseball events that carry none of it. */
  baseball: TimelineBaseball | null;
}

/** Darts detail on a timeline entry (since 2026-11-13): either one dart (dartThrow) or one visit together with what it settled (visit, checkout, setWon, matchWon); any field that does not apply is null. Some competitions only report visits, without the individual darts. */

export interface TimelineDarts {
  /** dartThrow: points the dart scored (0 – 60). visit / checkout: total of the visit (0 – 180). */
  score: number | null;
  /** dartThrow: the segment number hit (1 – 20, or 25 for the bull); null when the dart missed. */
  number: number | null;
  /** dartThrow: 1 for a single, 2 for a double or the bullseye, 3 for a treble, 0 for a miss. */
  multiplier: number | null;
  /** dartThrow: the part of the board it landed in. */
  ring: DartsRing | null;
  /** dartThrow in a single (since 2026-11-13): which single bed it hit, inner (from the outer bull to the treble) or outer (from the treble to the double), as reported by the source. Null for any other ring, any other event type, and a single the source does not locate. */
  bed: DartsBed | null;
  /** dartThrow: true when the dart was aimed at a finishing double. */
  doubleAttempt: boolean | null;
  /** visit / checkout: how many darts the visit used (1 – 3). */
  dartsThrown: number | null;
  /** checkout: the double that won the leg (16 means double 16, 25 the bullseye). */
  checkoutDouble: number | null;
  /** visit: points each side still needs in this leg once the visit is counted. */
  remaining: DartsScore | null;
  /** visit / checkout / setWon / matchWon: legs won so far, counted within the current set if the match uses sets. */
  legs: DartsScore | null;
  /** visit / checkout / setWon / matchWon: number of sets won; a legs-only match counts as one single set. */
  sets: DartsScore | null;
}

/** A darts figure for each side: points left, legs or sets. */

export interface DartsScore {
  /** Value for the home side. */
  home: number;
  /** Value for the away side. */
  away: number;
}

/** Table tennis detail on a timeline entry (since 2026-11-24). A point (type point, side = the player who won it) carries the score it left behind; a game won (gameWon) carries the games. Fields that do not apply are null. Where the source says set, we say game. */

export interface TimelineTableTennis {
  /** point: the game it was played in, counting from 1. */
  game: number | null;
  /** point: the score within the game once the point is counted (11 : 9, say). */
  points: TableTennisScore | null;
  /** point / gameWon: games won by each side after it; the point that ends a game already counts that game. */
  games: TableTennisScore | null;
  /** point: the side serving the next point. */
  nextServer: Side | null;
  /** point: whether it set up a game or match point, or won the game or the match; null for an ordinary point. */
  flag: TableTennisPointFlag | null;
}

/** A table tennis figure for each side: points within a game, or games won. */

export interface TableTennisScore {
  /** Value for the home side. */
  home: number;
  /** Value for the away side. */
  away: number;
}

/** American football detail on a timeline entry (since 2026-11-24): where the ball is, the down and the distance, and for a play what came of it, how many yards and who took part. Fields that do not apply are null. The source revises a play as it learns more (outcome, yards, names), and every revision comes as an upsert under the same key. */

export interface TimelineAmericanFootball {
  /** The team the source gives the row to: the offense on a scrimmage play, the receiving team on a kickoff. */
  possession: Side | null;
  /** The ball’s position in yards from the home goal line, 0–100 (TrackingCoordinates field). On playStart it is the line of scrimmage at the snap; on playOver, where the next play begins. Rows for the play itself (pass, rush, kickoff …) hold whatever the source last revised them to, which is mostly the position after the play; to animate a play, run from its playStart to the playOver that follows. */
  spot: number | null;
  /** The down at that spot, 1–4; null on kickoffs and tries. */
  down: number | null;
  /** Yards still needed for a first down (on goal to go, the distance to the goal line); null on kickoffs and tries. */
  yardsToGo: number | null;
  /** playStart: the play’s number within its drive, 0 being the kickoff. */
  playNumber: number | null;
  /** driveStart, driveOver, firstDown: which drive of the game this is. */
  driveNumber: number | null;
  /** driveOver, firstDown: plays run in the drive so far. */
  playCount: number | null;
  /** How the play ended; null while the source has not said (a pass often arrives without one and is revised later). */
  outcome: AmericanFootballOutcome | null;
  /** pass / rush: yards gained, negative for a loss; punt: the length of the kick; penalty: the yards marked off. */
  yards: number | null;
  /** penalty: true when the down is played again. */
  noPlay: boolean | null;
  /** The players the source names for the play, each with a role, in its order. Names only: there is never an id. */
  players: AmericanFootballPlayer[];
}

/** Baseball detail on a timeline entry (since 2026-11-27). The timeline follows the game pitch by pitch and holds no coordinates; each entry says how the count, the outs and the bases stand once it has happened. Anything the event does not concern is left null. */

export interface TimelineBaseball {
  /** Balls in the current batter’s count after the pitch or play. */
  balls: number | null;
  /** Strikes in the current batter’s count after it. */
  strikes: number | null;
  /** Outs recorded in this half inning after it. */
  outs: number | null;
  /** Which bases hold a runner once a base changes or a play ends. */
  bases: BaseballBases | null;
  /** batterAdvance, runnerAdvance, runScored: the base the runner started from, 0 being home plate; runnerOut, runnerChecked: the base concerned. */
  from: number | null;
  /** batterAdvance, runnerAdvance: the base the runner got to. */
  to: number | null;
  /** runScored: how many runs came in. */
  runs: number | null;
  /** halfInningStart: the half that begins. */
  half: BaseballHalf | null;
  /** How the source labels the pitch, play, out or run, written in camelCase, for example single, double, homeRun, walk, steal, groundOut, flyOut, strikeOut or earnedRun. Labels beyond these can turn up; an event that comes without a label has null here. */
  kind: string | null;
}

/** The three bases and whether a runner stands on each. */

export interface BaseballBases {
  /** True with a runner on first. */
  first: boolean;
  /** True with a runner on second. */
  second: boolean;
  /** True with a runner on third. */
  third: boolean;
}

/** Someone who features in an American football play, given by name and role only; there is no id. */

export interface AmericanFootballPlayer {
  /** What the player did in the play. */
  role: AmericanFootballRole;
  /** Full name, first name first. */
  name: string;
}

/** Snapshot of a tracking:{id} channel: the summary and the most recent ball frames, tracked events and timeline entries; anything older is available over REST. */

export interface TrackingSnapshot {
  /** Fixture id issued by DataSportsAPI. */
  fixtureId: number;
  /** What has been recorded for the fixture so far; null while nothing is recorded yet (an untracked match, or one that has not started). */
  tracking: TrackingSummary | null;
  /** The latest ball frames, at most 100, oldest first. */
  ball: BallFrame[];
  /** The latest tracked events, at most 100, oldest first. */
  events: TrackedEvent[];
  /** Since 2026-11-13: the latest timeline events, at most 100, oldest first, in basketball, ice hockey and darts, since 2026-11-23 in football and tennis, since 2026-11-24 in table tennis and American football, and since 2026-11-27 in baseball; an empty list when the match has no timeline. */
  timeline: TimelineEvent[];
}

/** The server sends this frame first, as soon as the connection opens. */

export interface WsWelcome {
  type: "welcome";
  /** Version of the protocol in use. It has been 5 since 2026-11-19 (the race:{id} snapshot carries the sessions, race frames no longer do, and raceSessions frames deliver changes to them); it was 4 from the evening of 2026-10-23 (since then a fixture that joins a list channel comes in a `fixture` frame); protocol 3 dates from earlier on 2026-10-23 and protocol 2 from 2026-10-19. Channels and frame types are added without changing this number (odds:{id} on 2026-11-04, tracking:{id} on 2026-11-12, the timelineEvent frame on tracking:{id} on 2026-11-13), so skip any frame type you do not recognise. */
  protocol: number;
  /** Interval between server pings. Reply to them (browsers do this automatically) or the connection is closed. */
  heartbeatMs: number;
  /** Maximum number of channels this connection may subscribe to. */
  maxChannels: number;
  /** True when your plan includes `lastSeq` replay. */
  replay: boolean;
}

/** The complete current state of a channel, delivered when you subscribe and again whenever you resync. */

export interface WsSnapshot {
  type: "snapshot";
  channel: string;
  /** Current sequence number of the channel. Treat it as an opaque, increasing counter that does not start at 0; the following delta carries seq + 1. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Depends on the channel. livescores / sport:{slug} / league:{id} / team:{id} carry a Fixture[]: for league:{id}, that league’s in-progress fixtures; for team:{id} (since 2026-11-04), that team’s in-progress fixtures, home and away. fixture:{id} carries a Fixture and race:{id} a RaceSnapshot; odds:{id} (since 2026-11-04) carries an Odds matching GET /v2/fixtures/{id}/odds, and tracking:{id} (since 2026-11-12) a TrackingSnapshot. Each of these four is null when there is no data. */
  data: Fixture[] | Fixture | RaceSnapshot | Odds | TrackingSnapshot | null;
}

/** Sent when a single fixture changes. On the four list channels (livescores, sport:{slug}, league:{id}, team:{id}), every delta concerns a fixture the channel already sent you, either in its snapshot or as a `fixture` frame, and a fixture that drops out of the channel (finished, canceled) receives one final delta reporting that. Deltas cover both live-feed updates and the corrections a board refresh produces. A score that goes DOWN (a goal disallowed, a basket corrected) is passed on as soon as the source sends it, exactly like a rise; when the source briefly re-sends an older score and then restores the right one, you receive both deltas (since 2026-11-18 — before that a drop was held for up to 1.5 s and such flaps were swallowed). A REST refetch of /fixtures/{id} may still be a few seconds ahead, so resync from time to time if you need exact values. */

export interface WsDelta {
  type: "delta";
  channel: string;
  /** One more than the previous seq on this channel. A gap means you lost a delta — send resync. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: string;
  /** A partial Fixture that uses the same field names and nesting as the full object. Deep-merge it into the Fixture you store: objects are merged key by key, while every other value (null included) overwrites what you have. No fields beyond those listed for FixturePatch are ever sent. */
  changes: FixturePatch;
}

/** On the four list channels (livescores, sport:{slug}, league:{id}, team:{id}): the channel’s set gained a fixture — after kick-off, or when the server first sees it. The frame carries the complete Fixture, exactly as a snapshot would contain it. Append it to your list and apply subsequent deltas to it. fixture:{id} channels never receive this frame. */

export interface WsFixture {
  type: "fixture";
  channel: string;
  /** One more than the previous seq on this channel; the counter is shared with deltas. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: string;
  /** A match, in the same shape used by every endpoint and by WebSocket snapshots. */
  data: Fixture;
}

/** Acknowledges a subscribe that produced no snapshot: either a `lastSeq` replay (sent once the replayed frames have gone out) or a repeat subscribe to a channel you already hold. */

export interface WsSubscribed {
  type: "subscribed";
  channel: string;
  /** Current seq of the channel once the replay is done; the following delta carries seq + 1. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Number of frames the replay delivered. 0 means you missed nothing, or that you were already subscribed to the channel. */
  replayed: number;
}

/** On fixture:{id} channels for fixtures in play: the list of match events (goals, cards, substitutions, VAR decisions, periods, …) has changed. Because the live feed contains no events, the server pulls them from REST: 2 s after every change of score, red card or period, then again 10, 20, 45 and 90 s later, and every 10 s throughout play, since cards and substitutions trigger no signal (this schedule has applied since 2026-11-20). Most of the delay you still see is the source’s own: a goal shows up in its event list only 18–33 s once the score has moved. A frame goes out only when the list differs. A disallowed goal shows up in `changes.removed`, and only after REST has confirmed it. Each frame holds the complete list, so missing one does no harm; fetch GET /v2/fixtures/{id}/events for the state before the first frame arrives. */

export interface WsEvents {
  type: "events";
  channel: string;
  /** One more than the previous seq on this channel; the channel’s deltas use the same counter. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: string;
  /** The FULL events list as it stands, in chronological order — the incidents GET /v2/fixtures/{id}/events returns, keys included. Replace your copy with it. */
  events: KeyedIncident[];
  /** The difference between this events frame and the one before it. */
  changes: IncidentChanges;
}

/** On fixture:{id} channels for fixtures in play: the match statistics have changed, and the frame carries the complete object as returned by GET /v2/fixtures/{id}/statistics. The server reads REST every 10 s while at least one client is subscribed (every 30 s before 2026-11-18), plus a final read after full time, and emits a frame only when the content differs, so a change typically reaches you within about 10 s of the source listing it. */

export interface WsStatistics {
  type: "statistics";
  channel: string;
  /** One more than the previous seq on this channel; the channel’s deltas use the same counter. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: string;
  /** The match statistics, broken down by period. */
  statistics: Statistics;
}

/** On fixture:{id} channels for fixtures in play: the lineups have changed. The frame carries the whole object that GET /v2/fixtures/{id}/lineups returns, including each player’s statistics. While someone is subscribed the server checks every 10 s (every 30 s before 2026-11-18), stopping once the lineups are confirmed and have stayed the same for 10 minutes. Substitutions are delivered as events instead. */

export interface WsLineups {
  type: "lineups";
  channel: string;
  /** One more than the previous seq on this channel; the channel’s deltas use the same counter. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: string;
  /** The lineups for each side. */
  lineups: Lineups;
}

/** On fixture:{id} channels, while a football, basketball or American football (since 2026-11-25) match is live: lines were added to or edited in the play-by-play text from our data source. While at least one client is subscribed the server re-reads REST every 10 s (every 20 s before 2026-11-18; the source’s own page updates every 15–20 s), and once more after full time. A frame is sent only when the list differs, and it starts at the first entry that changed. For the state before the first frame, call GET /v2/fixtures/{id}/play-by-play. */

export interface WsPlayByPlay {
  type: "playByPlay";
  channel: string;
  /** One more than the previous seq on this channel; the channel’s deltas use the same counter. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: string;
  /** 0-based position, in the full list, of the first item in `entries`. Retain your first `start` entries, discard everything after them and append `entries`. Normally equal to the length of your list (new lines added at the end); lower when the source edited or deleted a line. */
  start: number;
  /** Current length of the full list (start + entries.length). If `start` is beyond the end of your list, you are out of sync — reload GET /v2/fixtures/{id}/play-by-play. */
  total: number;
  /** Entries from position `start` onwards, oldest first, in the form GET /v2/fixtures/{id}/play-by-play returns them. */
  entries: PlayByPlayEntry[];
  /** American football: the complete drive list as it stands, to replace what you hold; an empty list in other sports. Available since 2026-11-25. */
  drives: PlayByPlayDrive[];
}

/** On fixture:{id} channels for football fixtures in play: the momentum graph has changed. The frame holds the complete object as returned by GET /v2/fixtures/{id}/momentum; with one point per minute, expect roughly one frame a minute. While anyone is subscribed the server checks every 10 s (since 2026-11-20), and once more after full time, and only sends a frame if something changed. */

export interface WsMomentum {
  type: "momentum";
  channel: string;
  /** One more than the previous seq on this channel; the channel’s deltas use the same counter. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: string;
  /** The momentum graph: a value per game in tennis, or per minute in football, basketball, handball, ice hockey and the like. */
  momentum: Momentum;
}

/** On fixture:{id} channels for football fixtures in play: the shot map has changed, through either a new shot or a correction by the source. While anyone is subscribed the server checks every 10 s (since 2026-11-20), once more after full time, and only sends a frame if something changed; a new shot typically reaches you about 10 s after the source lists it. */

export interface WsShotmap {
  type: "shotmap";
  channel: string;
  /** One more than the previous seq on this channel; the channel’s deltas use the same counter. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: string;
  /** The current shot map in FULL, oldest first, as returned by GET /v2/fixtures/{id}/shotmap. Overwrite your copy with it. */
  shots: Shot[];
}

/** On race:{id}: the race itself was updated, for example its status, winner or dates. The frame carries the complete Race as returned by GET /v2/races/{id}; since protocol 5 it has no sessions, which arrive in raceSessions frames instead. Since the live feed has no data for race sports, the server reads REST every 10 s (every 60 s until 2026-11-22) while a session is running or due to begin within 15 minutes. */

export interface WsRace {
  type: "race";
  channel: string;
  /** One more than the previous seq on this channel. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Race id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the race’s sport (motorsport, cycling). */
  sport: string;
  /** Covers either a motorsport weekend (with practice, qualifying, sprint and race sessions) or a cycling event — a one-day race or a stage race. The sessions themselves come from /v2/races/{id}/sessions. */
  data: Race;
}

/** On race:{id}: a session has started or finished, or its timing has shifted. The server reads REST on the same schedule as the race frame (every 10 s while a session is running or due to begin within 15 minutes) and only sends a frame when the list differs. Available since protocol 5. */

export interface WsRaceSessions {
  type: "raceSessions";
  channel: string;
  /** One more than the previous seq on this channel. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Race id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the race’s sport. */
  sport: string;
  /** The complete session list, as returned by GET /v2/races/{id}/sessions — replace the list you hold with it. */
  sessions: RaceSession[];
}

/** On race:{id}: the classification of a session has changed — the running session, or one of its parts (each part gets its own frames). The server checks every 2 s while the session is running (since 2026-11-22; every 10 s before) and then, for 30 minutes after it ends, every 60 s, because the source adds the winner’s time and the fastest lap only minutes after the flag. A frame is sent only when something differs. */

export interface WsRaceResults {
  type: "raceResults";
  channel: string;
  /** One more than the previous seq on this channel. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Race id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the race’s sport. */
  sport: string;
  /** The session this classification belongs to; for a part’s table, the part’s id. */
  session: number | null;
  /** The full classification of the session, as returned by /v2/races/{id}/results?session=. */
  results: RaceResult[];
}

/** On odds:{fixtureId}: prices have moved (available since 2026-11-04). Price changes, both in-play and pre-match, come from the source’s live odds feed and reach you within roughly a second. Suspensions, newly added markets and settlement flags rely on a REST re-read, every 30 s during the match and every 2 minutes beforehand. Hold on to the snapshot (an Odds, as returned by GET /v2/fixtures/{id}/odds) and merge every frame into it by market `key`. Odds travel exclusively on `odds:{id}`; no other channel includes them. */

export interface WsOdds {
  type: "odds";
  channel: string;
  /** One more than the previous seq on this channel. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: string;
  /** Time at which these prices came in. */
  updatedAt: string;
  /** Markets that changed, each sent in FULL with all its choices. Swap out your market with the matching `key`, or add it if you do not have one yet. */
  markets: OddsMarket[];
  /** Keys of markets the bookmaker has withdrawn (for example a handicap line that moved, or a closed market). Remove them from your copy. */
  removed: string[];
}

/** On tracking:{fixtureId} (since 2026-11-12): one new position of the live ball track — about 14 a minute of football play, about one per tennis shot — sent within roughly a second after the source records it. Add it to the end of the ball list you got with the snapshot. */

export interface WsBall {
  type: "ball";
  channel: string;
  /** One more than the previous seq on this channel. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: "football" | "tennis" | "basketball" | "ice-hockey" | "darts" | "table-tennis" | "american-football" | "baseball";
  /** The new position of the ball (football, tennis). */
  frame: BallFrame;
}

/** On tracking:{fixtureId} (since 2026-11-12): one more tracked event. Tennis sends each serve, point, ball position and player position live. Football sends, live and about 18 a minute, its goals, shots, cards, substitutions, set pieces and the flow-of-play types (possessionChange, flowAttack, flowDangerousAttack, flowBallSafe), then the passes in one burst with the post-match read. Basketball events come mostly in that burst. Keep events keyed by key; receiving a key you already have means the same event again. */

export interface WsTrackedEvent {
  type: "trackedEvent";
  channel: string;
  /** One more than the previous seq on this channel. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: "football" | "tennis" | "basketball" | "ice-hockey" | "darts" | "table-tennis" | "american-football" | "baseball";
  /** A tracked play-by-play event and where on the pitch or court it happened (football, tennis, basketball). Tennis events are sent live; football ones too, usually some 9 seconds behind play and rarely past 15 (goals, shots, cards, substitutions, set pieces and the flow of play, while passes and finer detail follow with the post-match read). Basketball events mostly come with the post-match read. */
  event: TrackedEvent;
}

/** On tracking:{fixtureId} (since 2026-11-13): one timeline event — basketball, ice hockey and darts, football and tennis since 2026-11-23, table tennis and American football since 2026-11-24 — roughly 5 seconds after the moment in the first three and about a second in the others (about 4 – 8 a minute in basketball, about 25 – 30 in darts). With upsert, add it or overwrite the one under the same key (a revision; earlier positions in a period can shift once its shots show which way the side attacks); with remove, the source has withdrawn it. Start from the snapshot’s timeline and apply every frame by key. */

export interface WsTimelineEvent {
  type: "timelineEvent";
  channel: string;
  /** One more than the previous seq on this channel. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: "football" | "tennis" | "basketball" | "ice-hockey" | "darts" | "table-tennis" | "american-football" | "baseball";
  /** How this frame changes the timeline you keep. */
  op: TimelineOp;
  /** Key of the event (TimelineEvent.key) to add, overwrite or delete. */
  key: string;
  /** For upsert, the event; null for remove. */
  event: TimelineEvent | null;
}

/** On tracking:{fixtureId} (since 2026-11-12): sent when the match ends (final) and again when its post-match data has been read (complete). */

export interface WsTrackingStatus {
  type: "trackingStatus";
  channel: string;
  /** One more than the previous seq on this channel. */
  seq: number;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
  /** Fixture id assigned by DataSportsAPI. */
  id: number;
  /** Slug of the fixture’s sport. */
  sport: "football" | "tennis" | "basketball" | "ice-hockey" | "darts" | "table-tennis" | "american-football" | "baseball";
  /** The match has ended; the ball track is closed. */
  final: boolean;
  /** The post-match data has been read: call the REST tracking endpoints again to get the settled events, timeline and player names. */
  complete: boolean;
}

/** Acknowledges that you have left a channel. */

export interface WsUnsubscribed {
  type: "unsubscribed";
  channel: string;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
}

/** Heartbeat at the application level, emitted every heartbeatMs alongside the protocol-level ping. You do not need to answer it. */

export interface WsPing {
  type: "ping";
  /** Server timestamp in Unix milliseconds. */
  ts: number;
}

/** The server’s answer to a { "type": "ping" } you sent. */

export interface WsPong {
  type: "pong";
  /** Server timestamp in Unix milliseconds. */
  ts: number;
}

/** The server rejected a frame you sent. Your connection remains open. */

export interface WsError {
  type: "error";
  /** Machine-readable code of the WebSocket error. */
  code: WsErrorCode;
  message: string;
  channel?: string;
  /** Server timestamp in Unix milliseconds. */
  ts: number;
}

/** One of the two sides in a fixture. */

export type Side = "home" | "away";

/** Basketball and American football: what kind of timeout is in progress. */

export type TimeoutType = "team" | "challenge" | "other";

/** Whether the fans’ vote for player of the match is still running. */

export type PlayerOfTheMatchStatus = "open" | "closed";

/** What one line of a player’s last twelve months records. */

export type PlayerYearEntryType = "match" | "bench" | "missing" | "injury" | "transfer";

/** Why a player missed a match. */

export type PlayerMissingReason = "injury" | "suspension" | "other";

/** Outcome of a fixture that has finished. */

export type Winner = "home" | "away" | "draw";

/** High-level state of a match, meant for filtering. */

export type StatusType = "notstarted" | "inprogress" | "interrupted" | "willcontinue" | "postponed" | "canceled" | "finished";

/** Detailed match state, as a scoreboard would display it. */

export type StatusPhase = "notstarted" | "delayed" | "inprogress" | "break" | "awaitingResult" | "interrupted" | "suspended" | "willcontinue" | "postponed" | "canceled" | "abandoned" | "finished";

/** The way a completed match was settled. */

export type FinishType = "regular" | "overtime" | "penalties" | "goldenSet" | "walkover" | "retired" | "defaulted";

/** A level our data source assigns to a fixture’s competition (Fixture.levels). */

export type FixtureLevel = "topCompetitions" | "pro" | "contributor" | "youth" | "other";

/** The way a fight was decided. */

export type FightMethod = "ko" | "tko" | "submission" | "unanimousDecision" | "splitDecision" | "majorityDecision" | "technicalDecision" | "pointsDecision" | "disqualification" | "noContest" | "other";

/** Tennis: whether a match is singles, doubles or a team tie. */

export type MatchDiscipline = "singles" | "doubles" | "team";

/** Which combat sport a fight belongs to. */

export type FightDiscipline = "mma" | "boxing" | "kickboxing" | "muayThai" | "grappling" | "other";

/** Surface of a tennis court. */

export type SurfaceType = "hard" | "clay" | "grass" | "carpet" | "other";

/** The choice made by the side that won a cricket toss. */

export type TossDecision = "bat" | "bowl";

/** Which section of a fight card a bout belongs to. */

export type FightCardSection = "mainCard" | "prelims" | "earlyPrelims" | "other";

/** American football: what type of play the ball is spotted for. */

export type DownPlayType = "scrimmage" | "kickoff" | "conversion" | "other";

/** What happened at a live-wire moment. Each moment has exactly one kind: the first that fits, in the order score, redCard, finished, break, kickoff, period. */

export type LiveWireKind = "score" | "redCard" | "kickoff" | "period" | "break" | "finished";

/** Where a player plays, defined per sport; `positionCode` keeps the source’s letter code. */

export type Position = "goalkeeper" | "defender" | "midfielder" | "forward" | "guard" | "center" | "guardForward" | "forwardCenter" | "goalie" | "defenseman" | "leftWing" | "rightWing" | "leftBack" | "rightBack" | "centreBack" | "pivot" | "quarterback" | "runningBack" | "wideReceiver" | "tightEnd" | "offensiveLineman" | "offensiveTackle" | "offensiveGuard" | "defensiveTackle" | "defensiveEnd" | "defensiveLineman" | "linebacker" | "cornerback" | "safety" | "defensiveBack" | "kicker" | "punter" | "longSnapper" | "pitcher" | "startingPitcher" | "reliefPitcher" | "catcher" | "firstBase" | "secondBase" | "thirdBase" | "shortstop" | "leftField" | "centerField" | "rightField" | "infielder" | "outfielder" | "designatedHitter" | "batter" | "bowler" | "allRounder" | "wicketKeeper" | "back" | "outsideHitter" | "opposite" | "middleBlocker" | "setter" | "libero" | "top" | "jungle" | "mid" | "bot" | "support" | "other";

/** Tells whether an absent player is definitely out or only doubtful. */

export type Availability = "out" | "doubtful";

/** The reason a player is unavailable. */

export type MissingReason = "injury" | "illness" | "suspension" | "absent" | "yellowCardSuspension" | "yellowRedCardSuspension" | "redCardSuspension" | "onLoan" | "other";

/** What a support-staff member does. */

export type SupportStaffRole = "headCoach" | "coach" | "assistantCoach" | "battingCoach" | "bowlingCoach" | "fieldingCoach" | "other";

/** Explains how a statistic’s value and total should be interpreted. */

export type StatKind = "value" | "ratio" | "time";

/** Tells whether a larger figure is an advantage. */

export type HigherIs = "better" | "worse";

/** The kind of match event. */

export type IncidentType = "goal" | "card" | "substitution" | "period" | "injuryTime" | "varDecision" | "inGamePenalty" | "shootoutPenalty" | "suspension";

/** Refines an incident’s type into a more specific kind. */

export type IncidentDetail = "regular" | "ownGoal" | "penalty" | "powerPlay" | "shortHanded" | "emptyNet" | "onePoint" | "twoPoints" | "threePoints" | "try" | "touchdown" | "extraPoint" | "fieldGoal" | "twoPointConversion" | "safety" | "yellow" | "secondYellow" | "red" | "injury" | "goalAwarded" | "goalNotAwarded" | "penaltyAwarded" | "penaltyNotAwarded" | "cardUpgrade" | "cardDowngrade" | "scored" | "missed" | "twoMinutes" | "fiveMinutes" | "tenMinutes" | "fourMinutes" | "awarded" | "redCardGiven" | "review" | "temporary" | "sixPoints" | "behind" | "other";

/** Class of an ice hockey penalty. */

export type PenaltySeverity = "minor" | "doubleMinor" | "major" | "misconduct" | "gameMisconduct" | "match" | "penaltyShot" | "other";

/** Football: the part of the body used for a shot. */

export type BodyPart = "rightFoot" | "leftFoot" | "head" | "other";

/** Football: where a shot finished in relation to the goal. */

