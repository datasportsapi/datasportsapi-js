  name: string;
  /** Slug for use in URLs. */
  slug: string | null;
  /** Country of the referee, if the source supplies it. */
  country: Country | null;
  /** Number of matches the source has logged with this referee in charge, across the whole career and all competitions. */
  games: number | null;
  /** Yellow cards issued across those matches. Null in sports that have no cards (cricket). */
  yellowCards: number | null;
  /** Direct red cards issued across those matches. Null in sports that have no cards. */
  redCards: number | null;
  /** Dismissals for a second yellow across those matches. Null in sports that have no cards. */
  yellowRedCards: number | null;
  /** Referee photo hosted on our CDN. Null if no image exists or it has not been uploaded yet. Available since 2026-11-04. */
  image: string | null;
}

/** Tennis: the type of court used for the match. */

export interface Surface {
  /** Surface category of the court. */
  type: SurfaceType;
  /** True for an indoor court and false for an outdoor one; null if the source does not specify. */
  indoor: boolean | null;
  /** Surface label as worded by the source, such as "Hardcourt outdoor". For display only. */
  name: string;
}

/** Cricket: outcome of the coin toss. */

export interface CricketToss {
  /** Toss winner; null if the team the source names matches neither participant. */
  winner: Side | null;
  /** The choice the toss winner made. */
  decision: TossDecision | null;
}

/** MMA / boxing: a bout’s placement on the event card. */

export interface FightCard {
  /** The part of the card (main card, prelims, …), if the source specifies it. */
  section: FightCardSection | null;
  /** Position of the bout in the source’s numbering of the card; larger numbers come later, and the main event carries the largest. */
  order: number | null;
  /** Weight class of the bout, using the source’s naming ("light", "bantam", "feather", …). */
  weightClass: string | null;
}

/** Contents of `changes` in a WebSocket delta: a partial Fixture that keeps the same field names and nesting. Deep-merge it into your local Fixture — nested objects merge key by key, while any other value (null included) overwrites. No fields beyond those listed here are ever sent. */

export interface FixturePatch {
  /** Status fields that were modified. A status change always repeats type, phase and finish, plus period when it is known. */
  status?: {
    type?: StatusType;
    phase?: StatusPhase;
    code?: number | null;
    description?: string | null;
    period?: PeriodKey | null;
    finish?: FinishType | null;
  };
  /** Updated start time, either because the fixture was rescheduled or because the source has logged the actual kick-off (see Fixture.startTime). */
  startTime?: string | null;
  /** Sent once the match is over. */
  winner?: Winner | null;
  /** Modified fields of the home ScoreSide. */
  homeScore?: ScoreSidePatch;
  /** Modified fields of the away ScoreSide. */
  awayScore?: ScoreSidePatch;
  /** Since 2026-11-14 the whole Clock (every field, null where there is no value) is sent whenever any part of it changes. Since 2026-11-26 periodCount, periodLengthSeconds and overtimeLengthSeconds are filled in from the fixture's REST data when the live row lacks them, instead of arriving as null; when that data is at the same status, the period offset, end and added-time fields are filled the same way. Deep-merging it gives the same result as before, and a client that held no clock now receives a complete one. Since 2026-11-26 a delta sent during a break (half-time, an intermission) has periodOffsetSeconds, periodEndSeconds, maxExtraSeconds and injuryTimeMinutes set to null, as REST always had them; until then the WebSocket copy could hold on to the finished period's values. A null value signals the match has ended; discard the clock. */
  clock?: {
    periodStartedAt?: string | null;
    periodOffsetSeconds?: number | null;
    periodEndSeconds?: number | null;
    maxExtraSeconds?: number | null;
    injuryTimeMinutes?: number | null;
    playedSeconds?: number | null;
    playedAt?: string | null;
    running?: boolean | null;
    runningUpdatedAt?: string | null;
    periodLengthSeconds?: number | null;
    overtimeLengthSeconds?: number | null;
    periodCount?: number | null;
    lastPeriodEndedAt?: string | null;
  } | null;
  /** Deprecated; carries the same value as `serving`. */
  firstToServe?: Side | null;
  /** Side currently serving (throwing). */
  serving?: Side | null;
  /** Darts: which side opened the match, sent as soon as the source provides it. Since 2026-11-11. */
  servedFirst?: Side | null;
  /** Cricket: updated match note. */
  note?: string | null;
  /** Cricket: side currently batting; null when nobody is. */
  battingSide?: Side | null;
  /** Baseball: updated game state, always delivered as a complete object; null once play has stopped. */
  inningState?: InningState | null;
  /** Basketball and American football: whichever timeout fields changed. `active` comes whole when a timeout starts and as null when play restarts (since 2026-11-21). Null once play has stopped. */
  timeouts?: {
    homeRemaining?: number | null;
    awayRemaining?: number | null;
    perTeam?: number | null;
    active?: ActiveTimeout | null;
  } | null;
  /** American football: fields that were modified (the full object when tracking begins); null once play has stopped. Available since 2026-11-09. */
  downAndDistance?: {
    down?: number | null;
    yardsToGo?: number | null;
    possession?: Side | null;
    ballOn?: Side | null;
    yardLine?: number | null;
    goalToGo?: boolean | null;
    playType?: DownPlayType | null;
  } | null;
  /** Football: a full object when a VAR review begins, null when it finishes. Available since 2026-11-09. */
  varCheck?: VarCheck | null;
  /** A newly finished period with its length in seconds (keyed as in ScoreSide.periods; null means the source removed it, so delete it), together with the updated total. Merge it the same way as a score map. */
  durations?: {
    periods?: Record<string, number | null>;
    totalSeconds?: number | null;
  };
  /** Only the periods whose announced added time changed, in minutes; a null value means the source took that figure back, so remove the period. Merge it as you would a score map. Since 2026-11-26. */
  addedTime?: Record<string, number | null>;
  /** MMA / boxing: how, in which round and when the fight finished, sent as a whole object once the source has it. Expect it in a delta after the one that ends the fight, since the source releases it ~20–60 s after the winner is known. */
  fightResult?: FightResult | null;
  /** Tennis doubles and padel: the players of the home pair, always sent as the complete list once anything in it changes. The final result can complete a pair or swap its order, and the delta carrying that result includes them, so merged deltas match a fresh REST read. Available since 2026-11-25. */
  homeMembers?: TeamRef[] | null;
  /** The players of the away pair; see homeMembers. Available since 2026-11-25. */
  awayMembers?: TeamRef[] | null;
  /** True when lineups are published and false when they are pulled, sent as soon as the source announces it, including before kick-off (fixture:{id}). Available since 2026-11-04. */
  lineupsAvailable?: boolean | null;
  /** Signals that the official lineups have been released. Available since 2026-11-04. */
  lineupsConfirmed?: boolean | null;
}

/** Only the ScoreSide fields that changed. */

export interface ScoreSidePatch {
  /** The headline score you would see on a scoreboard: goals, points, sets won (tennis / volleyball) or runs (cricket, baseball), counting extra time / overtime. Shoot-out goals are excluded and reported in `penalties` instead — except in ice hockey and, since 2026-11-23, floorball, where the shoot-out winner is given one extra goal (3-3 after overtime becomes 3-4). Before the start, and for fixtures whose coverage was canceled, it is null. */
  current?: number | null;
  /** Score when regulation time ended, if the source provides it. */
  normalTime?: number | null;
  /** Goals converted in a penalty shoot-out. In ice hockey and floorball the shoot-out winner gets 1 here and the loser 0, in line with the single goal added to `current`. */
  penalties?: number | null;
  /** Combined score across both legs of a two-legged tie. */
  aggregated?: number | null;
  /** Playoff series: number of games this side has won in the series to date (basketball, baseball, ice hockey, water polo). */
  series?: number | null;
  /** Tennis: score within the current game — "0" | "15" | "30" | "40" | "A", or a plain number ("0"–"N") during a tie-break. Darts: the points the side still has to score in the current leg ("501" when a leg starts). Null when play is neither in progress nor interrupted. */
  point?: string | null;
  /** Football: number of red cards this side has received, counting second yellows. Once the match is under way it starts at 0 rather than null, on REST and, since 2026-11-26, in WebSocket deltas as well. */
  redCards?: number | null;
  /** Baseball: hit total, i.e. the H in the R/H/E line. */
  hits?: number | null;
  /** Baseball: error total, i.e. the E in the R/H/E line. */
  errors?: number | null;
  /** Just the periods whose value changed. A null value means the source removed that period, so delete it. */
  periods?: Record<string, number | null>;
  /** Just the tie-breaks whose value changed; null means one was removed. */
  tieBreaks?: Record<string, number | null>;
  /** Just the innings that changed. Merge them key by key, as with periods; any innings left out keeps its previous value. */
  innings?: Record<string, CricketInnings>;
}

