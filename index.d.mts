  data: TrackingSummary;
}

/** Query of GET /v2/fixtures/{id}/tracking/ball. */
export interface TrackingBallParams {
  /** return only frames recorded after this instant (ISO-8601 with any offset; the instant itself is excluded) — meta.next from the previous page, or the at of your newest frame */
  since?: string;
  /** frames per page, 1–5000 (5000 if omitted, enough for a whole football match) */
  limit?: number;
}

/** count, hasNextPage, next (the since value for the following page, or null) */
export type TrackingBallMeta = {
  count?: number;
  hasNextPage?: boolean;
  next?: string | null;
};

/** Answer of GET /v2/fixtures/{id}/tracking/ball. */
export interface TrackingBallResponse {
  data: BallFrame[];
  meta?: TrackingBallMeta;
}

/** Query of GET /v2/fixtures/{id}/tracking/events. */
export interface TrackingEventsParams {
  /** return only this event type, written in camelCase (pass, attemptAtGoal, goal, serve, point, ballSituation, threePointer, …) */
  type?: string;
  /** return only events after this instant (ISO-8601 with any offset; the instant itself is excluded) */
  since?: string;
  /** zero-based page of the filtered list, 0–999 (defaults to 0) */
  page?: number;
}

/** page, count, total (after filtering), hasNextPage */
export type TrackingEventsMeta = {
  page?: number;
  count?: number;
  total?: number;
  hasNextPage?: boolean;
};

/** Answer of GET /v2/fixtures/{id}/tracking/events. */
export interface TrackingEventsResponse {
  data: TrackedEvent[];
  meta?: TrackingEventsMeta;
}

/** count */
export type TrackingTimelineMeta = {
  count?: number;
};

/** Answer of GET /v2/fixtures/{id}/tracking/timeline. */
export interface TrackingTimelineResponse {
  data: TimelineEvent[];
  meta?: TrackingTimelineMeta;
}

/** Body of POST /v2/exports. */
export interface ExportsCreateParams {
  /** Our league id. */
  league: number;
  /** A season id of that league, from /v2/leagues/{id}/seasons. */
  season: number;
  /** json writes a single season.json; csv and parquet each write a fixtures table and a standings table. */
  format?: "json" | "csv" | "parquet";
}

/** Answer of POST /v2/exports. */
export interface ExportsCreateResponse {
  data: Export;
}

/** count */
export type ExportsListMeta = {
  count?: number;
};

/** Answer of GET /v2/exports. */
export interface ExportsListResponse {
  data: Export[];
  meta?: ExportsListMeta;
}

/** Answer of GET /v2/exports/{id}. */
export interface ExportsGetResponse {
  data: Export;
}

